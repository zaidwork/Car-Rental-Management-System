@code {
    [Parameter]
    public List<Contract>? Contracts { get; set; }

    [Parameter]
    public EventCallback OnContractUpdated { get; set; }

    private List<Contract>? _loadedContracts;
    private List<Contract> EffectiveContracts => Contracts ?? _loadedContracts ?? new();

    private string _viewMode = "cards";
    private int OverdueCount => EffectiveContracts.Count(c => c.ExpectedReturnDateTime < _currentTime && !c.IsOpenEnded);
    private int DueTodayCount => EffectiveContracts.Count(c => c.ExpectedReturnDateTime.Date == DateTime.Today && c.ExpectedReturnDateTime >= _currentTime && !c.IsOpenEnded);
    private int OnTrackCount => EffectiveContracts.Count(c => (c.ExpectedReturnDateTime.Date > DateTime.Today || c.IsOpenEnded) && !(c.ExpectedReturnDateTime < _currentTime && !c.IsOpenEnded));

    private DateTime _currentTime = DateTime.Now;
    private System.Threading.Timer? _countdownTimer;
    private int _timelineDays = 7;
    private Contract? _selectedContractForExtend;

    private List<AxisDayItem> _axisDays = new();
    private DateTime _windowStart;
    private DateTime _windowEnd;
    private double _nowMarkerPercent = 0;

    protected override async Task OnInitializedAsync()
    {
        RentalService.OnContractsDataChanged += HandleContractsDataChanged;
        UpdateAxis();

        if (Contracts == null)
        {
            await LoadContractsInternalAsync();
        }

        // High precision live tick every 1000ms (1 second) so the countdown decrements smoothly
        _countdownTimer = new System.Threading.Timer(async _ =>
        {
            _currentTime = DateTime.Now;
            UpdateNowMarker();
            await InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    private async void HandleContractsDataChanged()
    {
        await InvokeAsync(async () =>
        {
            if (Contracts == null)
            {
                await LoadContractsInternalAsync();
            }
            UpdateAxis();
            StateHasChanged();
        });
    }

    private async Task LoadContractsInternalAsync()
    {
        try
        {
            _loadedContracts = await RentalService.GetContractsAsync(ContractStatus.Active);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading contracts for timeline: {ex.Message}");
            _loadedContracts = new();
        }
    }

    public void Dispose()
    {
        RentalService.OnContractsDataChanged -= HandleContractsDataChanged;
        _countdownTimer?.Dispose();
    }

    private void SetScale(int days)
    {
        _timelineDays = days;
        UpdateAxis();
        StateHasChanged();
    }

    private void UpdateAxis()
    {
        _axisDays.Clear();
        // Window starts yesterday to show immediate past and current continuity
        _windowStart = DateTime.Today.AddDays(-1);
        _windowEnd = _windowStart.AddDays(_timelineDays);

        var today = DateTime.Today;
        for (int i = 0; i < _timelineDays; i++)
        {
            var date = _windowStart.AddDays(i);
            string dayName = date switch
            {
                var d when d == today.AddDays(-1) => "أمس",
                var d when d == today => "اليوم",
                var d when d == today.AddDays(1) => "غداً",
                _ => GetArabicDayName(date.DayOfWeek)
            };

            _axisDays.Add(new AxisDayItem
            {
                Date = date,
                DayName = dayName,
                DateText = date.ToString("MM/dd"),
                IsToday = date == today
            });
        }

        UpdateNowMarker();
    }

    private void UpdateNowMarker()
    {
        var totalHours = (_windowEnd - _windowStart).TotalHours;
        if (totalHours <= 0) return;

        var elapsedHours = (_currentTime - _windowStart).TotalHours;
        _nowMarkerPercent = Math.Clamp((elapsedHours / totalHours) * 100.0, 0, 100);
    }

    private TrackMetrics CalculateTrackMetrics(Contract c)
    {
        var totalHours = (_windowEnd - _windowStart).TotalHours;
        if (totalHours <= 0) return new TrackMetrics { RightPercent = 0, WidthPercent = 10 };

        var startOffsetHours = (c.StartDateTime - _windowStart).TotalHours;
        var endOffsetHours = (c.ExpectedReturnDateTime - _windowStart).TotalHours;

        // In RTL: Right = start offset percentage, Width = duration percentage
        var clampedStart = Math.Max(0, startOffsetHours);
        var clampedEnd = Math.Min(totalHours, endOffsetHours);

        if (clampedEnd < clampedStart) clampedEnd = clampedStart + 2;

        var rightPercent = Math.Clamp((clampedStart / totalHours) * 100.0, 0, 95);
        var widthPercent = Math.Clamp(((clampedEnd - clampedStart) / totalHours) * 100.0, 4, 100 - rightPercent);

        return new TrackMetrics
        {
            RightPercent = rightPercent,
            WidthPercent = widthPercent
        };
    }

    private string GetArabicDayName(DayOfWeek dow) => dow switch
    {
        DayOfWeek.Saturday => "السبت",
        DayOfWeek.Sunday => "الأحد",
        DayOfWeek.Monday => "الاثنين",
        DayOfWeek.Tuesday => "الثلاثاء",
        DayOfWeek.Wednesday => "الأربعاء",
        DayOfWeek.Thursday => "الخميس",
        DayOfWeek.Friday => "الجمعة",
        _ => ""
    };

    private void OpenExtendModal(Contract c)
    {
        _selectedContractForExtend = c;
    }

    private async Task HandleContractExtended()
    {
        _selectedContractForExtend = null;
        if (Contracts == null)
        {
            await LoadContractsInternalAsync();
        }
        if (OnContractUpdated.HasDelegate)
        {
            await OnContractUpdated.InvokeAsync();
        }
        StateHasChanged();
    }

    private void SendWhatsApp(Contract c)
    {
        try
        {
            var phone = c.Customer?.PrimaryPhone;
            if (string.IsNullOrEmpty(phone)) return;

            var diff = c.ExpectedReturnDateTime - DateTime.Now;
            string timeStatus = diff.TotalSeconds > 0
                ? $"متبقي على موعد التسليم {((int)diff.TotalHours)} ساعة و {diff.Minutes} دقيقة (بتاريخ {c.ExpectedReturnDateTime:yyyy/MM/dd hh:mm tt})."
                : $"نود إعلامكم بأن موعد التسليم الرسمي قد انقضى منذ {Math.Abs((int)diff.TotalHours)} ساعة. يرجى مراجعة المكتب فوراً.";

            var msg = $"✦ *شركة التـاج لتأجيـر السيـارات* (TAJ SYSTEM) ✦\n" +
                      $"━━━━━━━━━━━━━━━━━━━━━\n" +
                      $"مرحباً بك أخي الكريم: *{c.Customer?.FullName}*\n" +
                      $"نود تذكيركم بموعد عقد تأجير المركبة: *{c.Vehicle?.Brand} {c.Vehicle?.Model}* (لوحة: *{c.Vehicle?.PlateNumber}*)\n" +
                      $"رقم العقد: *{c.ContractNumber}*\n\n" +
                      $"▪ {timeStatus}\n" +
                      $"━━━━━━━━━━━━━━━━━━━━━\n" +
                      $"☎ *خدمة العملاء:* 0566655550 | 0566009003";

            WhatsAppHelper.OpenWhatsApp(phone, "970", msg);
        }
        catch { }
    }

    private class AxisDayItem
    {
        public DateTime Date { get; set; }
        public string DayName { get; set; } = "";
        public string DateText { get; set; } = "";
        public bool IsToday { get; set; }
    }

    private class TrackMetrics
