@inject NavigationManager Navigation
@inject IAuthStateService AuthState
@implements IDisposable

<aside class="sidebar">
    <div class="sidebar-nav">
        <NavLink class="sidebar-link" href="" Match="NavLinkMatch.All">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
            <span>الرئيسية</span>
        </NavLink>

        <NavLink class="sidebar-link" href="customers">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            <span>ملفات العملاء</span>
        </NavLink>

        <NavLink class="sidebar-link" href="blacklist">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
            </svg>
            <span>القائمة السوداء</span>
        </NavLink>

        <NavLink class="sidebar-link" href="fleet">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C1.4 11.2 1 12 1 13v3c0 .6.4 1 1 1h2"/>
                <circle cx="7" cy="17" r="2"/>
                <path d="M9 17h6"/>
                <circle cx="17" cy="17" r="2"/>
            </svg>
            <span>السيارات والأسطول</span>
        </NavLink>

        <NavLink class="sidebar-link" href="timeline">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
            </svg>
            <span>مخطط الحجوزات</span>
        </NavLink>

        <NavLink class="sidebar-link" href="contracts">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            <span>الحجوزات والعقود</span>
        </NavLink>


        @if (!AuthState.IsStaff)
        {
            <NavLink class="sidebar-link" href="accounting">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10"/>
                    <line x1="12" y1="20" x2="12" y2="4"/>
                    <line x1="6" y1="20" x2="6" y2="14"/>
                </svg>
                <span>المحاسبة والتقارير</span>
            </NavLink>
        }

        @if (AuthState.IsAdmin)
        {
            <NavLink class="sidebar-link" href="settings">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
                    <circle cx="12" cy="12" r="3"/>
                </svg>
                <span>إدارة النظام والمستخدمين</span>
            </NavLink>
        }
    </div>

    <!-- Luxury Walnut & Gold Royal Plaque (شارة الخشب الملكي الفاخر) -->
    <div class="sidebar-luxury-plaque" title="نظام تأجير وإدارة الأسطول - TAJ SYSTEM">
        <div class="luxury-plaque-inner" style="display: flex; flex-direction: column; align-items: center; gap: 4px;">
            <img src="images/logo.png" alt="TAJ SYSTEM" style="width: 58px; height: 58px; object-fit: contain; border-radius: 50%; filter: drop-shadow(0 4px 10px rgba(0,0,0,0.3));" />
            <span class="plaque-title" style="font-size: 0.95rem; font-weight: 900; letter-spacing: 0.6px; margin-top: 2px;">TAJ SYSTEM</span>
            <span class="plaque-sub" style="font-size: 0.68rem; font-weight: 700;">نظام التاج لإدارة وتأجير السيارات</span>
        </div>
    </div>
</aside>

@code {
    protected override void OnInitialized()
    {
        AuthState.OnUserChanged += StateHasChanged;
    }

    public void Dispose()
    {
        AuthState.OnUserChanged -= StateHasChanged;
    }
}
