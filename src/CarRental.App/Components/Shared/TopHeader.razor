@inject IAuthStateService AuthState
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IDisposable

<header class="top-header">
    <div class="header-left">
        <div class="brand-badge" style="gap: 10px; padding: 4px 14px;">
            <img src="images/logo.png" alt="TAJ SYSTEM" style="width: 32px; height: 32px; object-fit: contain; border-radius: 50%;" />
            <span style="font-family: inherit; font-weight: 900; letter-spacing: 0.8px; font-size: 1.05rem;">TAJ SYSTEM</span>
        </div>
    </div>

    <!-- Center Navigation Tabs (Strictly filtered by role with active tracking) -->
    <div class="header-center-wrapper">
        <button type="button" class="tab-scroll-btn tab-scroll-right" @onclick="ScrollRight" title="تمرير لليمين (السابق)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
        </button>

        <div class="header-center-tabs" id="mainHeaderTabs">
            <!-- 1. Operations Group -->
            <NavLink class="header-tab" href="" Match="NavLinkMatch.All" title="الرئيسية (لوحة التحكم)">
                <span>🏠</span>
                <span class="tab-label-full">الرئيسية</span>
                <span class="tab-label-short">الرئيسية</span>
            </NavLink>
            <NavLink class="header-tab" href="fleet" title="السيارات وحالة الأسطول">
                <span>🚗</span>
                <span class="tab-label-full">السيارات والأسطول</span>
                <span class="tab-label-short">الأسطول</span>
            </NavLink>
            <NavLink class="header-tab" href="timeline" title="مخطط الحجوزات">
                <span>⏱️</span>
                <span class="tab-label-full">مخطط الحجوزات</span>
                <span class="tab-label-short">الحجوزات</span>
            </NavLink>
            <NavLink class="header-tab" href="contracts" title="الحجوزات والعقود">
                <span>📋</span>
                <span class="tab-label-full">الحجوزات والعقود</span>
                <span class="tab-label-short">العقود</span>
            </NavLink>

            <span class="nav-separator"></span>

            <!-- 2. Finance & Customers Group -->
            @if (!AuthState.IsStaff)
            {
                <NavLink class="header-tab" href="accounting" title="المحاسبة والتقارير المالية">
                    <span>💰</span>
                    <span class="tab-label-full">المحاسبة والتقارير</span>
                    <span class="tab-label-short">المحاسبة</span>
                </NavLink>
            }
            <NavLink class="header-tab" href="customers" title="ملفات وسجل العملاء">
                <span>👥</span>
                <span class="tab-label-full">ملفات العملاء</span>
                <span class="tab-label-short">العملاء</span>
            </NavLink>
            <NavLink class="header-tab" href="blacklist" title="القائمة السوداء والمحظورين">
                <span>🚫</span>
                <span class="tab-label-full">القائمة السوداء</span>
                <span class="tab-label-short">المحظورين</span>
            </NavLink>

            <!-- 3. System Admin Group -->
            @if (AuthState.IsAdmin)
            {
                <span class="nav-separator"></span>
                <NavLink class="header-tab" href="settings" title="إدارة النظام والمستخدمين">
                    <span>⚙️</span>
                    <span class="tab-label-full">إدارة النظام</span>
                    <span class="tab-label-short">النظام</span>
                </NavLink>
            }
        </div>

        <button type="button" class="tab-scroll-btn tab-scroll-left" @onclick="ScrollLeft" title="تمرير لليسار (المزيد)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
        </button>
    </div>

    <!-- Right User Profile & Notification Center -->
    <div class="header-right">
        <!-- Notification Center -->
        <NotificationCenter />

        <button class="btn-lock-session" @onclick="Logout" title="تسجيل الخروج والعودة لشاشة الـ PIN">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span class="lock-label-full">تسجيل الخروج / قفل</span>
            <span class="lock-label-short">قفل</span>
        </button>

        <div class="user-profile-badge">
            <div class="user-avatar">
                @if (AuthState.IsAdmin)
                {
                    <span>👑</span>
                }
                else if (AuthState.IsStaff)
                {
                    <span>🧑‍💼</span>
                }
                else
                {
                    <span>📊</span>
                }
            </div>
            <div class="user-profile-text" style="display: flex; flex-direction: column; align-items: flex-start;">
                <span class="user-name">@AuthState.CurrentUser.FullName</span>
                <span class="user-role-tag">
                    @(AuthState.CurrentUser.Role switch {
                        UserRole.Admin => "المدير العام",
                        UserRole.Staff => "موظف استقبال",
                        UserRole.Accountant => "المحاسب المالي",
                        _ => "مستخدم"
                    })
                </span>
            </div>
        </div>
    </div>
</header>

<style>
    .btn-lock-session {
        display: flex;
        align-items: center;
        gap: 6px;
        background: #ffffff;
        border: 1.5px solid #ded5c4;
        border-radius: 10px;
        padding: 8px 14px;
        font-size: 0.88rem;
        font-weight: 800;
        color: #475569;
        cursor: pointer;
        box-shadow: 0 2px 6px rgba(45, 24, 12, 0.04);
        transition: all 0.2s ease;
    }
    .btn-lock-session:hover {
        background: #fee2e2;
        border-color: #fca5a5;
        color: #dc2626;
        box-shadow: 0 4px 12px rgba(220, 38, 38, 0.15);
        transform: translateY(-1px);
    }
</style>

@code {
    protected override void OnInitialized()
    {
        AuthState.OnUserChanged += StateHasChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("initHeaderTabs");
            }
            catch { }
        }
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await Task.Delay(60);
        try
        {
            await JSRuntime.InvokeVoidAsync("scrollActiveTabIntoView");
        }
        catch { }
        StateHasChanged();
    }

    public void Dispose()
    {
        AuthState.OnUserChanged -= StateHasChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private async Task ScrollRight()
    {
        try { await JSRuntime.InvokeVoidAsync("scrollTabs", 180); } catch { }
    }

    private async Task ScrollLeft()
    {
        try { await JSRuntime.InvokeVoidAsync("scrollTabs", -180); } catch { }
    }

    private async Task Logout()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("carAudio.playEngineStop");
            await Task.Delay(450);
        }
        catch { }

        AuthState.Logout();
    }
}
