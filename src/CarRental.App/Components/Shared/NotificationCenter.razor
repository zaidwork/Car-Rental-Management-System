@code {
    private bool _isOpen = false;
    private string _activeTab = "all";
    private bool _isMuted = false;

    protected override async Task OnInitializedAsync()
    {
        NotificationService.OnChanged += HandleNotificationsChanged;
        await NotificationService.RefreshNotificationsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _isMuted = await JSRuntime.InvokeAsync<bool>("carAudio.isMuted");
                StateHasChanged();
            }
            catch { }
        }
    }

    public void Dispose()
    {
        NotificationService.OnChanged -= HandleNotificationsChanged;
    }

    private void HandleNotificationsChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleDropdown()
    {
        _isOpen = !_isOpen;
        if (_isOpen)
        {
            // When opening, refresh notifications
            _ = NotificationService.RefreshNotificationsAsync();
        }
    }

    private void CloseDropdown()
    {
        _isOpen = false;
    }

    private async Task ToggleSoundMute()
    {
        try
        {
            _isMuted = await JSRuntime.InvokeAsync<bool>("carAudio.toggleMute");
        }
        catch { }
    }

    private async Task PlaySound(string soundType)
    {
        try
        {
            if (soundType == "engine_start")
            {
                await JSRuntime.InvokeVoidAsync("carAudio.playEngineStart");
            }
            else if (soundType == "engine_stop")
            {
                await JSRuntime.InvokeVoidAsync("carAudio.playEngineStop");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("carAudio.playNotification", soundType);
            }
        }
        catch { }
    }

    private void MarkAllRead()
    {
        NotificationService.MarkAllAsRead();
    }

    private async Task RefreshData()
    {
        await NotificationService.RefreshNotificationsAsync();
        await PlaySound("info");
    }

    private void HandleNotificationClick(SystemNotification item)
    {
        NotificationService.MarkAsRead(item.Id);
        _isOpen = false;

        if (!string.IsNullOrEmpty(item.TargetUrl))
        {
            Navigation.NavigateTo(item.TargetUrl);
        }
    }

    private IEnumerable<SystemNotification> FilteredNotifications
    {
        get
        {
            var list = NotificationService.Notifications;
            return _activeTab switch
            {
                "danger" => list.Where(n => n.Severity == NotificationSeverity.Danger),
                "maintenance" => list.Where(n => n.Category == NotificationCategory.VehicleMaintenance 
                                             || n.Category == NotificationCategory.VehicleLicense 
                                             || n.Category == NotificationCategory.OilChange),
                "contracts" => list.Where(n => n.Category == NotificationCategory.OverdueContract 
                                            || n.Category == NotificationCategory.CustomerLicense),
                _ => list
            };
        }
    }

    private int FilteredCount(string tab)
    {
        var list = NotificationService.Notifications;
        return tab switch
        {
            "danger" => list.Count(n => n.Severity == NotificationSeverity.Danger),
            "maintenance" => list.Count(n => n.Category == NotificationCategory.VehicleMaintenance 
                                         || n.Category == NotificationCategory.VehicleLicense 
                                         || n.Category == NotificationCategory.OilChange),
            "contracts" => list.Count(n => n.Category == NotificationCategory.OverdueContract 
                                        || n.Category == NotificationCategory.CustomerLicense),
            _ => list.Count
        };
    }

    private string GetCategoryIcon(NotificationCategory cat) => cat switch
    {
        NotificationCategory.OverdueContract => "🚨",
        NotificationCategory.VehicleMaintenance => "⛔",
        NotificationCategory.VehicleLicense => "⚠️",
        NotificationCategory.OilChange => "🔧",
        NotificationCategory.TrafficViolation => "💸",
        NotificationCategory.CustomerLicense => "🪪",
        _ => "🔔"
    };

    private string FormatTimeAgo(DateTime dt)
    {
        var span = DateTime.Now - dt;
        if (span.TotalMinutes < 60) return $"منذ {(int)Math.Max(1, span.TotalMinutes)} دقيقة";
        if (span.TotalHours < 24) return $"منذ {(int)span.TotalHours} ساعة";
        if (span.TotalDays < 30) return $"منذ {(int)span.TotalDays} يوم";
        return dt.ToString("yyyy/MM/dd");
    }
}
