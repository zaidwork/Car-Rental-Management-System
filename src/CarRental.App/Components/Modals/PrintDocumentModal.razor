                            <span>مخطط هيكل السيارة لتحديد الخدوش والصدمات (شامل كافة الزوايا):</span>
                            <span>Vehicle Damage Blueprint (All 5 Angles)</span>
                        </div>
                        
                        <div style="text-align: center; width: 100%; line-height: 0; background: #ffffff; padding: 2px 0;">
                            <div style="position: relative; display: inline-block; height: 68mm; width: calc(68mm * 1590 / 696); max-width: 100%; line-height: 0; margin: 0 auto;">
                                <img src="images/inspection/car_all_clean.png" 
                                     alt="Vehicle Blueprint" 
                                     style="display: block; width: 100%; height: 100%; margin: 0; padding: 0;" />

                                <!-- Angle Indicator Labels on Blueprint -->
                                <div style="position: absolute; top: 2%; left: 1%; background: rgba(0,0,0,0.72); color: #fff; font-size: 9px; font-weight: 800; padding: 1px 5px; border-radius: 3px; line-height: 1.1; pointer-events: none;">🚘 أمامي</div>
                                <div style="position: absolute; top: 2%; left: 45%; transform: translateX(-50%); background: rgba(0,0,0,0.72); color: #fff; font-size: 9px; font-weight: 800; padding: 1px 5px; border-radius: 3px; line-height: 1.1; pointer-events: none;">🚙 جانبي</div>
                                <div style="position: absolute; top: 2%; right: 1%; background: rgba(0,0,0,0.72); color: #fff; font-size: 9px; font-weight: 800; padding: 1px 5px; border-radius: 3px; line-height: 1.1; pointer-events: none;">🚗 خلفي</div>
                                <div style="position: absolute; bottom: 2%; left: 1%; background: rgba(0,0,0,0.72); color: #fff; font-size: 9px; font-weight: 800; padding: 1px 5px; border-radius: 3px; line-height: 1.1; pointer-events: none;">🏎️ أمامي مجسم</div>
                                <div style="position: absolute; bottom: 2%; right: 1%; background: rgba(0,0,0,0.72); color: #fff; font-size: 9px; font-weight: 800; padding: 1px 5px; border-radius: 3px; line-height: 1.1; pointer-events: none;">🏎️ خلفي مجسم</div>

                                @for (int i = 0; i < _vehicleDamageMarks.Count; i++)
                                {
                                    var mark = _vehicleDamageMarks[i];
                                    var coords = GetUniversalMarkCoordinates(mark);
                                    var idx = i + 1;
                                    <div style="position: absolute; left: @(coords.X.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))%; top: @(coords.Y.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))%; transform: translate(-50%, -50%); z-index: 10; pointer-events: none;">
                                        <div style="width: 22px; height: 22px; border-radius: 50%; background: #dc2626; color: #ffffff; border: 2px solid #ffffff; box-shadow: 0 0 3px #000; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 900; font-family: monospace;">
                                            @idx
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        @if (_vehicleDamageMarks.Count > 0)
                        {
                            <div style="border-top: 1.5px solid #000000; margin-top: 4px; padding: 4px 8px; text-align: right; background: #fff5f5; font-size: 0.72rem;">
