                        <div style="text-align: left; font-size: 0.8rem; line-height: 1.45;">
                            <div><strong>رقم السند:</strong> <span style="font-family: monospace; font-weight: 900; font-size: 1.05rem;">PAY-@Contract.ContractNumber</span></div>
                            <div><strong>رقم العقد:</strong> <span style="font-family: monospace; font-weight: bold;">@Contract.ContractNumber</span></div>
                            <div><strong>التاريخ:</strong> <span style="font-family: monospace; font-weight: bold;">@DateTime.Now.ToString("yyyy/MM/dd")</span></div>
