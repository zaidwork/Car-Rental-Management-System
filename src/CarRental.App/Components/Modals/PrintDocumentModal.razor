@using CarRental.Core.Entities
@using CarRental.Core.Enums
@using CarRental.Core.Helpers
@using CarRental.Core.Interfaces
@using CarRental.Infrastructure.Helpers
@inject IRentalSystemService RentalService
@inject IJSRuntime JSRuntime

@if (Contract != null)
{
<div class="modal-overlay">
    <div class="modal-card" style="max-width: 980px; width: 95%;">
        <!-- Modal Top Chrome (Non-Printable) -->
        <div class="modal-header no-print">
            <div class="modal-title">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--primary-blue)" stroke-width="2">
                    <polyline points="6 9 6 2 18 2 18 9"></polyline>
                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                    <rect x="6" y="14" width="12" height="8"></rect>
                </svg>
                <span>طباعة الوثائق الرسمية المعتمدة للعقد (@Contract.ContractNumber)</span>
            </div>
            <button class="btn-close-modal" @onclick="HandleCloseOrBack">×</button>
        </div>

        @if (IsPendingConfirmation)
        {
            <div class="pending-review-banner no-print" style="margin: 10px 20px 0; background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%); border: 2px solid #f59e0b; border-radius: 10px; padding: 10px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; box-shadow: 0 4px 12px rgba(245, 158, 11, 0.15);">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <span style="font-size: 1.5rem;">📋</span>
                    <div>
                        <div style="font-weight: 900; color: #92400e; font-size: 0.96rem;">
                            مرحلة مراجعة وتدقيق العقد (قبل التأكيد والاعتماد النهائي)
                        </div>
                        <div style="font-size: 0.82rem; color: #b45309; font-weight: 600;">
                            راجع بيانات العقد، الأسعار، والمواعيد بدقة. يمكنك النقر على "الرجوع لتعديل البيانات" لتعديل أي حقل فوراً، أو النقر على "تأكيد العقد والطباعة".
                        </div>
                    </div>
                </div>
                <button type="button" class="btn-back-to-edit" style="background: linear-gradient(135deg, #d97706 0%, #b45309 100%) !important; border: 2px solid #f59e0b !important; color: #ffffff !important; font-weight: 900; padding: 7px 16px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; gap: 6px; box-shadow: 0 4px 12px rgba(180, 83, 9, 0.35); text-decoration: none;" @onclick="HandleBackToEdit">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    <span style="color: #ffffff !important; font-weight: 900;">↩ الرجوع لتعديل البيانات</span>
                </button>
            </div>
        }
        else if (CanRollbackNewContract)
        {
            <div class="pending-review-banner no-print" style="margin: 10px 20px 0; background: #fdf2f2; border: 2px solid #f87171; border-radius: 10px; padding: 8px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 1.3rem;">ℹ️</span>
                    <span style="font-size: 0.84rem; color: #991b1b; font-weight: 700;">
                        العقد مسجل حديثاً؛ إذا كان هناك خطأ في البيانات وترغب بتصحيحها، يمكنك التراجع عنه فوراً دون أي قيود.
                    </span>
                </div>
                <button type="button" class="filter-pill" style="background: #ffffff; border: 1.5px solid #dc2626; color: #dc2626; font-weight: 800; cursor: pointer;" @onclick="HandleBackToEdit">
                    <span>↩ تراجع والعودة لتعديل البيانات</span>
                </button>
            </div>
        }

        <!-- Company Switcher Bar (Non-Printable) -->
        <div class="company-switcher-bar no-print" style="display: flex; gap: 12px; align-items: center; padding: 10px 20px; background: #e8e1d2; border-bottom: 1.5px solid var(--border-color); flex-wrap: wrap; flex-shrink: 0;">
            <div style="display: flex; align-items: center; gap: 6px; font-weight: 800; font-size: 0.88rem; color: #451a03;">
                <span>👑 جهة إصدار وترخيص العقد:</span>
            </div>
            <div style="display: flex; gap: 8px;">
                <button type="button" 
                        class="filter-pill @(_selectedCompany == "samara" ? "active" : "")" 
                        style="cursor: pointer; font-weight: bold; border: 1.5px solid @(_selectedCompany == "samara" ? "#b45309" : "#cbd5e1");"
                        @onclick='() => _selectedCompany = "samara"'>
                    🏢 شركة سمارة (مشتغل: 562171389)
                </button>
                <button type="button" 
                        class="filter-pill @(_selectedCompany == "altaj" ? "active" : "")" 
                        style="cursor: pointer; font-weight: bold; border: 1.5px solid @(_selectedCompany == "altaj" ? "#b45309" : "#cbd5e1");"
                        @onclick='() => _selectedCompany = "altaj"'>
                    👑 شركة التاج (مشتغل: 562514273)
                </button>
            </div>
            <span style="font-size: 0.78rem; color: #78350f; margin-right: auto;">
                (اختر الشركة لطباعة الترويسة وأرقام التراخيص والشروط باسمها)
            </span>
        </div>

        <!-- Document Selector Tabs (Non-Printable) -->
        <div class="doc-selector-tabs no-print" style="display: flex; gap: 8px; padding: 10px 20px; background: #f2ede4; border-bottom: 1.5px solid var(--border-color); overflow-x: auto; flex-shrink: 0;">
            <button class="filter-pill @(_currentDoc == "contract_both" ? "active" : "")" @onclick='() => SelectDocument("contract_both")'>
                📑 1. طباعة العقد وجه وقفا (صفحة A4 كاملة - معتمد)
            </button>
            <button class="filter-pill @(_currentDoc == "contract_front" ? "active" : "")" @onclick='() => SelectDocument("contract_front")'>
                📄 2. وجه العقد فقط (صفحة 1)
            </button>
            <button class="filter-pill @(_currentDoc == "contract_back" ? "active" : "")" @onclick='() => SelectDocument("contract_back")'>
                📜 3. قفا العقد فقط (شروط التأجير)
            </button>
            <button class="filter-pill @(_currentDoc == "note" ? "active" : "")" @onclick='() => SelectDocument("note")'>
                ✍️ 4. كمبيالة الضمان الرسمية
            </button>
            <button class="filter-pill @(_currentDoc == "inspection" ? "active" : "")" @onclick='() => SelectDocument("inspection")'>
                🔍 5. محضر المعاينة والفحص الفني
            </button>
            <button class="filter-pill @(_currentDoc == "receipt" ? "active" : "")" @onclick='() => SelectDocument("receipt")'>
                💵 6. سند قبض مالي رسمي
            </button>
            <button class="filter-pill @(_currentDoc == "payment" ? "active" : "")" @onclick='() => SelectDocument("payment")'>
                💸 7. سند صرف مالي رسمي
            </button>
        </div>

        <!-- Printable Document Area -->
        <div class="modal-body" id="printableContractContainer" style="background: #e5ded0; padding: 20px; flex: 1 1 auto; min-height: 0; overflow-y: auto;">
            
            @if (_currentDoc == "contract_front" || _currentDoc == "contract_both")
            {
                <!-- ==================== PAGE 1: OFFICIAL CONTRACT FRONT (وجه العقد الرسمي المعتمد) ==================== -->
                <div class="printable-document contract-a4-sheet @(_currentDoc == "contract_both" ? "contract-both-front" : "")" id="printableContractFront" dir="rtl" style="direction: rtl; text-align: right; background: #ffffff; color: #000000; border: 2px solid #000000; border-radius: 6px; padding: 4mm 6mm; font-family: 'Cairo', 'Tajawal', sans-serif;">
                    
                    <!-- 1. Master Header Box with Exact Pill Layout and Royal Crown Center -->
                    <div style="border: 2px solid #000000; border-radius: 10px; padding: 4px 10px; margin-bottom: 4px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 8px; direction: rtl; background: #ffffff;">
                        
                        <!-- Right Column (Arabic Header) -->
                        <div style="text-align: right; line-height: 1.25;">
                            <div style="font-weight: 900; font-size: 1.15rem; color: #000000; letter-spacing: 0.5px;">@ActiveCompanyNameAr</div>
                            <div style="font-weight: 700; font-size: 0.82rem; color: #000000; margin-bottom: 2px;">@ActiveCompanySubtitleAr</div>
                            
                            <!-- Pill Box for Location & Phones -->
                            <div style="border: 1.5px solid #000000; border-radius: 16px; padding: 2px 10px; display: inline-block; text-align: center; width: 100%; box-sizing: border-box; background: #ffffff;">
                                <div style="font-size: 0.72rem; font-weight: 800; color: #000000;">@ActiveCompanyAddressAr</div>
                                <div style="font-size: 0.72rem; font-weight: 900; font-family: monospace; color: #000000; letter-spacing: 0.5px;">@ActiveCompanyPhones</div>
                            </div>
                        </div>

                        <!-- Center Column (Crown Logo & Authorized Dealer Number) -->
                        <div style="text-align: center; padding: 0 8px; min-width: 170px;">
                            <svg width="46" height="30" viewBox="0 0 100 64" fill="#000000" style="display: block; margin: 0 auto 1px;">
                                <path d="M12 24 L28 42 L50 12 L72 42 L88 24 L80 48 L20 48 Z" />
                                <circle cx="12" cy="20" r="4.5" />
                                <circle cx="50" cy="8" r="5.5" />
                                <circle cx="88" cy="20" r="4.5" />
                                <circle cx="31" cy="32" r="3" />
                                <circle cx="69" cy="32" r="3" />
                                <path d="M15 52 C35 48, 65 48, 85 52 C82 58, 18 58, 15 52 Z" />
                            </svg>
                            <div style="font-weight: 900; font-size: 0.85rem; letter-spacing: 2px; line-height: 1; text-transform: uppercase;">@ActiveCompanyBrandEn</div>
                            <div style="font-weight: 900; font-size: 1.15rem; letter-spacing: 1px; line-height: 1.1;">@ActiveCompanyBrandAr</div>
                            <div style="font-size: 0.65rem; font-weight: 800; margin-top: 2px; white-space: nowrap;">
                                <span>Authorized Dealer No</span>
                                <span style="font-family: monospace; font-size: 0.72rem; font-weight: 900; padding: 0 3px;">@ActiveCompanyDealerNo</span>
                                <span>مشتغل مرخص رقم</span>
                            </div>
                        </div>

                        <!-- Left Column (English Header) -->
                        <div style="text-align: left; line-height: 1.25; direction: ltr;">
                            <div style="font-weight: 900; font-size: 1.10rem; color: #000000; letter-spacing: 1px; text-transform: uppercase;">@ActiveCompanyNameEn</div>
                            <div style="font-weight: 700; font-size: 0.82rem; color: #000000; margin-bottom: 2px;">@ActiveCompanySubtitleEn</div>
                            
                            <!-- Pill Box for Location & Phones (English) -->
                            <div style="border: 1.5px solid #000000; border-radius: 16px; padding: 2px 10px; display: inline-block; text-align: center; width: 100%; box-sizing: border-box; background: #ffffff;">
                                <div style="font-size: 0.72rem; font-weight: 800; color: #000000;">@ActiveCompanyAddressEn</div>
                                <div style="font-size: 0.72rem; font-weight: 900; font-family: monospace; color: #000000; letter-spacing: 0.5px;">@ActiveCompanyPhones</div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Rental Agreement Number Bar -->
                    <div style="display: flex; justify-content: space-between; align-items: baseline; border-bottom: 2px solid #000000; padding: 2px 8px 4px; margin-bottom: 4px; font-weight: 900; direction: rtl;">
                        <span style="font-size: 1.15rem; font-weight: 900;">إتفاقية تأجير رقم</span>
                        <div style="font-size: 1.15rem; font-family: monospace; display: flex; align-items: baseline; gap: 6px;">
                            <span style="font-family: 'Times New Roman', serif; font-style: italic; font-weight: bold; font-size: 1.25rem;">No. :</span>
                            <span style="border-bottom: 1.5px solid #000; padding: 0 14px; font-weight: 900; font-size: 1.3rem;">@(Contract.ContractNumber)</span>
                        </div>
                        <span style="font-size: 1.05rem; font-weight: 800; letter-spacing: 0.5px; direction: ltr;">Rental Agreement</span>
                    </div>

                    <!-- 3. Form Grid: Two Columns (Right: Renter Details, Left: Vehicle & In/Out Table) -->
                    <div style="display: grid; grid-template-columns: 1.1fr 1fr; gap: 6px; flex: 1 1 auto; margin-bottom: 4px; direction: rtl;">
                        
                        <!-- RIGHT BOX (Column 1 in RTL): Renter Details, Terms & Signatures -->
                        <div style="border: 2px solid #000000; border-radius: 4px; display: flex; flex-direction: column; justify-content: space-between; font-size: 0.74rem; background: #ffffff;">
                            
                            <div style="display: flex; flex-direction: column;">
                                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #000; padding: 3px 6px;">
                                    <span style="font-size: 0.70rem; color: #1e293b; direction: ltr; font-weight: 600; width: 28%; text-align: left;">Renter</span>
                                    <span style="font-weight: 900; font-size: 0.84rem; text-align: center; flex: 1;">@Contract.Customer?.FullName</span>
                                    <span style="font-weight: 800; width: 28%; text-align: right;">المستأجر</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #000; padding: 3px 6px;">
                                    <span style="font-size: 0.70rem; color: #1e293b; direction: ltr; font-weight: 600; width: 28%; text-align: left;">Place Of Residence</span>
                                    <span style="font-weight: 800; text-align: center; flex: 1;">@(string.IsNullOrEmpty(Contract.Customer?.Address) ? "طوباس - فلسطين" : Contract.Customer?.Address)</span>
                                    <span style="font-weight: 800; width: 28%; text-align: right;">بلد المستأجر</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #000; padding: 3px 6px;">
                                    <span style="font-size: 0.70rem; color: #1e293b; direction: ltr; font-weight: 600; width: 28%; text-align: left;">ID.No. & Birth Date</span>
                                    <span style="font-weight: 900; font-family: monospace; text-align: center; flex: 1;">
                                        @Contract.Customer?.NationalIdOrPassport 
                                        @(Contract.Customer != null ? $" | {Contract.Customer.DateOfBirth:yyyy/MM/dd}" : "")
                                    </span>
                                    <span style="font-weight: 800; width: 28%; text-align: right;">رقم الهوية / تاريخ الميلاد</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #000; padding: 3px 6px;">
                                    <span style="font-size: 0.70rem; color: #1e293b; direction: ltr; font-weight: 600; width: 28%; text-align: left;">ID.No. & Exp. Date</span>
                                    <span style="font-weight: 900; font-family: monospace; text-align: center; flex: 1;">
                                        @Contract.Customer?.LicenseNumber (تنتهي: @Contract.Customer?.LicenseExpiryDate.ToString("yyyy/MM/dd"))
                                    </span>
                                    <span style="font-weight: 800; width: 28%; text-align: right;">الرخصة / رقمها / تاريخ انتهائها</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #000; padding: 3px 6px;">
                                    <span style="font-size: 0.70rem; color: #1e293b; direction: ltr; font-weight: 600; width: 28%; text-align: left;">Address</span>
                                    <span style="font-weight: 800; text-align: center; flex: 1;">@Contract.Customer?.Address</span>
                                    <span style="font-weight: 800; width: 28%; text-align: right;">العنوان</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #000; padding: 3px 6px;">
                                    <span style="font-size: 0.70rem; color: #1e293b; direction: ltr; font-weight: 600; width: 28%; text-align: left;">Tel .</span>
                                    <span style="font-weight: 900; font-family: monospace; text-align: center; flex: 1;">
                                        @Contract.Customer?.PrimaryPhone 
                                        @(!string.IsNullOrEmpty(Contract.Customer?.EmergencyPhone) ? $" | {Contract.Customer?.EmergencyPhone}" : "")
                                    </span>
                                    <span style="font-weight: 800; width: 28%; text-align: right;">هاتف</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #000; padding: 3px 6px;">
                                    <span style="font-size: 0.70rem; color: #1e293b; direction: ltr; font-weight: 600; width: 28%; text-align: left;">Addational Drivers</span>
                                    <span style="font-weight: 800; text-align: center; flex: 1;">
                                        @(!string.IsNullOrWhiteSpace(Contract.AdditionalDriverName) ? Contract.AdditionalDriverName : "لا يوجد")
                                    </span>
                                    <span style="font-weight: 800; width: 28%; text-align: right;">سائقين اخرين</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #000; padding: 3px 6px;">
                                    <span style="font-size: 0.70rem; color: #1e293b; direction: ltr; font-weight: 600; width: 28%; text-align: left;">Addational Information</span>
                                    <span style="font-weight: 700; text-align: center; flex: 1; font-size: 0.72rem;">@(string.IsNullOrEmpty(Contract.Notes) ? "تأجير سياحي رسمي معتمد" : Contract.Notes)</span>
                                    <span style="font-weight: 800; width: 28%; text-align: right;">معلومات اخرى</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #000; padding: 3px 6px; background: #fafafa;">
                                    <span style="font-size: 0.70rem; color: #1e293b; direction: ltr; font-weight: 600; width: 28%; text-align: left;">Payments</span>
                                    <span style="font-weight: 900; font-size: 0.74rem; text-align: center; flex: 1;">
                                        @if (Contract.DiscountAmount > 0)
                                        {
                                            <span>الأساسي: @Contract.OriginalAgreedAmount.ToString("N0") ₪ | الخصم: -@Contract.DiscountAmount.ToString("N0") ₪ @(Contract.DiscountType == "Percentage" ? $"({Contract.DiscountValue}%)" : "") | الصافي: @Contract.TotalAgreedAmount.ToString("N0") ₪ | مقبوض: @Contract.PaidAmount.ToString("N0") ₪ | متبقي: @Contract.RemainingAmount.ToString("N0") ₪</span>
                                        }
                                        else if (Contract.IsOpenEnded)
                                        {
                                            <span>حساب يومي مفتوح: @Contract.DailyAgreedRate.ToString("N0") ₪/يوم | مقبوض مقدم: @Contract.PaidAmount.ToString("N0") ₪ | تسوية يومية</span>
                                        }
                                        else if (Contract.PaymentMode == PaymentMode.DeferredOnReturn)
                                        {
                                            <span>دفع آجل (ذمم عند التسليم) | الإجمالي: @Contract.TotalAgreedAmount.ToString("N0") ₪ | مقبوض مقدماً: @Contract.PaidAmount.ToString("N0") ₪ | متبقي دين: @Contract.RemainingAmount.ToString("N0") ₪</span>
                                        }
                                        else
                                        {
                                            <span>الإجمالي: @Contract.TotalAgreedAmount.ToString("N0") ₪ | مقبوض: @Contract.PaidAmount.ToString("N0") ₪ | متبقي: @Contract.RemainingAmount.ToString("N0") ₪</span>
                                        }
                                    </span>
                                    <span style="font-weight: 800; width: 28%; text-align: right;">الدفعات</span>
                                </div>
                            </div>

                            <!-- Legal Warning Footer -->
                            <div style="border-top: 1.5px solid #000; padding: 4px 6px; text-align: center; font-weight: 900; font-size: 0.70rem; background: #ffffff; margin-top: auto;">
                                ملاحظة : يتحمل المستأجر أية مخالفة أو مسؤولية قانونية من تاريخ وساعة استلام السيارة تكون السيارة طرفاً فيها
                            </div>
                        </div>

                        <!-- LEFT BOX (Column 2 in RTL): Vehicle Details & In/Out Logistics -->
                        <div style="border: 2px solid #000000; border-radius: 4px; display: flex; flex-direction: column; justify-content: space-between; font-size: 0.74rem; background: #ffffff;">
                            
                            <!-- Vehicle Details Rows -->
                            <div style="display: flex; flex-direction: column;">
                                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #000; padding: 3px 6px;">
                                    <span style="font-size: 0.70rem; color: #1e293b; direction: ltr; font-weight: 600; width: 28%; text-align: left;">Car</span>
                                    <span style="font-weight: 900; font-size: 0.82rem; text-align: center; flex: 1;">@Contract.Vehicle?.Brand @Contract.Vehicle?.Model (@Contract.Vehicle?.ModelYear)</span>
                                    <span style="font-weight: 800; width: 28%; text-align: right;">السيارة</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #000; padding: 3px 6px;">
                                    <span style="font-size: 0.70rem; color: #1e293b; direction: ltr; font-weight: 600; width: 28%; text-align: left;">Licence</span>
                                    <span style="font-weight: 900; font-family: monospace; font-size: 0.88rem; text-align: center; flex: 1;">@Contract.Vehicle?.PlateNumber</span>
                                    <span style="font-weight: 800; width: 28%; text-align: right;">رقم السيارة</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #000; padding: 3px 6px;">
                                    <span style="font-size: 0.70rem; color: #1e293b; direction: ltr; font-weight: 600; width: 28%; text-align: left;">No. Of return</span>
                                    <span style="font-weight: 900; text-align: center; flex: 1;">@(Contract.IsOpenEnded ? $"{GetRentalDurationDays()} يوم (مفتوح)" : $"{GetRentalDurationDays()} يوم")</span>
                                    <span style="font-weight: 800; width: 28%; text-align: right;">عدد الأيام</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #000; padding: 3px 6px;">
                                    <span style="font-size: 0.70rem; color: #1e293b; direction: ltr; font-weight: 600; width: 28%; text-align: left;">Date of Day</span>
                                    <span style="font-weight: 900; font-family: monospace; text-align: center; flex: 1;">@(Contract.IsOpenEnded ? "عقد مفتوح (حسب الطلب)" : Contract.ExpectedReturnDateTime.ToString("yyyy/MM/dd"))</span>
                                    <span style="font-weight: 800; width: 28%; text-align: right;">تاريخ الإرجاع</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #000; padding: 3px 6px;">
                                    <span style="font-size: 0.70rem; color: #1e293b; direction: ltr; font-weight: 600; width: 28%; text-align: left;">Daily Charges</span>
                                    <span style="font-weight: 900; text-align: center; flex: 1;">@Contract.DailyAgreedRate.ToString("N0") ₪</span>
                                    <span style="font-weight: 800; width: 28%; text-align: right;">الأجرة اليومية</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #000; padding: 3px 6px;">
