                                        <div style="display: inline-flex; align-items: center; gap: 5px; background: #ffffff; border: 1.5px solid #dc2626; border-radius: 4px; padding: 2px 8px;">
                                            <span style="background: #dc2626; color: #ffffff; border-radius: 50%; width: 16px; height: 16px; display: inline-flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 900;">@(i + 1)</span>
                                            <strong style="color: #991b1b;">@mark.DamageType:</strong>
                                            <span style="color: #1e293b; font-weight: 600;">@(string.IsNullOrWhiteSpace(mark.Description) ? "بدون وصف إضافي" : mark.Description)</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div style="display: flex; justify-content: space-between; align-items: flex-end; padding-top: 15px; border-top: 1.5px solid #000;">
                        <div style="text-align: center; width: 220px;">
                            <div style="font-weight: 800; font-size: 0.85rem; margin-bottom: 40px;">توقيع المستأجر بالاستلام:</div>
                            <div style="border-top: 1px dashed #000; padding-top: 2px; font-size: 0.8rem;">@Contract.Customer?.FullName</div>
                        </div>
                        <div style="text-align: center; width: 220px;">
                            <div style="font-weight: 800; font-size: 0.85rem; margin-bottom: 40px;">توقيع موظف الفحص والتسليم:</div>
                            <div style="border-top: 1px dashed #000; padding-top: 2px; font-size: 0.8rem;">اعتماد المعاينة</div>
                        </div>
                    </div>
                </div>
            }

            @if (_currentDoc == "receipt" || _currentDoc == "payment")
