                <!-- Non-Printable Quick Toolbar to Adjust Amount or Notes -->
                <div class="no-print" style="max-width: 820px; margin: 0 auto 15px auto; background: #ffffff; border: 1.5px solid var(--border-color); border-radius: 8px; padding: 10px 16px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span style="font-weight: 800; font-size: 0.88rem; color: #0f172a;">
