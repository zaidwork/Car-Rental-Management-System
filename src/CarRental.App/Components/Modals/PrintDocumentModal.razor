                        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px;">
                            <div>[ ✓ ] الإطار الاحتياطي (Spare Tire)</div>
                            <div>[ ✓ ] رافعة المركبة (Jack)</div>
                            <div>[ ✓ ] مفتاح العجلات (Wheel Wrench)</div>
                            <div>[ ✓ ] طفاية الحريق (Fire Extinguisher)</div>
                            <div>[ ✓ ] حقيبة الإسعافات (First Aid Kit)</div>
                            <div>[ ✓ ] مثلث التحذير (Warning Triangle)</div>
                            <div>[ ✓ ] نظافة الهيكل الخارجي</div>
                            <div>[ ✓ ] نظافة المقصورة والفرش</div>
                            <div>[ ✓ ] رخصة ورقة التأمين الأصلية</div>
                        </div>
                    </div>

                    <!-- Inspection Diagram in Sheet with Marks Overlay -->
