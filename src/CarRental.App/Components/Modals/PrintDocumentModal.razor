                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M20 6L9 17l-5-5"></path>
                            </svg>
                            <span>✓ تأكيد العقد والطباعة الرسمية (A4)</span>
                        }
                    </button>
                }
                else
                {
                    <button class="btn-primary-action" @onclick="PrintDocument">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="6 9 6 2 18 2 18 9"></polyline>
                            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                            <rect x="6" y="14" width="12" height="8"></rect>
                        </svg>
                        <span>
                            @(_currentDoc switch {
                                "contract_both" => "طباعة العقد وجه وقفا (صفحة A4 كاملة)",
                                "contract_front" => "طباعة وجه العقد فقط (صفحة 1)",
                                "contract_back" => "طباعة قفا العقد فقط (شروط التأجير)",
                                "note" => "طباعة كمبيالة الضمان الرسمية",
                                "inspection" => "طباعة محضر المعاينة والفحص",
                                "receipt" => "طباعة سند القبض المالي الرسمي (A4)",
                                "payment" => "طباعة سند الصرف المالي الرسمي (A4)",
                                _ => "طباعة المستند فورياً (A4)"
                            })
                        </span>
                    </button>
                }
            </div>
        </div>
    </div>
</div>
}

@code {
    [Parameter] public Contract? Contract { get; set; }
    [Parameter] public bool InitialTabContract { get; set; } = true;
    [Parameter] public EventCallback OnClose { get; set; }

    // دعم الرجوع وتعديل البيانات قبل الاعتماد أو التراجع عن العقد الجديد
    [Parameter] public bool IsPendingConfirmation { get; set; } = false;
    [Parameter] public bool CanRollbackNewContract { get; set; } = false;
    [Parameter] public EventCallback OnBackToEdit { get; set; }
    [Parameter] public EventCallback OnConfirmContract { get; set; }

    private bool _isConfirming = false;

    private async Task HandleBackToEdit()
    {
        if (OnBackToEdit.HasDelegate)
        {
            await OnBackToEdit.InvokeAsync();
        }
        else
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task HandleCloseOrBack()
    {
        if (IsPendingConfirmation)
        {
            await HandleBackToEdit();
        }
        else
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task HandleConfirmAndPrint()
    {
        if (_isConfirming) return;
        _isConfirming = true;
        try
        {
            if (OnConfirmContract.HasDelegate)
            {
                await OnConfirmContract.InvokeAsync();
            }
            await PrintDocument();
        }
        finally
        {
            _isConfirming = false;
        }
    }

    private string _currentDoc = "contract_both";
    private string _selectedCompany = "samara"; // "samara" or "altaj"
    private CompanyProfile? _companyProfile;
    private bool _showWhatsAppModal = false;
    private string _whatsAppPrefix = "970";
    private string _whatsAppPhone = "";

    // Voucher Print State
    private decimal _voucherAmount = 0;
    private string _voucherNotes = "";
    private string _voucherRecipient = "";

    private void SelectDocument(string doc)
    {
        _currentDoc = doc;
        if (doc == "receipt" && Contract != null)
        {
            _voucherAmount = Contract.PaidAmount;
            _voucherRecipient = Contract.Customer?.FullName ?? "";
            _voucherNotes = $"دفعة مالية معتمدة لتأجير مركبة سياحية بموجب العقد رقم ({Contract.ContractNumber})";
        }
        else if (doc == "payment" && Contract != null)
        {
            _voucherAmount = Contract.PaidAmount > 0 ? Contract.PaidAmount : 0;
            _voucherRecipient = Contract.Customer?.FullName ?? "";
            _voucherNotes = $"استرداد مالي / رد رصيد عن عقد التأجير رقم ({Contract.ContractNumber})";
        }
    }

    // Company Presets
    private string ActiveCompanyNameAr => _selectedCompany == "samara" 
        ? "شركة سمارة" 
        : "شركة التاج";

    private string ActiveCompanySubtitleAr => "لتأجير السيارات السياحية";

    private string ActiveCompanyNameEn => _selectedCompany == "samara" 
        ? "SAMARA Rental Company" 
        : "ALTAJ Rental Company";

    private string ActiveCompanySubtitleEn => "Tourist Car Rental";

    private string ActiveCompanyDealerNo => _selectedCompany == "samara" 
        ? "562171389" 
        : "562514273";

    private string ActiveCompanyAddressAr => "طوباس - قرب الصحة الجديدة";
    private string ActiveCompanyAddressEn => "Tubas - near the new health";
    private string ActiveCompanyPhones => "05 666 5555 0 | 0566 009 003";

    private string ActiveCompanyBrandAr => _selectedCompany == "samara" ? "سـمـارة" : "الـتـاج";
    private string ActiveCompanyBrandEn => _selectedCompany == "samara" ? "SAMARA" : "ALTAJ";

    private List<VehicleDamageMark> _vehicleDamageMarks = new();


    protected override async Task OnInitializedAsync()
    {
        try
        {
            _companyProfile = await RentalService.GetCompanyProfileAsync();
            if (_companyProfile != null && !string.IsNullOrWhiteSpace(_companyProfile.CompanyName))
            {
                if (_companyProfile.CompanyName.Contains("تاج") || _companyProfile.CompanyName.ToLower().Contains("taj"))
                {
                    _selectedCompany = "altaj";
                }
                else if (_companyProfile.CompanyName.Contains("سمارة") || _companyProfile.CompanyName.ToLower().Contains("samara"))
                {
                    _selectedCompany = "samara";
                }
            }
        }
        catch { }

        await LoadVehicleDamageMarksAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        _currentDoc = InitialTabContract ? "contract_both" : "note";
        if (Contract != null)
        {
            _voucherAmount = Contract.PaidAmount;
            _voucherRecipient = Contract.Customer?.FullName ?? "";
            _voucherNotes = $"دفعة مالية معتمدة لتأجير مركبة سياحية بموجب العقد رقم ({Contract.ContractNumber})";
        }
        await LoadVehicleDamageMarksAsync();
    }

    private async Task LoadVehicleDamageMarksAsync()
    {
        try
        {
            if (Contract?.VehicleId != null && Contract.VehicleId != Guid.Empty)
            {
                var vehicle = await RentalService.GetVehicleByIdAsync(Contract.VehicleId);
                if (vehicle != null)
                {
                    _vehicleDamageMarks = vehicle.GetDamageMarks().Where(m => !m.IsRepaired).ToList();
                    return;
                }
            }

            if (Contract?.Vehicle != null)
            {
                _vehicleDamageMarks = Contract.Vehicle.GetDamageMarks().Where(m => !m.IsRepaired).ToList();
            }
        }
        catch { }
    }

    private string GetViewArabicName(string? view) => (view ?? "").ToLower().Trim() switch
    {
        "front" => "أمامي",
        "side" => "جانبي",
        "rear" => "خلفي",
        "persp_front" => "مجسم أمامي",
        "persp_rear" => "مجسم خلفي",
        _ => "المخطط الشامل"
    };

    private (double X, double Y) GetUniversalMarkCoordinates(VehicleDamageMark mark)
    {
        return VehicleInspectionCoordinates.ToUniversalCoordinates(mark);
    }

    private int GetRentalDurationDays()
    {
        if (Contract == null) return 1;
        if (Contract.IsOpenEnded)
        {
            return Contract.OpenRentalDays;
        }
        var days = (int)Math.Ceiling((Contract.ExpectedReturnDateTime - Contract.StartDateTime).TotalDays);
        return Math.Max(1, days);
    }

    private async Task PrintDocument()
    {
        await JSRuntime.InvokeVoidAsync("window.printDocumentArea", "printableContractContainer", "A4");
    }

    private void ToggleWhatsAppModal()
    {
        _showWhatsAppModal = !_showWhatsAppModal;
        if (_showWhatsAppModal && string.IsNullOrWhiteSpace(_whatsAppPhone))
        {
            _whatsAppPhone = Contract?.Customer?.PrimaryPhone ?? "";
        }
    }

    private string GetContractWhatsAppMessage()
    {
        if (Contract == null) return string.Empty;

        var custName = Contract.Customer?.FullName ?? "العميل المحترم";
        var carBrand = Contract.Vehicle?.Brand ?? "";
        var carModel = Contract.Vehicle?.Model ?? "";
        var plate = Contract.Vehicle?.PlateNumber ?? "";
        var startStr = Contract.StartDateTime.ToString("yyyy/MM/dd hh:mm tt");
        var returnStr = Contract.IsOpenEnded 
            ? "عقد مفتوح (حساب يومي مستمر حسب طلب العميل)" 
            : $"{Contract.ExpectedReturnDateTime:yyyy/MM/dd hh:mm tt} ({GetRentalDurationDays()} يوم)";
        var days = GetRentalDurationDays();
        var dailyRate = Contract.DailyAgreedRate.ToString("N0");
        var total = Contract.IsOpenEnded 
            ? $"{Contract.OpenRentalAccruedAmount:N0} ₪ (مستحق حتى اللحظة)" 
            : $"{Contract.TotalAgreedAmount:N0} ₪";
        var paid = Contract.PaidAmount.ToString("N0");
        var remaining = Contract.IsOpenEnded 
            ? $"{Contract.OpenRentalCurrentDue:N0} ₪" 
            : $"{Contract.RemainingAmount:N0} ₪";

        var msg = $"✦ *شركة التـاج لتأجيـر السيـارات* (TAJ SYSTEM) ✦\n" +
                  $"━━━━━━━━━━━━━━━━━━━━━\n" +
                  $"مرحباً بك أخي الكريم: *{custName}*\n" +
                  $"تم توثيق عقد الإيجار الرسمي برقم: *{Contract.ContractNumber}* {(Contract.IsOpenEnded ? "(عقد مفتوح)" : "")}\n\n" +
                  $"▪ *المركبة:* {carBrand} {carModel} (لوحة: *{plate}*)\n" +
                  $"▪ *موعد الاستلام:* {startStr}\n" +
                  $"▪ *موعد الإرجاع:* {returnStr}\n" +
                  $"▪ *الأجرة اليومية:* {dailyRate} ₪\n";

        if (Contract.DiscountAmount > 0)
        {
            msg += $"▪ *السعر قبل الخصم:* {Contract.OriginalAgreedAmount:N0} ₪ | *الخصم:* -{Contract.DiscountAmount:N0} ₪ {(Contract.DiscountType == "Percentage" ? $"({Contract.DiscountValue}%)" : "")}\n";
        }

        msg += $"▪ *الحساب المالي:* {(Contract.IsOpenEnded ? "المستحق حالياً" : "الإجمالي")}: *{total}* | المدفوع: *{paid} ₪* | المتبقي: *{remaining}*\n";

        if (!string.IsNullOrWhiteSpace(Contract.AdditionalDriverName))
        {
            msg += $"▪ *السائق الإضافي المعتمد:* {Contract.AdditionalDriverName}\n";
        }

        msg += $"━━━━━━━━━━━━━━━━━━━━━\n" +
               $"نتمنى لكم رحلة آمنة وموفقة بإذن الله\n" +
               $"☎ *خدمة العملاء:* 0566655550 | 0566009003";

        return msg;
    }

    private async Task CopyContractWhatsApp()
    {
        var msg = GetContractWhatsAppMessage();
        try
        {
            System.Windows.Clipboard.SetText(msg);
            await JSRuntime.InvokeVoidAsync("alert", "تم نسخ نص رسالة العقد بنجاح إلى الحافظة! يمكنك لصقها الآن في محادثة واتساب.");
        }
        catch { }
    }

    private void SendContractWhatsApp()
    {
        if (Contract == null || string.IsNullOrWhiteSpace(_whatsAppPhone)) return;

        var msg = GetContractWhatsAppMessage();
        WhatsAppHelper.OpenWhatsApp(_whatsAppPhone, _whatsAppPrefix, msg);
        _showWhatsAppModal = false;
    }
}

