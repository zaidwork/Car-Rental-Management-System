                                <span style="font-size: 1.35rem; font-weight: 900; color: #000000; font-family: monospace; background: #ffffff; padding: 2px 14px; border-radius: 4px; border: 1.5px solid #000000;">
                                    @payAmount.ToString("N0") ₪
                                </span>
                            </div>
                            <div style="display: flex; align-items: center; gap: 8px;">
