                        </div>
                        <div>
                            <div style="font-weight: 900; font-size: 0.9rem; margin-bottom: 35px;">كفيل:</div>
                            <div style="border-top: 1px solid #000; padding-top: 2px; font-size: 0.82rem;">الاسم والتوقيع: ............................</div>
                        </div>
                        <div>
                            <div style="font-weight: 900; font-size: 0.9rem; margin-bottom: 35px;">شاهد:</div>
                            <div style="border-top: 1px solid #000; padding-top: 2px; font-size: 0.82rem;">الاسم والتوقيع: ............................</div>
                        </div>
                    </div>

                    <!-- Section: Authorization (إقرار وتفويض) -->
                    <div style="margin-top: 10px;">
                        <div style="text-align: center; margin-bottom: 12px;">
                            <h2 style="font-size: 1.3rem; font-weight: 900; letter-spacing: 2px; margin: 0;">
