<!-- Delete Vehicle Confirmation Modal -->
@if (_showDeleteModal && _vehicleToDelete != null)
{
    <div class="modal-overlay">
        <div class="modal-card" style="max-width: 500px; width: 95%;">
            <div class="modal-header" style="background: #fee2e2; border-bottom: 1.5px solid #fca5a5;">
                <div class="modal-title" style="display: flex; align-items: center; gap: 8px; color: #991b1b;">
                    <div style="width: 32px; height: 32px; border-radius: 50%; background: #dc2626; color: white; display: flex; align-items: center; justify-content: center; font-size: 1.1rem;">
                        🗑️
                    </div>
                    <span style="font-size: 1.1rem; font-weight: 800;">تأكيد حذف المركبة من الأسطول</span>
                </div>
                <button type="button" class="btn-close-modal" @onclick="() => _showDeleteModal = false">×</button>
            </div>
            <div class="modal-body" style="padding: 20px;">
                <div style="text-align: center; margin-bottom: 16px;">
                    <div style="font-size: 1rem; font-weight: 700; color: #475569;">
                        هل أنت متأكد من رغبتك في حذف المركبة:
                    </div>
                    <div style="font-size: 1.25rem; font-weight: 900; color: #0f172a; margin: 6px 0;">
                        @_vehicleToDelete.Brand @_vehicleToDelete.Model (@_vehicleToDelete.ModelYear)
                    </div>
                    <div style="display: inline-block; font-family: monospace; font-weight: bold; background: #ede6d8; padding: 4px 12px; border-radius: 6px; font-size: 1rem; border: 1px solid var(--border-color); color: var(--primary-blue);">
                        رقم اللوحة: @_vehicleToDelete.PlateNumber
                    </div>
                </div>

                @if (_vehicleToDelete.Status == VehicleStatus.Rented)
                {
                    <div style="background: #fee2e2; border: 1.5px solid #ef4444; border-radius: 8px; padding: 12px; color: #991b1b; font-size: 0.88rem; font-weight: 700; line-height: 1.5;">
                        ⛔ تنبيه أمان: هذه المركبة <strong>مؤجرة حالياً بعقد نشط</strong>! لا يمكن حذفها من النظام حتى يتم استلامها وإنهاء العقد رسمياً.
                    </div>
                }
                else
                {
                    <div style="background: #fffbeb; border: 1.5px solid #fcd34d; border-radius: 8px; padding: 12px; color: #92400e; font-size: 0.85rem; line-height: 1.5;">
                        ⚠️ ملاحظة: سيتم حذف المركبة وإزالتها من الأسطول المتاح للتأجير. إذا كان للمركبة عقود تاريخية سابقة فسيتم الاحتفاظ بها في الأرشيف المالي لضمان سلامة الحسابات.
                    </div>
                }

                @if (!string.IsNullOrEmpty(_deleteError))
                {
                    <div style="margin-top: 12px; background: #fee2e2; border: 1px solid #ef4444; color: #b91c1c; padding: 8px 12px; border-radius: 6px; font-size: 0.85rem; font-weight: bold;">
                        @_deleteError
                    </div>
                }
            </div>
            <div class="modal-footer" style="display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="filter-pill" @onclick="() => _showDeleteModal = false">إلغاء</button>
                @if (_vehicleToDelete.Status != VehicleStatus.Rented)
                {
                    <button type="button" class="btn-primary-action" style="background: #dc2626; border-color: #b91c1c; color: white;" @onclick="ConfirmDeleteVehicle" disabled="@_isDeleting">
                        @if (_isDeleting)
                        {
                            <span>جاري الحذف...</span>
                        }
                        else
                        {
                            <span>نعم، حذف المركبة</span>
                        }
                    </button>
                }
            </div>
        </div>
    </div>
}

@if (_showNewContractModal && _contractVehicleId.HasValue)
{
    <NewContractModal 
        InitialVehicleId="_contractVehicleId" 
        OnContractCreated="OnContractCreated" 
        OnClose="() => { _showNewContractModal = false; _contractVehicleId = null; }" />
}

@code {
    private bool _showNewContractModal = false;
    private Guid? _contractVehicleId;

    private void OpenRentalForVehicle(Vehicle v)
    {
        _contractVehicleId = v.Id;
        _showNewContractModal = true;
    }

    private async Task OnContractCreated()
    {
        _showNewContractModal = false;
        _contractVehicleId = null;
        await LoadVehicles();
    }

    private bool _showDeleteModal = false;
    private Vehicle? _vehicleToDelete;
    private string? _deleteError;
    private bool _isDeleting = false;

    private void PromptDeleteVehicle(Vehicle v)
    {
        _vehicleToDelete = v;
        _deleteError = null;
        _isDeleting = false;
        _showDeleteModal = true;
    }

    private void PromptDeleteVehicleFromModal()
    {
        if (_newVehicle != null)
        {
            var match = _vehicles?.FirstOrDefault(v => v.Id == _newVehicle.Id) ?? _newVehicle;
            _showAddModal = false;
            PromptDeleteVehicle(match);
        }
    }

    private async Task ConfirmDeleteVehicle()
    {
        if (_vehicleToDelete == null) return;

        _deleteError = null;
        _isDeleting = true;

        try
        {
            var staffName = !string.IsNullOrWhiteSpace(AuthState.CurrentUser.Username) 
                ? AuthState.CurrentUser.Username 
                : AuthState.CurrentUser.FullName;

            await RentalService.DeleteVehicleAsync(_vehicleToDelete.Id, staffName);
            _showDeleteModal = false;
            _vehicleToDelete = null;
            await LoadVehicles();
        }
        catch (Exception ex)
        {
            _deleteError = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private Vehicle? _selectedFinancialVehicle;
    private void OpenVehicleFinancialModal(Vehicle vehicle)
    {
        _selectedFinancialVehicle = vehicle;
    }

    private Vehicle? _vehicleForCondition;

    private void OpenVehicleConditionModal(Vehicle vehicle)
    {
        _vehicleForCondition = vehicle;
    }

    private async Task OnVehicleConditionSaved()
    {
        _vehicleForCondition = null;
        await LoadVehicles();
    }
    private List<Vehicle>? _vehicles;
    private string _searchQuery = "";
    private bool _showAddModal = false;
    private Vehicle _newVehicle = new();

    private IEnumerable<Vehicle> FilteredVehicles => _vehicles?
        .Where(v => string.IsNullOrWhiteSpace(_searchQuery) ||
                    v.Brand.ContainsArabic(_searchQuery) ||
                    v.Model.ContainsArabic(_searchQuery) ||
                    v.PlateNumber.ContainsArabic(_searchQuery) ||
                    (v.Color != null && v.Color.ContainsArabic(_searchQuery)) ||
                    v.VinNumber.ContainsArabic(_searchQuery)) ?? Enumerable.Empty<Vehicle>();

    protected override async Task OnInitializedAsync()
    {
        RentalService.OnContractsDataChanged += HandleContractsDataChanged;
        await LoadVehicles();
    }

    private async void HandleContractsDataChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadVehicles();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        RentalService.OnContractsDataChanged -= HandleContractsDataChanged;
    }

    private async Task LoadVehicles()
    {
        _vehicles = await RentalService.GetVehiclesAsync();
    }

    private bool _isEditingExistingVehicle = false;
    private string? _modalError;

    private void OpenAddVehicleModal()
    {
        _isEditingExistingVehicle = false;
        _modalError = null;
        _newVehicle = new Vehicle
        {
            ModelYear = DateTime.Now.Year,
            LicenseExpiryDate = DateTime.Today.AddYears(1),
            InsuranceExpiryDate = DateTime.Today.AddYears(1),
            CurrentOdometer = 1000,
            NextOilChangeOdometer = 10000,
            NextMaintenanceDate = DateTime.Today.AddMonths(6),
            DailyStandardRate = 180,
            ImageUrl = "/images/cars/accent_white.jpg"
        };
        _showAddModal = true;
    }

    private bool IsImageSelected(string path)
    {
        if (string.IsNullOrEmpty(_newVehicle.ImageUrl)) return false;
        var normA = _newVehicle.ImageUrl.TrimStart('/');
        var normB = path.TrimStart('/');
        return normA.Equals(normB, StringComparison.OrdinalIgnoreCase);
    }

    private void OpenEditVehicleModal(Vehicle v)
    {
        _isEditingExistingVehicle = true;
        _modalError = null;
        _newVehicle = new Vehicle
        {
            Id = v.Id,
            Brand = v.Brand,
            Model = v.Model,
            ModelYear = v.ModelYear,
            Color = v.Color,
            PlateNumber = v.PlateNumber,
            VinNumber = v.VinNumber,
            CurrentOdometer = v.CurrentOdometer,
            DailyStandardRate = v.DailyStandardRate,
            LicenseExpiryDate = v.LicenseExpiryDate,
            InsuranceExpiryDate = v.InsuranceExpiryDate,
            InsuranceCompany = v.InsuranceCompany,
            NextOilChangeOdometer = v.NextOilChangeOdometer,
            NextMaintenanceDate = v.NextMaintenanceDate,
            Status = v.Status,
            ImageUrl = v.ImageUrl,
            IsActive = v.IsActive,
            CreatedAt = v.CreatedAt
        };
        _showAddModal = true;
    }

    private async Task HandleVehiclePhotoUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                // ضغط ذكي بحجم 500x320 لإنتاج صورة خفيفة جداً (~25KB) وعالية الوضوح لضمان عدم استهلاك مساحة السحابة
                var resized = await file.RequestImageFileAsync("image/jpeg", 500, 320);
                using var stream = resized.OpenReadStream(maxAllowedSize: 6 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var base64 = Convert.ToBase64String(ms.ToArray());
                _newVehicle.ImageUrl = $"data:image/jpeg;base64,{base64}";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error uploading car photo: {ex.Message}");
        }
    }

    private async Task SaveNewVehicle()
    {
        _modalError = null;
        if (string.IsNullOrWhiteSpace(_newVehicle.Brand) || string.IsNullOrWhiteSpace(_newVehicle.Model) || string.IsNullOrWhiteSpace(_newVehicle.PlateNumber))
        {
            _modalError = "يرجى تعبئة الحقول الإلزامية: الشركة المصنعة، الطراز، ورقم اللوحة!";
            return;
        }

        try
        {
            var staffName = !string.IsNullOrWhiteSpace(AuthState.CurrentUser.Username) 
                ? AuthState.CurrentUser.Username 
                : AuthState.CurrentUser.FullName;

            await RentalService.SaveVehicleAsync(_newVehicle, staffName);
            _showAddModal = false;
            await LoadVehicles();
        }
        catch (Exception ex)
        {
            _modalError = ex.InnerException?.Message ?? ex.Message;
        }
    }

    private void OpenMaintenanceModal(Vehicle v)
    {
        _ = OpenMaintenanceProfileModal(v);
    }

    // Comprehensive Maintenance Profile State
    private Vehicle? _selectedVehicleForProfile;
    private List<MaintenanceRecord> _vehicleHistory = new();
    private string _activeProfileTab = "overview";
    private string? _profileMessage;
    private string? _profileError;
    private bool _showHaltReasonInput = false;
    private string _haltReason = "";

    // Critical schedule edit fields
    private int? _editNextDueOdometer;
    private DateTime? _editNextDueDate;
    private bool _editIsCritical;
    private string? _editCriticalReason;

    // Confirm maintenance fields
    private MaintenanceType _confirmType = MaintenanceType.RoutineOilFilter;
    private int _confirmOdometer;
    private decimal _confirmCost = 250;
    private string _confirmProvider = "مركز الخدمة السريع";
    private string _confirmInvoice = "";
    private string _confirmNotes = "";
    private int? _confirmNextOdometer;
    private DateTime? _confirmNextDate;
    private bool _confirmNextIsCritical = true;

    private void SetScheduleDurationMonths(int months)
    {
        _editNextDueDate = DateTime.Today.AddMonths(months);
    }

    private void SetConfirmScheduleDurationMonths(int months)
    {
        _confirmNextDate = DateTime.Today.AddMonths(months);
    }

    private async Task OpenMaintenanceProfileModal(Vehicle v)
    {
        _profileMessage = null;
        _profileError = null;
        _activeProfileTab = "overview";
        _showHaltReasonInput = false;
        _haltReason = "";

        _selectedVehicleForProfile = await RentalService.GetVehicleMaintenanceProfileAsync(v.Id) ?? v;
        _vehicleHistory = await RentalService.GetMaintenanceRecordsAsync(v.Id);

        _editNextDueOdometer = _selectedVehicleForProfile.NextOilChangeOdometer;
        _editNextDueDate = _selectedVehicleForProfile.NextMaintenanceDate;
        _editIsCritical = _selectedVehicleForProfile.IsMaintenanceCritical;
        _editCriticalReason = _selectedVehicleForProfile.CriticalMaintenanceReason ?? "صيانة دورية حرجة";

        _confirmType = MaintenanceType.RoutineOilFilter;
        _confirmOdometer = _selectedVehicleForProfile.CurrentOdometer;
        _confirmCost = 250;
        _confirmProvider = "مركز الخدمة السريع";
        _confirmInvoice = "";
        _confirmNotes = "";
        _confirmNextOdometer = _selectedVehicleForProfile.CurrentOdometer + 10000;
        _confirmNextDate = DateTime.Today.AddMonths(6);
        _confirmNextIsCritical = true;
    }

    private void CloseMaintenanceProfileModal()
    {
        _selectedVehicleForProfile = null;
    }

    private async Task RefreshProfile()
    {
        if (_selectedVehicleForProfile != null)
        {
            _selectedVehicleForProfile = await RentalService.GetVehicleMaintenanceProfileAsync(_selectedVehicleForProfile.Id);
            if (_selectedVehicleForProfile != null)
            {
                _vehicleHistory = await RentalService.GetMaintenanceRecordsAsync(_selectedVehicleForProfile.Id);
                _editNextDueOdometer = _selectedVehicleForProfile.NextOilChangeOdometer;
                _editNextDueDate = _selectedVehicleForProfile.NextMaintenanceDate;
                _editIsCritical = _selectedVehicleForProfile.IsMaintenanceCritical;
                _editCriticalReason = _selectedVehicleForProfile.CriticalMaintenanceReason;
            }
        }
    }

    private async Task ToggleHalt(bool halt)
    {
        _profileError = null;
        _profileMessage = null;
        try
        {
            var staff = !string.IsNullOrWhiteSpace(AuthState.CurrentUser.Username) 
                ? AuthState.CurrentUser.Username 
                : AuthState.CurrentUser.FullName;

            await RentalService.ToggleVehicleMaintenanceHaltAsync(
                _selectedVehicleForProfile!.Id,
                halt,
                halt ? (string.IsNullOrWhiteSpace(_haltReason) ? "إيقاف إداري للصيانة ومنع التأجير" : _haltReason) : null,
                staff);

            _profileMessage = halt ? "تم إيقاف المركبة بنجاح ومنعها من التأجير في كافة أنحاء النظام." : "تم فك إيقاف المركبة وإعادتها متاحة للتأجير.";
            _showHaltReasonInput = false;
            _haltReason = "";

            await RefreshProfile();
            await LoadVehicles();
        }
        catch (Exception ex)
        {
            _profileError = ex.InnerException?.Message ?? ex.Message;
        }
    }

    private async Task SaveCriticalSchedule()
    {
        _profileError = null;
        _profileMessage = null;
        try
        {
            var staff = !string.IsNullOrWhiteSpace(AuthState.CurrentUser.Username) 
                ? AuthState.CurrentUser.Username 
                : AuthState.CurrentUser.FullName;

            await RentalService.SetCriticalMaintenanceScheduleAsync(
                _selectedVehicleForProfile!.Id,
                _editNextDueOdometer,
                _editNextDueDate,
                _editIsCritical,
                _editCriticalReason,
                staff);

            _profileMessage = "تم حفظ وتحديث جدول وحد الصيانة بنجاح.";
            await RefreshProfile();
            await LoadVehicles();
        }
        catch (Exception ex)
        {
            _profileError = ex.InnerException?.Message ?? ex.Message;
        }
    }

    private async Task ConfirmMaintenanceCompleted()
    {
        _profileError = null;
        _profileMessage = null;
        if (_confirmOdometer < _selectedVehicleForProfile!.CurrentOdometer)
        {
            _profileError = $"قراءة العداد عند الصيانة ({_confirmOdometer} كم) لا يمكن أن تكون أقل من قراءة العداد الحالية ({_selectedVehicleForProfile.CurrentOdometer} كم)!";
            return;
        }
        if (string.IsNullOrWhiteSpace(_confirmProvider))
        {
            _profileError = "يرجى إدخال اسم مركز الخدمة أو الورشة المنفذة للصيانة!";
            return;
        }

        try
        {
            var staff = !string.IsNullOrWhiteSpace(AuthState.CurrentUser.Username) 
                ? AuthState.CurrentUser.Username 
                : AuthState.CurrentUser.FullName;

            await RentalService.ConfirmMaintenanceCompletedAsync(
                _selectedVehicleForProfile.Id,
                _confirmType,
                _confirmOdometer,
                _confirmCost,
                _confirmProvider,
                _confirmInvoice,
                _confirmNotes,
                _confirmNextOdometer,
                _confirmNextDate,
                _confirmNextIsCritical,
                staff);

            _profileMessage = "تم تأكيد إنجاز الصيانة بنجاح، وتحديث قراءة العداد، وفك حظر المركبة وإعادتها متاحة للتأجير الفوري!";
            await RefreshProfile();
            await LoadVehicles();
        }
        catch (Exception ex)
        {
            _profileError = ex.InnerException?.Message ?? ex.Message;
        }
    }

    private string GetMaintenanceTypeName(MaintenanceType type) => type switch
    {
        MaintenanceType.RoutineOilFilter => "تغيير زيت وفلاتر دوري",
        MaintenanceType.Brakes => "فحص واستبدال فحمات المكابح",
        MaintenanceType.Tires => "تبديل أو صيانة الإطارات",
        MaintenanceType.Battery => "فحص واستبدال البطارية",
        MaintenanceType.MechanicalRepair => "إصلاح ميكانيكي عام",
        MaintenanceType.BodyWork => "صيانة هيكل ودهان",
        MaintenanceType.LicenseRenewal => "تجديد رخصة واستمارة",
        MaintenanceType.InsuranceRenewal => "تجديد بوليصة التأمين",
        _ => "صيانة عامة"
    };
}
