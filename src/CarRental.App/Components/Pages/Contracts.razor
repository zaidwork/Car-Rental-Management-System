@code {
    private List<Contract>? _contracts;
    private ContractStatus? _statusFilter;
    private string _searchQuery = "";
    private bool _showNewContractModal = false;

    private IEnumerable<Contract> FilteredContracts => _contracts?
        .Where(c => string.IsNullOrWhiteSpace(_searchQuery) ||
                    c.ContractNumber.ContainsArabic(_searchQuery) ||
                    (c.Customer != null && c.Customer.FullName.ContainsArabic(_searchQuery)) ||
                    (c.Customer != null && c.Customer.NationalIdOrPassport.ContainsArabic(_searchQuery)) ||
                    (c.Vehicle != null && c.Vehicle.PlateNumber.ContainsArabic(_searchQuery)) ||
                    (c.Vehicle != null && c.Vehicle.Brand.ContainsArabic(_searchQuery)) ||
                    (c.Vehicle != null && c.Vehicle.Model.ContainsArabic(_searchQuery)) ||
                    (c.PromissoryNoteNumber != null && c.PromissoryNoteNumber.ContainsArabic(_searchQuery)))
        ?? Enumerable.Empty<Contract>();

    private Contract? _contractToPrint;
    private bool _isContractTab = true;

    private Contract? _contractToExtend;
    private Contract? _contractToInspect;
    private Contract? _contractForReturn;
    private InspectionType _inspectionInitialType = InspectionType.HandoverOut;
    private FinancialTransaction? _voucherToPrint;

    private Contract? _contractToClose;
    private Contract? _contractToCancel;
    private string? _cancellationReason;
    private bool _isCancelling = false;
    private string? _cancelError;

    private Contract? _contractToPay;
    private decimal _contractPaymentAmount = 0;
    private PaymentMode _contractPaymentMode = PaymentMode.ImmediateCash;
    private string _contractPaymentNotes = "";
    private string? _contractPaymentError;
    private bool _isSubmittingContractPayment = false;

    private int _endOdometer;
    private FuelLevel _endFuel = FuelLevel.Full;
    private decimal _lateFee = 0;
    private decimal _fuelFee = 0;
    private decimal _extraKmFee = 0;
    private decimal _damageFee = 0;
    private string _settleDiscountType = "None"; // "None", "Percentage", "FixedAmount"
    private decimal _settleDiscountValue = 0;
    private decimal _settleDiscountAmount = 0;
    private decimal _totalRequired = 0;
    private decimal _settlePayment = 0;
    private PaymentMode _settlePaymentMethod = PaymentMode.ImmediateCash;
    private int _openRentalActualDays = 1;
    private decimal _openRentalAccruedRent = 0;
    private int _billedDays = 1;
    private int _originalAgreedDays = 1;
    private int _elapsedDays = 1;
    private bool _isEarlyReturn = false;
    private decimal _customerRefundAmount = 0;
    private string _refundAction = "CashRefund"; // "CashRefund" or "CreditBalance"
    private string? _settleNotes;
    private string? _closeError;

    private bool _isOverdue = false;
    private int _overdueDays = 0;
    private decimal _suggestedLateFee = 0;
    private CompanyProfile? _companyProfile;

    [SupplyParameterFromQuery] public Guid? CloseId { get; set; }
    private List<Contract>? _allContractsForKpi;

    private int TotalCount => _allContractsForKpi?.Count ?? _contracts?.Count ?? 0;
    private int ActiveCount => _allContractsForKpi?.Count(c => c.Status == ContractStatus.Active) ?? _contracts?.Count(c => c.Status == ContractStatus.Active) ?? 0;
    private int ClosedCount => _allContractsForKpi?.Count(c => c.Status == ContractStatus.Closed) ?? _contracts?.Count(c => c.Status == ContractStatus.Closed) ?? 0;
    private int CancelledCount => _allContractsForKpi?.Count(c => c.Status == ContractStatus.Cancelled) ?? _contracts?.Count(c => c.Status == ContractStatus.Cancelled) ?? 0;
    private int OverdueOrDueTodayCount => (_allContractsForKpi ?? _contracts)?.Count(c => c.Status == ContractStatus.Active && !c.IsOpenEnded && (c.ExpectedReturnDateTime <= DateTime.Now || c.ExpectedReturnDateTime.Date == DateTime.Today)) ?? 0;
    private decimal ActiveTotalAgreedAmount => (_allContractsForKpi ?? _contracts)?.Where(c => c.Status == ContractStatus.Active).Sum(c => c.TotalAgreedAmount) ?? 0;
    private decimal ActiveRemainingDebtAmount => (_allContractsForKpi ?? _contracts)?.Where(c => c.Status == ContractStatus.Active).Sum(c => c.RemainingAmount) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        RentalService.OnContractsDataChanged += HandleContractsDataChanged;
        _companyProfile = await RentalService.GetCompanyProfileAsync();
        await LoadContracts();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (CloseId.HasValue && _contracts != null)
        {
            var target = _contracts.FirstOrDefault(c => c.Id == CloseId.Value);
            if (target != null && target.Status == ContractStatus.Active)
            {
                var idToClose = CloseId.Value;
                CloseId = null;
                OpenCloseModal(target);
            }
        }
    }

    private async void HandleContractsDataChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadContracts();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        RentalService.OnContractsDataChanged -= HandleContractsDataChanged;
    }

    private async Task LoadContracts()
    {
        _contracts = await RentalService.GetContractsAsync(_statusFilter);
        _allContractsForKpi = await RentalService.GetContractsAsync(null);

        if (CloseId.HasValue && _contracts != null)
        {
            var target = _contracts.FirstOrDefault(c => c.Id == CloseId.Value);
            if (target != null && target.Status == ContractStatus.Active)
            {
                CloseId = null;
                OpenCloseModal(target);
            }
        }
    }

    private async Task SetFilter(ContractStatus? status)
    {
        _statusFilter = status;
        await LoadContracts();
    }

    private void SendWhatsApp(Contract c)
    {
        try
        {
            var phone = c.Customer?.PrimaryPhone;
            if (string.IsNullOrEmpty(phone)) return;

            var diff = c.ExpectedReturnDateTime - DateTime.Now;
            string timeStatus = diff.TotalSeconds > 0
                ? $"متبقي على موعد التسليم {((int)diff.TotalHours)} ساعة و {diff.Minutes} دقيقة (بتاريخ {c.ExpectedReturnDateTime:yyyy/MM/dd hh:mm tt})."
                : $"نود إعلامكم بأن موعد التسليم الرسمي قد انقضى منذ {Math.Abs((int)diff.TotalHours)} ساعة. يرجى مراجعة المكتب فوراً.";

            var msg = $"✦ *شركة التـاج لتأجيـر السيـارات* (TAJ SYSTEM) ✦\n" +
                      $"━━━━━━━━━━━━━━━━━━━━━\n" +
                      $"مرحباً بك أخي الكريم: *{c.Customer?.FullName}*\n" +
                      $"نود تذكيركم بموعد عقد تأجير المركبة: *{c.Vehicle?.Brand} {c.Vehicle?.Model}* (لوحة: *{c.Vehicle?.PlateNumber}*)\n" +
                      $"رقم العقد: *{c.ContractNumber}*\n\n" +
                      $"▪ {timeStatus}\n" +
                      $"━━━━━━━━━━━━━━━━━━━━━\n" +
                      $"☎ *خدمة العملاء:* 0566655550 | 0566009003";

            WhatsAppHelper.OpenWhatsApp(phone, "970", msg);
        }
        catch { }
    }

    private void PrintDocument(Contract c, bool isContract)
    {
        _contractToPrint = c;
        _isContractTab = isContract;
    }

    private async Task OnContractExtended()
    {
        _contractToExtend = null;
        await LoadContracts();
    }

    private void StartReturnFlow(Contract c)
    {
        OpenCloseModal(c);
    }

    private void OpenInspectionModal(Contract c)
    {
        _contractForReturn = null;
        _inspectionInitialType = c.Status == ContractStatus.Active ? InspectionType.ReturnIn : InspectionType.HandoverOut;
        _contractToInspect = c;
    }

    private void InspectContractOnReturn(Contract c)
    {
        _contractForReturn = c;
        _inspectionInitialType = InspectionType.ReturnIn;
        _contractToInspect = c;
    }

    private async Task OnInspectionSaved()
    {
        var returnTarget = _contractForReturn;
        _contractToInspect = null;
        _contractForReturn = null;
        await LoadContracts();

        if (returnTarget != null)
        {
            var updated = await RentalService.GetContractByIdAsync(returnTarget.Id);
            OpenCloseModal(updated ?? returnTarget);
        }
    }

    private void OnInspectionClosed()
    {
        var returnTarget = _contractForReturn;
        _contractToInspect = null;
        _contractForReturn = null;

        if (returnTarget != null && _contractToClose == null)
        {
            OpenCloseModal(returnTarget);
        }
    }

    private void OpenPayContractModal(Contract c)
    {
        _contractToPay = c;
        _contractPaymentAmount = c.IsOpenEnded && c.Status == ContractStatus.Active 
            ? c.OpenRentalCurrentDue 
            : c.RemainingAmount;
        _contractPaymentMode = PaymentMode.ImmediateCash;
        _contractPaymentNotes = "";
        _contractPaymentError = null;
        _isSubmittingContractPayment = false;
    }

    private async Task ConfirmContractPayment()
    {
        if (_contractToPay == null) return;
        if (_contractPaymentAmount <= 0)
        {
            _contractPaymentError = "يرجى إدخال مبلغ صحيح أكبر من الصفر!";
            return;
        }

        try
        {
            _isSubmittingContractPayment = true;
            _contractPaymentError = null;
            var staff = !string.IsNullOrWhiteSpace(AuthState.CurrentUser.Username)
                ? AuthState.CurrentUser.Username
                : (!string.IsNullOrWhiteSpace(AuthState.CurrentUser.FullName) ? AuthState.CurrentUser.FullName : "admin");

            var tx = await RentalService.RecordContractPaymentAsync(
                _contractToPay.Id,
                _contractPaymentAmount,
                _contractPaymentMode,
                _contractPaymentNotes,
                staff);

            _contractToPay = null;
            _isSubmittingContractPayment = false;
            await LoadContracts();
            _voucherToPrint = tx;
        }
        catch (Exception ex)
        {
            _contractPaymentError = ex.InnerException?.Message ?? ex.Message;
            _isSubmittingContractPayment = false;
        }
    }

    private void OpenCloseModal(Contract c)
    {
        _contractToClose = c;
        _closeError = null;
        _settlePaymentMethod = PaymentMode.ImmediateCash;
        _settleDiscountType = "None";
        _settleDiscountValue = 0;
        _settleDiscountAmount = 0;
        _customerRefundAmount = 0;
        _refundAction = "CashRefund";

        var returnInsp = c.Inspections?.FirstOrDefault(i => i.Type == InspectionType.ReturnIn);
        if (returnInsp != null)
        {
            _endOdometer = returnInsp.Odometer > 0 ? returnInsp.Odometer : (c.Vehicle?.CurrentOdometer ?? c.StartOdometer);
            _endFuel = returnInsp.FuelLevel;
            if (!string.IsNullOrWhiteSpace(returnInsp.DamageNotes) || !string.IsNullOrWhiteSpace(returnInsp.ScratchesDescription))
            {
                _settleNotes = returnInsp.DamageNotes ?? returnInsp.ScratchesDescription;
            }

            var newDamagesCount = returnInsp.GetDamageMarks().Count(m => m.InspectionPhase == "ReturnIn" && !m.IsRepaired);
            if (newDamagesCount > 0 && _damageFee == 0)
            {
                _damageFee = newDamagesCount * 150;
            }
        }
        else
        {
            _endOdometer = (c.Vehicle?.CurrentOdometer ?? c.StartOdometer);
            _endFuel = c.FuelLevelStart;
            _damageFee = 0;
            _settleNotes = null;
        }

        _extraKmFee = 0;

        if (c.IsOpenEnded)
        {
            _isOverdue = false;
            _overdueDays = 0;
            _suggestedLateFee = 0;
            _lateFee = 0;
            _isEarlyReturn = false;
            _originalAgreedDays = 0;
            _elapsedDays = Math.Max(1, (int)Math.Ceiling((DateTime.Now - c.StartDateTime).TotalDays));
            _openRentalActualDays = _elapsedDays;
            _billedDays = _openRentalActualDays;
            _openRentalAccruedRent = _openRentalActualDays * c.DailyAgreedRate;
        }
        else
        {
            _openRentalActualDays = 0;
            _openRentalAccruedRent = 0;
            _originalAgreedDays = c.RentalDays;
            _elapsedDays = Math.Max(1, (int)Math.Ceiling((DateTime.Now - c.StartDateTime).TotalDays));

            var now = DateTime.Now;
            if (now > c.ExpectedReturnDateTime)
            {
                _isOverdue = true;
                _isEarlyReturn = false;
                _overdueDays = Math.Max(1, (int)Math.Ceiling((now - c.ExpectedReturnDateTime).TotalDays));
                _suggestedLateFee = _overdueDays * c.DailyAgreedRate;
                _lateFee = _suggestedLateFee;
                _billedDays = _originalAgreedDays;
            }
            else
            {
                _isOverdue = false;
                _overdueDays = 0;
                _suggestedLateFee = 0;
                _lateFee = 0;

                // فحص إذا كان استلام مبكر
                if (_elapsedDays < _originalAgreedDays)
                {
                    _isEarlyReturn = true;
                    _billedDays = _elapsedDays; // اقتراح المدة الفعلية المنقضية
                }
                else
                {
                    _isEarlyReturn = false;
                    _billedDays = _originalAgreedDays;
                }
            }
        }

        OnOdometerOrFuelChanged();
    }

    private void IncrementBilledDays()
    {
        _billedDays++;
        OnBilledDaysChanged();
    }

    private void DecrementBilledDays()
    {
        if (_billedDays > 1)
        {
            _billedDays--;
            OnBilledDaysChanged();
        }
    }

    private void SetBilledDays(int days)
    {
        _billedDays = Math.Max(1, days);
        OnBilledDaysChanged();
    }

    private void OnBilledDaysChanged()
    {
        if (_billedDays < 1) _billedDays = 1;
        OnOdometerOrFuelChanged();
    }

    private void SetSettleDiscountType(string type)
    {
        _settleDiscountType = type;
        if (_settleDiscountType == "None")
        {
            _settleDiscountValue = 0;
            _settleDiscountAmount = 0;
        }
        else if (_settleDiscountValue == 0)
        {
            _settleDiscountValue = _settleDiscountType == "Percentage" ? 10 : 50;
        }
        UpdateTotalRequired();
    }

    private void SetSettleDiscountPreset(decimal value)
    {
        _settleDiscountValue = value;
        UpdateTotalRequired();
    }

    private void OnOdometerOrFuelChanged()
    {
        if (_contractToClose == null) return;

        // حساب فرق الوقود التلقائي المقترح إن نقص
        if (_endFuel < _contractToClose.FuelLevelStart)
        {
            var diff = (int)_contractToClose.FuelLevelStart - (int)_endFuel;
            _fuelFee = diff * 40; // 40 ₪ لكل ربع خزان
        }
        else
        {
            _fuelFee = 0;
        }

        // حساب الكيلومترات الزائدة التلقائي المقترح وفق سياسة وإعدادات الشركة
        var dailyLimit = _companyProfile?.DailyKmLimit > 0 ? _companyProfile.DailyKmLimit : 250;
        var kmPrice = _companyProfile?.ExtraKmPrice > 0 ? _companyProfile.ExtraKmPrice : 1m;
        var totalKm = Math.Max(0, _endOdometer - _contractToClose.StartOdometer);
        var effectiveRentalDays = _contractToClose.IsOpenEnded ? _openRentalActualDays : _billedDays;
        var allowedKm = effectiveRentalDays * dailyLimit;
        if (totalKm > allowedKm)
        {
            _extraKmFee = (totalKm - allowedKm) * kmPrice;
        }
        else
        {
            _extraKmFee = 0;
        }

        UpdateTotalRequired();
    }

    private void UpdateTotalRequired()
    {
        if (_contractToClose == null) return;

        decimal baseRentalRent;
        if (_contractToClose.IsOpenEnded)
        {
            baseRentalRent = _openRentalActualDays * _contractToClose.DailyAgreedRate;
            _openRentalAccruedRent = baseRentalRent;
        }
        else if (_isEarlyReturn || _billedDays != _originalAgreedDays)
        {
            baseRentalRent = _billedDays * _contractToClose.DailyAgreedRate;
        }
        else
        {
            baseRentalRent = _originalAgreedDays * _contractToClose.DailyAgreedRate;
        }

        var totalExtraFees = _lateFee + _fuelFee + _extraKmFee + _damageFee;
        var grossTotal = baseRentalRent + totalExtraFees;

        if (_settleDiscountType == "Percentage")
        {
            if (_settleDiscountValue > 100) _settleDiscountValue = 100;
            _settleDiscountAmount = Math.Round((grossTotal * _settleDiscountValue) / 100m, 2);
        }
        else if (_settleDiscountType == "FixedAmount")
        {
            if (_settleDiscountValue > grossTotal) _settleDiscountValue = grossTotal;
            _settleDiscountAmount = _settleDiscountValue;
        }
        else
        {
            _settleDiscountAmount = 0;
            _settleDiscountValue = 0;
        }

        var netTotalContractCost = Math.Max(0, grossTotal - _settleDiscountAmount);

        // مقارنة المطلوب الصافي مع ما دفعه الزبون مسبقاً
        var alreadyPaid = _contractToClose.PaidAmount;

        if (alreadyPaid > netTotalContractCost)
        {
            // الزبون دفع مقدماً أكثر من تكلفة الأيام المسحوبة (استرداد فرق تسليم مبكر أو خصم)
            _customerRefundAmount = alreadyPaid - netTotalContractCost;
            _totalRequired = 0;
            _settlePayment = 0;
        }
        else
        {
            _customerRefundAmount = 0;
            _totalRequired = netTotalContractCost - alreadyPaid;
            _settlePayment = _totalRequired;
        }
    }

    private async Task ConfirmCloseContract()
    {
        if (_contractToClose != null)
        {
            _closeError = null;
            if (_endOdometer < _contractToClose.StartOdometer)
            {
                _closeError = $"قراءة العداد عند الإرجاع ({_endOdometer:N0} كم) لا يمكن أن تكون أقل من قراءة بداية العقد ({_contractToClose.StartOdometer:N0} كم)!";
                return;
            }

            try
            {
                var staffIdentifier = !string.IsNullOrWhiteSpace(AuthState.CurrentUser.Username) 
                    ? AuthState.CurrentUser.Username 
                    : AuthState.CurrentUser.FullName;

                var finalNotes = _settleNotes;
                if (_isEarlyReturn || (_billedDays != _originalAgreedDays && !_contractToClose.IsOpenEnded))
                {
                    var earlyNote = $"[تسليم مبكر: تم احتساب {_billedDays} يوم من أصل {_originalAgreedDays} يوم]";
                    finalNotes = string.IsNullOrWhiteSpace(finalNotes) ? earlyNote : $"{earlyNote} - {finalNotes}";
                }
                if (_settleDiscountAmount > 0)
                {
                    var discLabel = _settleDiscountType == "Percentage" ? $"{_settleDiscountValue}%" : $"{_settleDiscountAmount:N0} ₪";
                    var discNote = $"[خصم تسوية: {discLabel} (-{_settleDiscountAmount:N0} ₪)]";
                    finalNotes = string.IsNullOrWhiteSpace(finalNotes) ? discNote : $"{finalNotes} - {discNote}";
                }

                bool refundFromDrawer = (_customerRefundAmount > 0 && _refundAction == "CashRefund");

                await RentalService.CloseContractWithSettlementAsync(
                    _contractToClose.Id, 
                    _endOdometer, 
                    _endFuel, 
                    _lateFee, 
                    _fuelFee, 
                    _extraKmFee, 
                    _damageFee, 
                    _settlePayment, 
                    finalNotes, 
                    staffIdentifier,
                    _settlePaymentMethod,
                    _settleDiscountAmount,
                    _billedDays,
                    _customerRefundAmount,
                    refundFromDrawer);

                var closedId = _contractToClose.Id;
                _contractToClose = null;
                await LoadContracts();

                // إتاحة طباعة إيصال السند
                if (_settlePayment > 0)
                {
                    var trans = await RentalService.GetTransactionsAsync();
                    _voucherToPrint = trans.FirstOrDefault(t => t.ContractId == closedId && t.Type == TransactionType.Receipt);
                }
            }
            catch (Exception ex)
            {
                _closeError = ex.InnerException?.Message ?? ex.Message;
            }
        }
    }

    private void PromptCancelContract(Contract c)
    {
        _contractToCancel = c;
        _cancellationReason = "بناءً على طلب ورغبة العميل (فسخ العملية)";
        _cancelError = null;
    }

    private async Task ConfirmCancelContract()
    {
        if (_contractToCancel == null) return;
        _isCancelling = true;
        _cancelError = null;

        try
        {
            var staffIdentifier = !string.IsNullOrWhiteSpace(AuthState.CurrentUser.Username) 
                ? AuthState.CurrentUser.Username 
                : AuthState.CurrentUser.FullName;

            await RentalService.CancelContractAsync(_contractToCancel.Id, staffIdentifier, _cancellationReason);
            _contractToCancel = null;
            await LoadContracts();
        }
        catch (Exception ex)
        {
            _cancelError = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            _isCancelling = false;
        }
    }

    private void ExportContractsToExcel()
    {
        var headers = new[]
        {
            "رقم العقد", "حالة العقد", "اسم المستأجر", "رقم الهوية", "رقم الهاتف",
            "السائق الإضافي", "المركبة", "رقم اللوحة", "تاريخ البدء", "تاريخ الإرجاع المتوقع",
            "الأجرة اليومية", "إجمالي المبلغ", "المدفوع مقدماً", "المتبقي (ذمم)", "مبلغ الكمبيالة", "الموظف المنفذ"
        };

        var rows = FilteredContracts.Select(c => new object?[]
        {
            c.ContractNumber,
            c.Status switch {
                ContractStatus.Active => "نشط",
                ContractStatus.Closed => "مغلق ومستلم",
                ContractStatus.Cancelled => "ملغي",
                _ => c.Status.ToString()
            },
            c.Customer?.FullName ?? "",
            c.Customer?.NationalIdOrPassport ?? "",
            c.Customer?.PrimaryPhone ?? "",
            c.AdditionalDriverName ?? "لا يوجد",
            $"{c.Vehicle?.Brand} {c.Vehicle?.Model}",
            c.Vehicle?.PlateNumber ?? "",
            c.StartDateTime.ToString("yyyy/MM/dd HH:mm"),
            c.ExpectedReturnDateTime.ToString("yyyy/MM/dd HH:mm"),
            c.DailyAgreedRate,
            c.TotalAgreedAmount,
            c.PaidAmount,
            c.RemainingAmount,
            c.PromissoryNoteAmount,
            c.CreatedByStaffName
        });

        ExportHelper.ExportToCsv($"Contracts_Report_{DateTime.Now:yyyyMMdd_HHmm}.csv", headers, rows);
    }
}

