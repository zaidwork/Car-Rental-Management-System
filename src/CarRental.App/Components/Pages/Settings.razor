@page "/settings"
@inject IRentalSystemService RentalService
@inject IAuthStateService AuthState
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@using Microsoft.EntityFrameworkCore
@using CarRental.Infrastructure.Data
@using CarRental.Infrastructure.Services
@inject IDbContextFactory<CarRentalDbContext> DbFactory
@implements IDisposable

@if (!AuthState.IsAdmin)
{
    <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 60vh; text-align: center; padding: 20px;">
        <div style="background: #ffffff; border: 2px solid var(--border-color); border-radius: 20px; padding: 40px 32px; max-width: 520px; box-shadow: 0 10px 30px rgba(90, 70, 40, 0.08); display: flex; flex-direction: column; align-items: center; gap: 16px;">
            <div style="width: 72px; height: 72px; border-radius: 50%; background: #fee2e2; border: 2px solid #fca5a5; display: flex; align-items: center; justify-content: center; font-size: 2.2rem;">
                👑
            </div>
            <h2 style="font-size: 1.3rem; font-weight: 800; color: #991b1b; margin: 0;">
                صلاحية محصورة بمدير النظام فقط
            </h2>
            <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; margin: 0;">
                لوحة إدارة المستخدمين، تعديل رموز الـ PIN، والنسخ الاحتياطي محصورة حصراً بـ <strong>المدير العام (Admin)</strong>.<br />
                لتسجيل الدخول كمدير، يرجى تسجيل الخروج وإدخال رمز مرور الآدمن.
            </p>
            <div style="display: flex; gap: 12px; margin-top: 8px;">
                <button class="btn-primary-action" @onclick='() => Navigation.NavigateTo("")'>
                    <span>العودة للرئيسية</span>
                </button>
                <button class="filter-pill" @onclick="LogoutWithSoundAsync">
                    <span>تسجيل الخروج والتبديل</span>
                </button>
            </div>
        </div>
    </div>
}
else
{
<div style="display: flex; flex-direction: column; gap: 20px;">
    <!-- Top Bar -->
    <div class="action-bar-strip">
        <div class="action-bar-left">
            <h2 style="font-size: 1.25rem; font-weight: 800; color: var(--text-main);">لوحة تحكم النظام وإدارة المستخدمين والنسخ الاحتياطي</h2>
            <span style="font-size: 0.86rem; color: var(--text-muted);">
                إدارة المستخدمين والصلاحيات وهوية المكتب والنسخ الاحتياطي
            </span>
        </div>

        <div class="action-filter-pills">
            <button class="filter-pill @(_activeTab == "users" ? "active" : "")" @onclick='() => _activeTab = "users"'>
                👥 إدارة المستخدمين ورموز المرور (PIN)
            </button>
            <button class="filter-pill @(_activeTab == "company" ? "active" : "")" @onclick='() => _activeTab = "company"'>
                🏢 بيانات وهوية المكتب (الشعار والشروط)
            </button>
            <button class="filter-pill @(_activeTab == "system" ? "active" : "")" @onclick='() => _activeTab = "system"'>
                ⚙️ إعدادات النسخ الاحتياطي والصلاحيات
            </button>
            <button class="filter-pill @(_activeTab == "audit" ? "active" : "")" @onclick='() => _activeTab = "audit"'>
                🛡️ سجل التدقيق الأمني (@(_auditLogs?.Count ?? 0))
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div style="background: var(--accent-green-bg); color: var(--accent-green); border: 1.5px solid var(--accent-green-border); padding: 10px 16px; border-radius: 8px; font-size: 0.88rem; font-weight: 700; display: flex; justify-content: space-between; align-items: center;">
            <span>@_statusMessage</span>
            <button style="background: none; border: none; font-weight: bold; cursor: pointer; color: var(--accent-green);" @onclick="() => _statusMessage = null">✕</button>
        </div>
    }

    <!-- TAB 1: USERS & PIN MANAGEMENT -->
    @if (_activeTab == "users")
    {
        <div class="data-table-container">
            <div style="padding: 14px 18px; border-bottom: 1.5px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; background: #ede6d8;">
                <div style="display: flex; flex-direction: column; gap: 2px;">
                    <span style="color: var(--text-main); font-weight: 800; font-size: 1.05rem;">
                        المستخدمين المسجلين في النظام ورموز الدخول (4 أرقام)
                    </span>
                    <span style="font-size: 0.8rem; color: var(--text-muted);">
                        يمكنك تعديل أسماء الموظفين ورموز الدخول وأرقام هواتفهم وإضافة مستخدمين جدد بكل سهولة
                    </span>
                </div>

                @if (AuthState.IsAdmin)
                {
                    <button class="btn-primary-action" @onclick="OpenAddUserModal">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        <span>إضافة مستخدم جديد</span>
                    </button>
                }
            </div>

            <table class="data-table">
                <thead>
                    <tr>
                        <th>المستخدم / الموظف</th>
                        <th>اسم الدخول (Username)</th>
                        <th>الصلاحية / الدور</th>
                        <th>رمز الدخول (PIN - 4 أرقام)</th>
                        <th>رقم الجوال</th>
                        <th>تاريخ الإنشاء / آخر دخول</th>
                        <th>الحالة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_users != null && _users.Any())
                    {
                        @foreach (var user in _users)
                        {
                            <tr>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <div style="width: 36px; height: 36px; border-radius: 50%; background: #e0f2fe; border: 1.5px solid #bae6fd; display: flex; align-items: center; justify-content: center; font-size: 1.1rem;">
                                            @(user.Role switch {
                                                UserRole.Admin => "👑",
                                                UserRole.Staff => "🧑‍💼",
                                                UserRole.Accountant => "📊",
                                                _ => "👤"
                                            })
                                        </div>
                                        <div>
                                            <div style="font-weight: 800; color: var(--text-main); font-size: 0.95rem;">@user.FullName</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <code style="background: #f1ebd8; border: 1px solid var(--border-color); padding: 3px 8px; border-radius: 6px; font-weight: bold; color: var(--primary-blue);">
                                        @user.Username
                                    </code>
                                </td>
                                <td>
                                    <span style="font-size: 0.78rem; font-weight: 700; padding: 4px 10px; border-radius: 6px; @(user.Role == UserRole.Admin ? "background: #fef3c7; color: #92400e; border: 1px solid #fcd34d;" : user.Role == UserRole.Staff ? "background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd;" : "background: #d1fae5; color: #065f46; border: 1px solid #6ee7b7;")">
                                        @(user.Role switch {
                                            UserRole.Admin => "المدير العام",
                                            UserRole.Staff => "موظف استقبال",
                                            UserRole.Accountant => "المحاسب المالي",
                                            _ => user.Role.ToString()
                                        })
                                    </span>
                                </td>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 6px;">
                                        <span style="font-family: monospace; font-size: 1.05rem; font-weight: 800; background: #faf7f2; border: 1.5px solid var(--accent-gold); color: var(--text-gold); padding: 3px 12px; border-radius: 8px; letter-spacing: 2px;">
                                            @(_showPins ? user.PasswordHash : "••••")
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <span style="font-size: 0.88rem; color: var(--text-dark);">
                                        @(string.IsNullOrWhiteSpace(user.PhoneNumber) ? "-" : user.PhoneNumber)
                                    </span>
                                </td>
                                <td>
                                    <div style="font-size: 0.8rem; color: var(--text-muted);">
                                        <div>دخول: @(user.LastLoginAt.HasValue ? user.LastLoginAt.Value.ToString("yyyy/MM/dd HH:mm") : "لم يسجل بعد")</div>
                                    </div>
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span style="background: var(--accent-green-bg); color: var(--accent-green); border: 1px solid var(--accent-green-border); font-size: 0.76rem; font-weight: bold; padding: 3px 8px; border-radius: 6px;">نشط</span>
                                    }
                                    else
                                    {
                                        <span style="background: var(--accent-red-bg); color: var(--accent-red); border: 1px solid var(--accent-red-border); font-size: 0.76rem; font-weight: bold; padding: 3px 8px; border-radius: 6px;">معطل</span>
                                    }
                                </td>
                                <td>
                                    <div style="display: flex; gap: 8px; align-items: center;">
                                        @if (AuthState.IsAdmin)
                                        {
                                            <button class="filter-pill" style="padding: 4px 10px; font-size: 0.8rem; background: #e0f2fe; color: var(--primary-blue); border-color: #bae6fd;" @onclick="() => OpenEditUserModal(user)">
                                                ✏️ تعديل ورمز PIN
                                            </button>

                                            @if (user.Role != UserRole.Admin)
                                            {
                                                <button class="filter-pill" style="padding: 4px 8px; font-size: 0.8rem; background: #fee2e2; color: var(--accent-red); border-color: var(--accent-red-border);" @onclick="() => DeleteUser(user)">
                                                    🗑️
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <span style="font-size: 0.75rem; color: var(--text-muted);">صلاحية الآدمن فقط</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" style="text-align: center; padding: 40px; color: var(--text-muted);">
                                جاري تحميل بيانات المستخدمين...
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div style="padding: 12px 18px; background: #faf7f2; border-top: 1.5px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
                <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 0.84rem; font-weight: 700; color: var(--text-main);">
                    <input type="checkbox" @bind="_showPins" />
                    <span>إظهار رموز المرور (PIN) لجميع المستخدمين</span>
                </label>
                <span style="font-size: 0.8rem; color: var(--text-muted);">
                    🔒 يُشترط أن يكون رمز الـ PIN (4 أرقام) فريداً وخاصاً بكل حساب لضمان الدخول المباشر
                </span>
            </div>
        </div>
    }

    <!-- TAB: COMPANY PROFILE & BRANDING -->
    @if (_activeTab == "company")
    {
        <div class="widget-card" style="padding: 24px;">
            <div class="widget-header">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <span style="font-size: 1.5rem;">🏢</span>
                    <div>
                        <h3 class="widget-title">بيانات وهوية المكتب (ترويسة العقود والسندات الرسمية)</h3>
                        <div style="font-size: 0.8rem; color: var(--text-muted);">
                            تظهر هذه البيانات وشعار المكتب تلقائياً في ترويسة عقود الإيجار، السندات المالية المطبوعة، وكشوف الحسابات
                        </div>
                    </div>
                </div>
                <button class="btn-primary-action" @onclick="SaveCompanyProfile" disabled="@_isSavingCompany">
                    @(_isSavingCompany ? "جاري الحفظ..." : "حفظ بيانات المكتب والشروط")
                </button>
            </div>

            @if (_companyProfile != null)
            {
                <div style="display: flex; flex-direction: column; gap: 18px; margin-top: 15px;">
                    <div class="form-grid-2">
                        <div class="form-group">
                            <label class="form-label">اسم المكتب / الشركة بالعربية *:</label>
                            <input type="text" class="form-control" @bind="_companyProfile.CompanyName" placeholder="مثال: شركة النجم لتأجير السيارات" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">الاسم بالإنجليزية (Commercial Name):</label>
                            <input type="text" class="form-control" @bind="_companyProfile.CompanyEnglishName" placeholder="Star Car Rental" />
                        </div>
                    </div>

                    <div class="form-grid-3">
                        <div class="form-group">
                            <label class="form-label">رقم السجل التجاري / الترخيص:</label>
                            <input type="text" class="form-control" @bind="_companyProfile.CommercialRegisterNumber" placeholder="CR-xxxxxxx" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">رقم الهاتف / الجوال الأساسي *:</label>
                            <input type="text" class="form-control" @bind="_companyProfile.PrimaryPhone" placeholder="05xxxxxxxx" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">رقم هاتف إضافي / واتساب:</label>
                            <input type="text" class="form-control" @bind="_companyProfile.SecondaryPhone" placeholder="05xxxxxxxx" />
                        </div>
                    </div>

                    <div class="form-grid-2">
                        <div class="form-group">
                            <label class="form-label">العنوان والموقع (المدينة - الشارع):</label>
                            <input type="text" class="form-control" @bind="_companyProfile.Address" placeholder="المدينة، الشارع الرئيسي..." />
                        </div>
                        <div class="form-group">
                            <label class="form-label">البريد الإلكتروني / الموقع:</label>
                            <input type="text" class="form-control" @bind="_companyProfile.Email" placeholder="info@rental.com" />
                        </div>
                    </div>

                    <div class="form-grid-3">
                        <div class="form-group">
                            <label class="form-label">شعار المكتب (Logo):</label>
                            <InputFile OnChange="HandleLogoUpload" accept="image/*" class="form-control" />
                            @if (!string.IsNullOrEmpty(_companyProfile.LogoBase64))
                            {
                                <div style="margin-top: 8px; display: flex; align-items: center; gap: 12px; background: #fff; padding: 6px 12px; border-radius: 6px; border: 1px solid var(--border-color); width: fit-content;">
                                    <img src="@_companyProfile.LogoBase64" style="height: 50px; object-fit: contain;" />
                                    <button type="button" class="icon-btn-subtle" style="color: var(--accent-red);" @onclick="() => _companyProfile.LogoBase64 = null">حذف</button>
                                </div>
                            }
                        </div>
                        <div class="form-group">
                            <label class="form-label">حد الكيلومترات اليومي (كم):</label>
                            <input type="number" class="form-control" @bind="_companyProfile.DailyKmLimit" min="0" placeholder="250" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">غرامة التأخير لكل ساعة (₪):</label>
                            <input type="number" class="form-control" @bind="_companyProfile.LateHourFee" min="0" placeholder="20" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">شروط وأحكام عقد الإيجار (تطبع خلف أو أسفل العقد الرسمي):</label>
                        <textarea class="form-control" rows="4" @bind="_companyProfile.DefaultContractTerms" placeholder="شروط التأجير، بنود الالتزام، شروط إعادة المركبة..."></textarea>
                    </div>

                    <div class="form-group">
                        <label class="form-label">صيغة إقرار وشروط كمبيالة الضمان (السند لأمر):</label>
                        <textarea class="form-control" rows="3" @bind="_companyProfile.PromissoryNoteTerms" placeholder="صيغة الالتزام بالسداد غير المشروط..."></textarea>
                    </div>
                </div>
            }
        </div>
    }

    <!-- TAB 2: SYSTEM SETTINGS & BACKUP -->
    @if (_activeTab == "system")
    {
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <!-- Local Backup Card -->
            <div class="widget-card">
                <div class="widget-header">
                    <span class="widget-title">النسخ الاحتياطي لبيانات النظام</span>
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--primary-blue)" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                </div>

                <p style="font-size: 0.86rem; color: var(--text-muted); line-height: 1.5; margin: 0;">
                    يمكنك أخذ نسخة احتياطية فورية وحفظها في أي مكان تختاره على جهازك أو على فلاشة USB خارجية بضغطة زر واحدة لحماية بيانات العقود والسيارات والعملاء.
                </p>

                <!-- Action Button: User picks location directly -->
                <div style="display: flex; flex-direction: column; gap: 10px; margin-top: 8px;">
                    <button class="btn-primary-action" style="padding: 12px 18px; font-size: 0.95rem; font-weight: 800; justify-content: center; gap: 10px; background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);" @onclick="ChooseLocationAndBackup" disabled="@_isBackingUp">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                            <polyline points="17 21 17 13 7 13 7 21"></polyline>
                            <polyline points="7 3 7 8 15 8"></polyline>
                        </svg>
                        @if (_isBackingUp)
                        {
                            <span>جاري إنشاء وحفظ النسخة الاحتياطية...</span>
                        }
                        else
                        {
                            <span>💾 اختيار مكان الحفظ وتنزيل النسخة الاحتياطية</span>
                        }
                    </button>

                    <!-- Quick 1-Click shortcuts -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                        <button type="button" class="filter-pill" style="justify-content: center; padding: 10px; font-weight: 700; gap: 6px;" @onclick="BackupToDesktop" disabled="@_isBackingUp" title="حفظ فوري على سطح المكتب">
                            <span>🖥️</span>
                            <span>حفظ على سطح المكتب</span>
                        </button>
                        <button type="button" class="filter-pill" style="justify-content: center; padding: 10px; font-weight: 700; gap: 6px;" @onclick="BackupToDocuments" disabled="@_isBackingUp" title="حفظ فوري في المستندات">
                            <span>📁</span>
                            <span>حفظ في المستندات</span>
                        </button>
                    </div>
                </div>

                <!-- Default Folder Display & Open folder in explorer -->
                <div style="background: #fdfbf7; border: 1.5px solid var(--border-color); border-radius: 12px; padding: 12px 14px; margin-top: 6px; display: flex; flex-direction: column; gap: 8px;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-size: 0.8rem; font-weight: 700; color: var(--text-dark);">مجلد الحفظ المعتمد:</span>
                        <div style="display: flex; gap: 6px;">
                            <button type="button" class="filter-pill" style="font-size: 0.76rem; padding: 4px 10px;" @onclick="BrowseBackupFolder" title="تغيير مجلد الحفظ الافتراضي">
                                <span>📂 تغيير المجلد...</span>
                            </button>
                            <button type="button" class="filter-pill" style="font-size: 0.76rem; padding: 4px 10px;" @onclick="OpenBackupFolderInExplorer" title="فتح المجلد في جهازك">
                                <span>🔍 فتح المجلد</span>
                            </button>
                        </div>
                    </div>
                    <div style="font-size: 0.78rem; color: var(--text-muted); direction: ltr; text-align: left; background: #fff; padding: 6px 10px; border-radius: 6px; border: 1px solid var(--border-subtle); overflow-x: auto; white-space: nowrap;">
                        @_backupFolder
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_backupSuccessMessage))
                {
                    <div style="background: var(--accent-green-bg); color: var(--accent-green); border: 1.5px solid var(--accent-green-border); padding: 10px 14px; border-radius: 10px; font-size: 0.86rem; font-weight: 700; display: flex; align-items: center; justify-content: space-between; margin-top: 6px;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span>✅</span>
                            <span>@_backupSuccessMessage</span>
                        </div>
                        <button type="button" class="filter-pill" style="font-size: 0.76rem; padding: 3px 8px; color: var(--accent-green); border-color: var(--accent-green);" @onclick="() => OpenFolderOfFile(_lastSavedBackupPath)">
                            عرض الملف
                        </button>
                    </div>
                }
            </div>

            <!-- System Security & Status Card -->
            <div class="widget-card">
                <div class="widget-header">
                    <span class="widget-title">حالة النظام والأمان</span>
                    <span style="font-size: 0.74rem; background: var(--accent-green-bg); color: var(--accent-green); border: 1px solid var(--accent-green-border); padding: 3px 10px; border-radius: 20px; font-weight: 800;">
                        🟢 النظام يعمل بكفاءة
                    </span>
                </div>

                <div style="font-size: 0.88rem; display: flex; flex-direction: column; gap: 12px; margin-top: 6px;">
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-subtle); padding-bottom: 8px;">
                        <span style="color: var(--text-muted);">المستخدم الحالي:</span>
                        <strong style="color: var(--text-main);">@AuthState.CurrentUser.FullName</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-subtle); padding-bottom: 8px;">
                        <span style="color: var(--text-muted);">مستوى الصلاحية:</span>
                        <strong style="color: var(--primary-blue);">
                            @(AuthState.CurrentUser.Role switch {
                                UserRole.Admin => "المدير العام (صلاحيات كاملة)",
                                UserRole.Staff => "موظف استقبال",
                                UserRole.Accountant => "المحاسب المالي",
                                _ => AuthState.CurrentUser.Role.ToString()
                            })
                        </strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-subtle); padding-bottom: 8px;">
                        <span style="color: var(--text-muted);">حالة التخزين والبيانات:</span>
                        <strong style="color: var(--accent-green); font-weight: 800;">آمن ومستقل محلياً</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-subtle); padding-bottom: 8px;">
                        <span style="color: var(--text-muted);">حماية الجلسات والدخول:</span>
                        <span style="color: var(--accent-gold); font-weight: bold;">رموز سرية مشفرة ومؤمّنة 🔒</span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: var(--text-muted);">جاهزية البيانات:</span>
                        <span style="color: var(--text-dark); font-weight: 700;">كافة السجلات والعقود محدثة وفورية</span>
                    </div>
                </div>
            </div>

            <!-- Restore Backup Card -->
            <div class="widget-card" style="grid-column: span 2;">
                <div class="widget-header">
                    <span class="widget-title">استرجاع نسخة احتياطية سابقة</span>
                    <span style="font-size: 0.78rem; background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; padding: 2px 10px; border-radius: 20px; font-weight: bold;">
                        استرجاع السجلات
                    </span>
                </div>

                <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.5;">
                    يمكنك استرجاع بيانات النظام من أي نسخة احتياطية محفوظة لديك سابقاً. سيتم الاحتفاظ بنسخة أمان تلقائية قبل تنفيذ عملية الاسترجاع.
                </p>

                <div style="display: flex; gap: 14px; align-items: center; margin-top: 10px; flex-wrap: wrap;">
                    <button type="button" class="btn-primary-action" style="padding: 10px 18px; font-weight: 700; gap: 8px; background: #442211;" @onclick="ChooseAndRestoreFile" disabled="@_isRestoring">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="17 8 12 3 7 8"></polyline>
                            <line x1="12" y1="3" x2="12" y2="15"></line>
                        </svg>
                        <span>📂 استعراض واختيار ملف النسخة من الحاسوب...</span>
                    </button>

                    <span style="font-size: 0.8rem; color: var(--text-muted);">أو اسحب وأفلت الملف هنا:</span>
                    <div style="flex: 1; min-width: 200px;">
                        <InputFile OnChange="HandleRestoreFileUpload" accept=".db" class="form-control" />
                    </div>
                </div>

                @if (_existingBackups != null && _existingBackups.Any())
                {
                    <div style="margin-top: 15px;">
                        <div style="font-size: 0.85rem; font-weight: 700; color: var(--text-main); margin-bottom: 8px;">
                            النسخ الاحتياطية المتوفرة في المجلد المعتمد:
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 6px; max-height: 180px; overflow-y: auto;">
                            @foreach (var bPath in _existingBackups)
                            {
                                var fi = new System.IO.FileInfo(bPath);
                                <div style="display: flex; justify-content: space-between; align-items: center; background: #fff; padding: 8px 12px; border-radius: 6px; border: 1px solid var(--border-color);">
                                    <div>
                                        <strong style="font-size: 0.86rem; color: var(--primary-blue);">@fi.Name</strong>
                                        <span style="font-size: 0.76rem; color: var(--text-muted); margin-right: 8px;">(@((fi.Length / 1024.0).ToString("N1")) KB - @fi.LastWriteTime.ToString("yyyy/MM/dd HH:mm"))</span>
                                    </div>
                                    <button class="filter-pill" style="color: #dc2626; border-color: #fca5a5;" @onclick="() => ConfirmRestoreFromFile(fi.FullName)" disabled="@_isRestoring">
                                        استرجاع هذه النسخة
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_restoreSuccessMessage))
                {
                    <div style="margin-top: 10px; background: var(--accent-green-bg); color: var(--accent-green); border: 1.5px solid var(--accent-green-border); padding: 8px 12px; border-radius: 6px; font-size: 0.85rem; font-weight: 700;">
                        @_restoreSuccessMessage
                    </div>
                }
                @if (!string.IsNullOrEmpty(_restoreErrorMessage))
                {
                    <div style="margin-top: 10px; background: #fee2e2; border: 1.5px solid #ef4444; color: #991b1b; padding: 8px 12px; border-radius: 6px; font-size: 0.85rem; font-weight: 700;">
                        @_restoreErrorMessage
                    </div>
                }
            </div>

            <!-- Operational Reset & Clean Slate Card (تهيئة وتصفير النظام) -->
            <div class="widget-card" style="grid-column: span 2; border: 2px solid #f87171; background: #fffcfc;">
                <div class="widget-header">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <div style="width: 36px; height: 36px; border-radius: 8px; background: #fee2e2; color: #dc2626; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                            🧹
                        </div>
                        <div>
                            <span class="widget-title" style="color: #991b1b; font-weight: 800;">تهيئة وتصفير السجلات التشغيلية للنظام (بدء دورة تشغيل جديدة)</span>
                            <div style="font-size: 0.78rem; color: #7f1d1d; margin-top: 2px;">
                                تنظيف العقود والحركات المالية والورديات مع الحفاظ الصارم والكامل على الموظفين، السيارات، والعملاء
                            </div>
                        </div>
                    </div>
                    <span style="font-size: 0.76rem; background: #fee2e2; color: #991b1b; border: 1.5px solid #f87171; padding: 3px 12px; border-radius: 20px; font-weight: 800;">
                        ⚠️ إجراء إداري حساس
                    </span>
                </div>

                <div style="font-size: 0.86rem; color: #4b5563; line-height: 1.6; margin-top: 4px;">
                    يقوم هذا الخيار بتنظيف وتصفير كافة السجلات والمعاملات التشغيلية الدورية بالكامل لبدء فترة عمل جديدة ونظيفة، مع الحفاظ المطلق على قواعد بيانات المؤسسة الأساسية:
                </div>

                <!-- Comparison Grid: Preserved vs Wiped -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 10px;">
                    <div style="background: #f0fdf4; border: 1.5px solid #86efac; border-radius: 10px; padding: 12px 14px;">
                        <div style="font-weight: 800; color: #166534; font-size: 0.88rem; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
                            <span>🛡️ المحفوظات المحمية 100% (لن تُمس نهائياً):</span>
                        </div>
                        <ul style="margin: 0; padding-right: 18px; font-size: 0.82rem; color: #15803d; line-height: 1.6;">
                            <li><strong>الموظفين والمستخدمين:</strong> كافة الحسابات والأسماء وكلمات السر والـ PINs والصلاحيات.</li>
                            <li><strong>أسطول السيارات:</strong> جميع المركبات، اللوحات، الألوان، الأسعار، والمواصفات (تتحول لحالة "متاحة").</li>
                            <li><strong>سجلات العملاء:</strong> كافة بيانات العملاء وأرقام الهويات والجوالات والصور (مع تصفير رصيد الديون).</li>
                            <li><strong>هوية وبيانات المكتب:</strong> اسم المكتب، السجل التجاري، الشعار، والشروط التعاقدية.</li>
                        </ul>
                    </div>

                    <div style="background: #fef2f2; border: 1.5px solid #fca5a5; border-radius: 10px; padding: 12px 14px;">
                        <div style="font-weight: 800; color: #991b1b; font-size: 0.88rem; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
                            <span>🗑️ السجلات التي سيتم مسحها وتصفيرها:</span>
                        </div>
                        <ul style="margin: 0; padding-right: 18px; font-size: 0.82rem; color: #b91c1c; line-height: 1.6;">
                            <li><strong>عقود التأجير:</strong> كافة العقود السابقة والنشطة والمنتهية.</li>
                            <li><strong>السندات والكمبيالات:</strong> كافة السندات لأمر وأرشيفها.</li>
                            <li><strong>الحركات المالية:</strong> جميع سندات القبض والصرف وحركات الصندوق.</li>
                            <li><strong>ورديات الصندوق:</strong> الورديات المغلقة والسابقة (تُفتح وردية جديدة نظيفة برصيد صفر).</li>
                            <li><strong>الفحوصات والصيانة:</strong> الفحوصات الفنية وسجلات الصيانة الدورية.</li>
                        </ul>
                    </div>
                </div>

                <div style="margin-top: 12px; background: #fffbeb; border: 1px solid #fcd34d; border-radius: 8px; padding: 10px 14px; display: flex; align-items: center; gap: 10px;">
                    <span style="font-size: 1.3rem;">🔒</span>
                    <span style="font-size: 0.82rem; color: #92400e; line-height: 1.5;">
                        <strong>أمان فائق:</strong> يقوم النظام تلقائياً وبشكل إجباري بحفظ نسخة احتياطية كاملة من قاعدة البيانات الحالية قبل تنفيذ التصفير، بحيث يمكنك الرجوع إليها في أي وقت عند الرغبة.
                    </span>
                </div>

                <div style="display: flex; justify-content: flex-end; margin-top: 14px;">
                    <button type="button" class="btn-primary-action" style="background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%); border-color: #991b1b; padding: 11px 22px; font-weight: 800; font-size: 0.92rem; gap: 8px;" @onclick="OpenResetConfirmationModal" disabled="@_isResetting">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            <line x1="10" y1="11" x2="10" y2="17"></line>
                            <line x1="14" y1="11" x2="14" y2="17"></line>
                        </svg>
                        @if (_isResetting)
                        {
                            <span>جاري تهيئة وتصفير النظام وحفظ النسخة الاحتياطية...</span>
                        }
                        else
                        {
                            <span>🧹 تهيئة وتصفير النظام التشغيلي الآن...</span>
                        }
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(_resetSuccessMessage))
                {
                    <div style="margin-top: 12px; background: var(--accent-green-bg); color: var(--accent-green); border: 1.5px solid var(--accent-green-border); padding: 10px 14px; border-radius: 8px; font-size: 0.88rem; font-weight: 700; display: flex; align-items: center; justify-content: space-between;">
                        <span>✅ @_resetSuccessMessage</span>
                        @if (!string.IsNullOrEmpty(_lastResetBackupPath))
                        {
                            <button type="button" class="filter-pill" style="font-size: 0.76rem; padding: 3px 8px; color: var(--accent-green); border-color: var(--accent-green);" @onclick="() => OpenFolderOfFile(_lastResetBackupPath)">
                                عرض النسخة المحفوظة
                            </button>
                        }
                    </div>
                }
                @if (!string.IsNullOrEmpty(_resetErrorMessage))
                {
                    <div style="margin-top: 12px; background: #fee2e2; border: 1.5px solid #ef4444; color: #991b1b; padding: 10px 14px; border-radius: 8px; font-size: 0.88rem; font-weight: 700;">
                        ⚠️ @_resetErrorMessage
                    </div>
                }
            </div>

            <!-- Cloud Sync Card (Supabase & Mobile Web Integration - Internal & Protected) -->
            <div class="widget-card" style="grid-column: span 2; border: 2px solid #10b981; background: #f0fdf4;">
                <div class="widget-header">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <span style="font-size: 1.4rem;">☁️</span>
                        <div>
                            <span class="widget-title" style="color: #166534;">المزامنة السحابية المباشرة مع تطبيق الهاتف (carhusean)</span>
                            <div style="font-size: 0.8rem; color: #15803d;">الربط مدمج داخلياً ومحمي تلقائياً • متزامن لحظياً مع تطبيق الهاتف</div>
                        </div>
                    </div>
                    <span style="font-size: 0.82rem; background: #dcfce7; color: #166534; border: 1px solid #86efac; padding: 4px 14px; border-radius: 20px; font-weight: bold;">
                        🟢 الربط السحابي نشط ومؤمن
                    </span>
                </div>

                <div style="font-size: 0.86rem; color: #334155; line-height: 1.6; margin-top: 6px;">
                    تم ربط وتأمين الاتصال بقاعدة بيانات سوبابيز داخلياً بنجاح. أي تعديل في كلمات السر، أسماء الموظفين، أو سيارات وعملاء المكتب أو تصفير النظام يتم مزامنته تلقائياً وفورياً مع تطبيق الموبايل دون أي تأخير أو تأثير على عمل النظام المكتبي.
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 14px; flex-wrap: wrap; gap: 10px;">
                    <button type="button" class="btn-primary-action" style="padding: 11px 22px; font-weight: 800; background: linear-gradient(135deg, #059669 0%, #047857 100%);" @onclick="PushAllDataToCloudAsync" disabled="@_isPushingToCloud">
                        @if (_isPushingToCloud)
                        {
                            <span>جاري رفع ومزامنة كافة السجلات...</span>
                        }
                        else
                        {
                            <span>🚀 رفع ومزامنة كافة بيانات المكتب الحالية لتطبيق الهاتف</span>
                        }
                    </button>

                    <div style="font-size: 0.8rem; color: #15803d; font-weight: 700;">
                        🔒 المزامنة تعمل في الخلفية دون أي اعتماد إجباري على الإنترنت (نظام أوفلاين فائق السرعة).
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_cloudStatusMessage))
                {
                    <div style="margin-top: 12px; background: #ffffff; border: 1.5px solid #86efac; color: #166534; padding: 10px 14px; border-radius: 8px; font-size: 0.86rem; font-weight: 700;">
                        @_cloudStatusMessage
                    </div>
                }
            </div>
        </div>
    }

    <!-- TAB 3: AUDIT TRAIL -->
    @if (_activeTab == "audit")
    {
        <div class="data-table-container">
            <div style="padding: 14px 18px; font-weight: bold; border-bottom: 1.5px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; background: #ede6d8;">
                <span style="color: var(--primary-blue); font-weight: 800;">سجل التدقيق الأمني للعمليات (Audit Trail)</span>
                <span style="font-size: 0.82rem; color: var(--text-muted);">توثيق بالثانية لجميع حركات تسجيل الدخول، الإدخال، التعديل، وفك الحظر</span>
            </div>

            <table class="data-table">
                <thead>
                    <tr>
                        <th>التوقيت</th>
                        <th>المستخدم</th>
                        <th>الصلاحية</th>
                        <th>نوع الإجراء</th>
                        <th>القسم / السجل</th>
                        <th>تفاصيل الحركة</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_auditLogs != null && _auditLogs.Any())
                    {
                        @foreach (var log in _auditLogs)
                        {
                            <tr>
                                <td style="font-size: 0.82rem; color: var(--text-muted);">
                                    @log.Timestamp.ToString("yyyy/MM/dd HH:mm:ss")
                                </td>
                                <td style="font-weight: 800; color: var(--text-main);">@log.Username</td>
                                <td>
                                    <span style="font-size: 0.76rem; color: var(--primary-blue); font-weight: bold;">
                                        @(log.Role switch {
                                            UserRole.Admin => "المدير",
                                            UserRole.Staff => "الموظف",
                                            UserRole.Accountant => "المحاسب",
                                            _ => log.Role.ToString()
                                        })
                                    </span>
                                </td>
                                <td>
                                    <span style="font-size: 0.78rem; font-weight: bold; color: @(log.Action == AuditAction.Insert ? "var(--accent-green)" : log.Action == AuditAction.Unblock ? "var(--accent-orange)" : log.Action == AuditAction.Delete ? "var(--accent-red)" : "var(--primary-blue)");">
                                        @FormatAuditAction(log.Action)
                                    </span>
                                </td>
                                <td style="font-weight: 600; color: var(--text-dark);">@FormatEntityName(log.EntityName)</td>
                                <td style="font-size: 0.86rem; color: var(--text-dark);">@log.Details</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="text-align: center; padding: 40px; color: var(--text-muted);">
                                لا توجد سجلات تدقيق سابقة حتى الآن. سيتم توثيق كل حركة في النظام تلقائياً هنا.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Add / Edit User Modal -->
@if (_showUserModal)
{
    <div class="modal-overlay">
        <div class="modal-card" style="max-width: 650px; width: 95%;">
            <div class="modal-header">
                <div class="modal-title" style="color: var(--primary-blue);">
                    @(_editingUser?.Id == Guid.Empty ? "إضافة مستخدم جديد للنظام" : $"تعديل بيانات المستخدم: {_editingUser?.FullName}")
                </div>
                <button class="btn-close-modal" @onclick="() => _showUserModal = false">×</button>
            </div>

            <div class="modal-body" style="display: flex; flex-direction: column; gap: 14px; overflow-x: hidden;">
                @if (!string.IsNullOrEmpty(_modalErrorMessage))
                {
                    <div style="background: #fee2e2; border: 1.5px solid #ef4444; color: #991b1b; padding: 10px 14px; border-radius: 6px; font-size: 0.88rem; font-weight: 700;">
                        @_modalErrorMessage
                    </div>
                }

                <div class="form-group">
                    <label class="form-label">الاسم الكامل (الموظف) *:</label>
                    <input type="text" class="form-control" @bind="_editingFullName" placeholder="مثال: أحمد مصطفى" />
                </div>

                <div class="form-group">
                    <label class="form-label">الصلاحية / الرتبة *:</label>
                    @if (IsSoleActiveAdmin(_editingUser))
                    {
                        <div style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 8px; padding: 8px 12px; margin-bottom: 6px; font-size: 0.8rem; color: #b45309; font-weight: 700; display: flex; align-items: center; gap: 6px;">
                            <span>👑 مدير عام محمي (الآدمن النشط الوحيد بالنظام - لا يمكن تغيير الرتبة)</span>
                        </div>
                    }
                    <select class="form-control" @bind="_editingRole" style="font-weight: 600;" disabled="@IsSoleActiveAdmin(_editingUser)">
                        <option value="@UserRole.Staff">🧑‍💼 موظف استقبال (Staff) - تشغيل وعقود وأسطول وزبائن</option>
                        <option value="@UserRole.Admin">👑 المدير العام (Admin) - صلاحيات كاملة ومطلقة لكافة أقسام النظام</option>
                        <option value="@UserRole.Accountant">📊 محاسب النظام (Accountant) - حسابات وإيرادات وتقارير وتدقيق مالي</option>
                    </select>
                </div>

                <div class="form-grid-2">
                    <div class="form-group">
                        <label class="form-label">اسم المستخدم للدخول (Username) *:</label>
                        <input type="text" class="form-control" @bind="_editingUsername" placeholder="مثال: ahmed" />
                    </div>

                    <div class="form-group">
                        <label class="form-label" style="color: var(--accent-gold); font-weight: 800;">
                            رمز المرور السري PIN (4 أرقام) *:
                        </label>
                        <input type="text" class="form-control" maxlength="4" @bind="_editingPin" placeholder="مثال: 1234" style="font-family: monospace; font-size: 1.1rem; font-weight: bold; letter-spacing: 2px;" />
                        <span style="font-size: 0.72rem; color: var(--text-muted);">رمز مكون من 4 أرقام لتسجيل الدخول السري</span>
                    </div>
                </div>

                <div class="form-grid-2" style="align-items: center;">
                    <div class="form-group">
                        <label class="form-label">رقم الجوال:</label>
                        <input type="text" class="form-control" @bind="_editingPhone" placeholder="05xxxxxxxx" />
                    </div>

                    <div class="form-group" style="justify-content: flex-end; padding-top: 18px;">
                        @if (IsSoleActiveAdmin(_editingUser))
                        {
                            <div style="background: rgba(239, 68, 68, 0.1); border: 1.5px solid rgba(239, 68, 68, 0.35); border-radius: 8px; padding: 10px 14px; display: flex; align-items: center; gap: 10px; width: 100%;">
                                <input type="checkbox" checked disabled style="width: 20px; height: 20px; cursor: not-allowed; accent-color: #ef4444;" />
                                <div>
                                    <span style="font-size: 0.86rem; font-weight: 800; color: #dc2626; display: block;">الحساب مفعّل إجبارياً (محمي)</span>
                                    <span style="font-size: 0.74rem; color: var(--text-muted); display: block; line-height: 1.3;">هذا هو حساب المدير العام الوحيد النشط. لحمايتك من حظر النظام، لا يمكن تعطيله إلا بعد توفير مدير عام نشط آخر.</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 0.9rem; font-weight: 700; color: var(--text-main);">
                                <input type="checkbox" @bind="_editingIsActive" style="width: 18px; height: 18px; cursor: pointer;" />
                                <span>الحساب مفعّل ونشط للدخول</span>
                            </label>
                        }
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="filter-pill" @onclick="() => _showUserModal = false">إلغاء</button>
                <button class="btn-primary-action" @onclick="SaveUser">
                    <span>حفظ التعديلات ورمز الـ PIN</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- Modal: Confirm Operational Data Reset (تأكيد تهيئة وتصفير النظام) -->
@if (_showResetConfirmModal)
{
    <div class="modal-overlay">
        <div class="modal-card" style="max-width: 580px; width: 94%;">
            <div class="modal-header" style="background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%); border-bottom: 2px solid #f87171;">
                <div class="modal-title" style="display: flex; align-items: center; gap: 10px; color: #991b1b;">
                    <div style="width: 36px; height: 36px; border-radius: 8px; background: #dc2626; color: white; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">
                        ⚠️
                    </div>
                    <div>
                        <div style="font-size: 1.05rem; font-weight: 800; color: #991b1b;">تأكيد تهيئة وتصفير السجلات التشغيلية للنظام</div>
                        <div style="font-size: 0.78rem; color: #7f1d1d;">يرجى مراجعة وتأكيد العملية قبل التنفيذ</div>
                    </div>
                </div>
                <button class="btn-close-modal" @onclick="() => _showResetConfirmModal = false">×</button>
            </div>

            <div class="modal-body" style="display: flex; flex-direction: column; gap: 14px; padding: 20px;">
                <div style="background: #fef2f2; border: 1.5px solid #f87171; border-radius: 10px; padding: 14px; color: #991b1b; font-size: 0.88rem; line-height: 1.6;">
                    <strong>تنبيه إداري قطعي:</strong> أنت على وشك مسح كافة العقود السابقة، السندات والكمبيالات، الحركات المالية، والورديات السابقة للبدء بصفحة جديدة نظيفة.
                </div>

                <div style="font-size: 0.85rem; color: var(--text-main); line-height: 1.6;">
                    <div style="font-weight: 800; color: #166534; margin-bottom: 4px;">✅ سيتم الحفاظ على ما يلي بنسبة 100%:</div>
                    <ul style="margin: 0; padding-right: 20px; color: #15803d; font-size: 0.82rem;">
                        <li>كافة الموظفين والمستخدمين وكلمات السر والـ PINs.</li>
                        <li>كافة سيارات الأسطول ومواصفاتها وأسعارها وصورها.</li>
                        <li>كافة العملاء وأرقام هوياتهم وهواتفهم وملفاتهم.</li>
                        <li>بيانات وهوية المكتب وإعداداته.</li>
                    </ul>
                </div>

                <div style="background: #eff6ff; border: 1.5px solid #93c5fd; border-radius: 8px; padding: 10px 14px; font-size: 0.82rem; color: #1e40af;">
                    💡 <strong>نسخة أمان تلقائية:</strong> سيقوم البرنامج بحفظ نسخة احتياطية كاملة من قاعدة البيانات الحالية تلقائياً قبل بدء المسح، ويمكن استرجاعها بضغطة زر.
                </div>

                @if (_isResetting)
                {
                    <div style="background: #fffbeb; border: 1.5px solid #f59e0b; border-radius: 8px; padding: 12px; display: flex; align-items: center; gap: 10px; color: #b45309; font-weight: 700; font-size: 0.88rem;">
                        <span style="font-size: 1.2rem;">⏳</span>
                        <span>جاري حفظ النسخة الاحتياطية وتصفير السجلات التشغيلية... يرجى الانتظار لحظات</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_resetErrorMessage))
                {
                    <div style="background: #fee2e2; border: 1px solid #ef4444; color: #b91c1c; padding: 8px 12px; border-radius: 6px; font-size: 0.84rem; font-weight: bold;">
                        @_resetErrorMessage
                    </div>
                }
            </div>

            <div class="modal-footer" style="display: flex; justify-content: flex-end; gap: 10px; padding: 14px 20px; background: #f9fafb; border-top: 1px solid var(--border-color);">
                <button type="button" class="filter-pill" @onclick="() => _showResetConfirmModal = false" disabled="@_isResetting">إلغاء التراجع</button>
                <button type="button" class="btn-primary-action" style="background: #dc2626; border-color: #b91c1c; color: white; padding: 10px 20px; font-weight: 800;" @onclick="ExecuteResetOperationalData" disabled="@_isResetting">
                    @if (_isResetting)
                    {
                        <span>جاري التنفيذ وحفظ النسخة...</span>
                    }
                    else
                    {
                        <span>نعم، أؤكد تهيئة وتصفير النظام الآن</span>
                    }
                </button>
            </div>
        </div>
    </div>
}
}

@code {
    private string _activeTab = "users";
    private List<User> _users = new();
    private List<AuditLog>? _auditLogs;
    private string _backupFolder = "";
    private bool _isBackingUp = false;
    private string? _backupSuccessMessage;
    private string? _statusMessage;
    private bool _showPins = true;

    private CompanyProfile? _companyProfile;
    private bool _isSavingCompany = false;

    private List<string> _existingBackups = new();
    private bool _isRestoring = false;
    private string? _restoreSuccessMessage;
    private string? _restoreErrorMessage;

    // Operational Reset State
    private bool _showResetConfirmModal = false;
    private bool _isResetting = false;
    private string? _resetSuccessMessage;
    private string? _resetErrorMessage;
    private string? _lastResetBackupPath;

    // Cloud Sync State (Supabase Internal)
    private bool _isPushingToCloud = false;
    private string? _cloudStatusMessage;
    private bool _isCloudConfigured = true;

    private void OpenResetConfirmationModal()
    {
        _resetErrorMessage = null;
        _resetSuccessMessage = null;
        _showResetConfirmModal = true;
    }

    private async Task ExecuteResetOperationalData()
    {
        if (_isResetting) return;
        _isResetting = true;
        _resetErrorMessage = null;
        _resetSuccessMessage = null;
        StateHasChanged();
        await Task.Delay(50);

        try
        {
            var adminUsername = !string.IsNullOrWhiteSpace(AuthState.CurrentUser.Username)
                ? AuthState.CurrentUser.Username
                : "admin";

            var backupPath = await RentalService.ResetOperationalDataAsync(adminUsername);
            _lastResetBackupPath = backupPath;
            _resetSuccessMessage = $"تمت تهيئة وتصفير النظام بنجاح! تم أخذ نسخة احتياطية آمنة في: {System.IO.Path.GetFileName(backupPath)}";
            _showResetConfirmModal = false;
            RefreshExistingBackups();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _resetErrorMessage = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            _isResetting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Modal State
    private bool _showUserModal = false;
    private User? _editingUser;
    private string _editingFullName = "";
    private string _editingUsername = "";
    private UserRole _editingRole = UserRole.Staff;
    private string _editingPin = "";
    private string _editingPhone = "";
    private bool _editingIsActive = true;
    private string? _modalErrorMessage;

    public void Dispose()
    {
        AuthState.OnUserChanged -= StateHasChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        _backupFolder = System.IO.Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "Backups");
        await LoadDataAsync();
        AuthState.OnUserChanged += StateHasChanged;
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _users = await RentalService.GetUsersAsync();
            _auditLogs = await RentalService.GetAuditLogsAsync();
            _companyProfile = await RentalService.GetCompanyProfileAsync();
            RefreshExistingBackups();

            _isCloudConfigured = CloudSyncService.IsConfigured();
        }
        catch
        {
        }
    }

    private async Task PushAllDataToCloudAsync()
    {
        if (!CloudSyncService.IsConfigured())
        {
            _cloudStatusMessage = "⚠️ يرجى حفظ بيانات الربط بالسحابة أولاً.";
            return;
        }

        _isPushingToCloud = true;
        _cloudStatusMessage = "جاري رفع ومزامنة كافة السجلات الحالية من قاعدة البيانات المحلية إلى سوبابيز...";
        StateHasChanged();

        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            var success = await CloudSyncService.PushFullDatabaseToCloudAsync(context);
            if (success)
            {
                _cloudStatusMessage = "🎉 تمت مزامنة كافة المستخدمين وكلمات السر والسيارات والعملاء بنجاح تام إلى السحابة!";
            }
            else
            {
                _cloudStatusMessage = "⚠️ تعذر إتمام الرفع. تأكد من تشغيل سكريبت SQL في سوبابيز أولاً وصحة الرابط والمفتاح.";
            }
        }
        catch (Exception ex)
        {
            _cloudStatusMessage = $"حدث خطأ أثناء الرفع: {ex.Message}";
        }
        finally
        {
            _isPushingToCloud = false;
            StateHasChanged();
        }
    }

    private void RefreshExistingBackups()
    {
        try
        {
            if (System.IO.Directory.Exists(_backupFolder))
            {
                _existingBackups = System.IO.Directory.GetFiles(_backupFolder, "*.db")
                    .OrderByDescending(f => System.IO.File.GetLastWriteTime(f))
                    .ToList();
            }
            else
            {
                _existingBackups.Clear();
            }
        }
        catch { }
    }

    private async Task HandleLogoUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                using var ms = new System.IO.MemoryStream();
                await stream.CopyToAsync(ms);
                var base64 = Convert.ToBase64String(ms.ToArray());
                if (_companyProfile != null)
                {
                    _companyProfile.LogoBase64 = $"data:{file.ContentType};base64,{base64}";
                }
            }
        }
        catch (Exception ex)
        {
            _statusMessage = "خطأ في رفع الشعار: " + ex.Message;
        }
    }

    private async Task SaveCompanyProfile()
    {
        if (_companyProfile == null) return;
        _isSavingCompany = true;
        try
        {
            await RentalService.SaveCompanyProfileAsync(_companyProfile, AuthState.CurrentUser.FullName);
            _statusMessage = "تم حفظ بيانات وهوية وشروط المكتب بنجاح.";
        }
        catch (Exception ex)
        {
            _statusMessage = "خطأ في حفظ بيانات المكتب: " + ex.Message;
        }
        finally
        {
            _isSavingCompany = false;
        }
    }

    private async Task HandleRestoreFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            var tempPath = System.IO.Path.Combine(System.IO.Path.GetTempPath(), $"restore_{Guid.NewGuid():N}.db");
            using (var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024))
            using (var fs = System.IO.File.Create(tempPath))
            {
                await stream.CopyToAsync(fs);
            }
            await ConfirmRestoreFromFile(tempPath);
        }
        catch (Exception ex)
        {
            _restoreErrorMessage = "خطأ في قراءة ملف الاسترجاع: " + ex.Message;
        }
    }

    private async Task ConfirmRestoreFromFile(string filePath)
    {
        _isRestoring = true;
        _restoreSuccessMessage = null;
        _restoreErrorMessage = null;

        try
        {
            await RentalService.RestoreBackupAsync(filePath, AuthState.CurrentUser.FullName);
            _restoreSuccessMessage = "تم استرجاع قاعدة البيانات بنجاح! تم تحديث كافة السجلات.";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _restoreErrorMessage = "فشل استرجاع النسخة الاحتياطية: " + ex.Message;
        }
        finally
        {
            _isRestoring = false;
        }
    }

    private bool IsSoleActiveAdmin(User? user)
    {
        if (user == null || user.Role != UserRole.Admin) return false;
        var otherActiveAdmins = _users.Count(u => u.Role == UserRole.Admin && u.IsActive && u.Id != user.Id);
        return otherActiveAdmins == 0;
    }

    private void OpenAddUserModal()
    {
        _editingUser = new User();
        _editingFullName = "";
        _editingUsername = "";
        _editingRole = UserRole.Staff;
        _editingPin = "";
        _editingPhone = "";
        _editingIsActive = true;
        _modalErrorMessage = null;
        _showUserModal = true;
    }

    private void OpenEditUserModal(User user)
    {
        _editingUser = user;
        _editingFullName = user.FullName;
        _editingUsername = user.Username;
        _editingRole = user.Role;
        _editingPin = user.PasswordHash;
        _editingPhone = user.PhoneNumber ?? "";
        _editingIsActive = IsSoleActiveAdmin(user) ? true : user.IsActive;
        _modalErrorMessage = null;
        _showUserModal = true;
    }

    private async Task SaveUser()
    {
        if (string.IsNullOrWhiteSpace(_editingFullName))
        {
            _modalErrorMessage = "يرجى كتابة الاسم الكامل للمستخدم.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_editingUsername))
        {
            _modalErrorMessage = "يرجى إدخال اسم المستخدم (Username).";
            return;
        }

        if (string.IsNullOrWhiteSpace(_editingPin) || _editingPin.Length != 4 || !_editingPin.All(char.IsDigit))
        {
            _modalErrorMessage = "رمز المرور (PIN) يجب أن يكون مكوناً من 4 أرقام حصرية (مثال: 1234 أو 5678).";
            return;
        }

        try
        {
            if (IsSoleActiveAdmin(_editingUser))
            {
                _editingRole = UserRole.Admin;
                _editingIsActive = true;
            }

            var userToSave = _editingUser ?? new User();
            userToSave.FullName = _editingFullName.Trim();
            userToSave.Username = _editingUsername.Trim();
            userToSave.Role = _editingRole;
            userToSave.PasswordHash = _editingPin.Trim();
            userToSave.PhoneNumber = _editingPhone?.Trim();
            userToSave.IsActive = _editingIsActive;

            var savedUser = await RentalService.SaveUserAsync(userToSave, AuthState.CurrentUser.Username);

            // إذا كان المستخدم المُعدل هو المستخدم الحالي المسجل دخوله، نحدث الجلسة الحية فوراً
            if (AuthState.CurrentUser != null && (savedUser.Id == AuthState.CurrentUser.Id || savedUser.Username.Equals(AuthState.CurrentUser.Username, StringComparison.OrdinalIgnoreCase)))
            {
                AuthState.SetUser(savedUser);
            }

            _showUserModal = false;
            _statusMessage = $"تم حفظ بيانات المستخدم '{savedUser.FullName}' وتحديث رمز الـ PIN ({savedUser.PasswordHash}) وترحيل عملياته بنجاح.";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _modalErrorMessage = $"خطأ أثناء حفظ المستخدم: {ex.Message}";
        }
    }

    private async Task DeleteUser(User user)
    {
        if (IsSoleActiveAdmin(user))
        {
            _statusMessage = "⚠️ لا يمكن حذف حساب المدير العام الوحيد النشط في النظام! يجب توفير مدير عام نشط آخر أولاً.";
            return;
        }

        try
        {
            await RentalService.DeleteUserAsync(user.Id, AuthState.CurrentUser.Username);
            _statusMessage = $"تم حذف المستخدم '{user.FullName}' بنجاح.";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _statusMessage = $"تعذر الحذف: {ex.Message}";
        }
    }

    private string? _lastSavedBackupPath;

    private async Task ChooseLocationAndBackup()
    {
        string? targetPath = null;

        try
        {
            if (System.Windows.Application.Current != null)
            {
                System.Windows.Application.Current.Dispatcher.Invoke(() =>
                {
                    var dialog = new Microsoft.Win32.SaveFileDialog
                    {
                        Title = "تحديد مكان حفظ النسخة الاحتياطية",
                        Filter = "ملف نسخة احتياطية للنظام (*.db)|*.db|جميع الملفات (*.*)|*.*",
                        FileName = $"نسخة_احتياطية_لتأجير_السيارات_{DateTime.Now:yyyy-MM-dd_HH-mm}.db",
                        DefaultExt = ".db",
                        AddExtension = true,
                        InitialDirectory = System.IO.Directory.Exists(_backupFolder) 
                            ? _backupFolder 
                            : Environment.GetFolderPath(Environment.SpecialFolder.Desktop)
                    };

                    if (dialog.ShowDialog() == true)
                    {
                        targetPath = dialog.FileName;
                    }
                });
            }
        }
        catch (Exception ex)
        {
            _backupSuccessMessage = $"تعذر فتح نافذة الحفظ: {ex.Message}";
            return;
        }

        if (!string.IsNullOrEmpty(targetPath))
        {
            await ExecuteBackupToPathAsync(targetPath);
        }
    }

    private async Task BackupToDesktop()
    {
        var desktop = Environment.GetFolderPath(Environment.SpecialFolder.Desktop);
        var fileName = $"نسخة_احتياطية_لتأجير_السيارات_{DateTime.Now:yyyy-MM-dd_HH-mm}.db";
        var targetPath = System.IO.Path.Combine(desktop, fileName);
        await ExecuteBackupToPathAsync(targetPath);
    }

    private async Task BackupToDocuments()
    {
        var docs = Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments);
        var dir = System.IO.Path.Combine(docs, "نسخ_احتياطية_تأجير_السيارات");
        var fileName = $"نسخة_احتياطية_لتأجير_السيارات_{DateTime.Now:yyyy-MM-dd_HH-mm}.db";
        var targetPath = System.IO.Path.Combine(dir, fileName);
        await ExecuteBackupToPathAsync(targetPath);
    }

    private async Task ExecuteBackupToPathAsync(string path)
    {
        _isBackingUp = true;
        _backupSuccessMessage = null;

        try
        {
            var savedPath = await RentalService.CreateLocalBackupAsync(path);
            _lastSavedBackupPath = savedPath;
            _backupSuccessMessage = $"تم حفظ النسخة بنجاح: {System.IO.Path.GetFileName(savedPath)}";
            RefreshExistingBackups();
        }
        catch (Exception ex)
        {
            _backupSuccessMessage = $"تعذر إتمام النسخ الاحتياطي: {ex.Message}";
        }
        finally
        {
            _isBackingUp = false;
        }
    }

    private void BrowseBackupFolder()
    {
        try
        {
            if (System.Windows.Application.Current != null)
            {
                System.Windows.Application.Current.Dispatcher.Invoke(() =>
                {
                    var folderDialog = new Microsoft.Win32.OpenFolderDialog
                    {
                        Title = "اختر مجلد حفظ النسخ الاحتياطية المعتمد",
                        InitialDirectory = System.IO.Directory.Exists(_backupFolder) 
                            ? _backupFolder 
                            : Environment.GetFolderPath(Environment.SpecialFolder.Desktop)
                    };

                    if (folderDialog.ShowDialog() == true)
                    {
                        _backupFolder = folderDialog.FolderName;
                        RefreshExistingBackups();
                    }
                });
            }
        }
        catch
        {
        }
    }

    private void OpenBackupFolderInExplorer()
    {
        try
        {
            if (System.IO.Directory.Exists(_backupFolder))
            {
                System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
                {
                    FileName = "explorer.exe",
                    Arguments = $"\"{_backupFolder}\"",
                    UseShellExecute = true
                });
            }
        }
        catch { }
    }

    private void OpenFolderOfFile(string? filePath)
    {
        try
        {
            if (!string.IsNullOrEmpty(filePath) && System.IO.File.Exists(filePath))
            {
                System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
                {
                    FileName = "explorer.exe",
                    Arguments = $"/select,\"{filePath}\"",
                    UseShellExecute = true
                });
            }
            else
            {
                OpenBackupFolderInExplorer();
            }
        }
        catch { }
    }

    private async Task ChooseAndRestoreFile()
    {
        string? selectedFilePath = null;
        try
        {
            if (System.Windows.Application.Current != null)
            {
                System.Windows.Application.Current.Dispatcher.Invoke(() =>
                {
                    var dialog = new Microsoft.Win32.OpenFileDialog
                    {
                        Title = "اختر ملف النسخة الاحتياطية للاسترجاع",
                        Filter = "ملفات النسخ الاحتياطية (*.db)|*.db|جميع الملفات (*.*)|*.*",
                        CheckFileExists = true,
                        InitialDirectory = System.IO.Directory.Exists(_backupFolder) 
                            ? _backupFolder 
                            : Environment.GetFolderPath(Environment.SpecialFolder.Desktop)
                    };

                    if (dialog.ShowDialog() == true)
                    {
                        selectedFilePath = dialog.FileName;
                    }
                });
            }
        }
        catch (Exception ex)
        {
            _restoreErrorMessage = "تعذر فتح نافذة الاختيار: " + ex.Message;
            return;
        }

        if (!string.IsNullOrEmpty(selectedFilePath))
        {
            await ConfirmRestoreFromFile(selectedFilePath);
        }
    }

    private static string FormatEntityName(string entityName) => entityName switch
    {
        "User" => "المستخدمين والصلاحيات",
        "Contract" => "العقود والتأجير",
        "Vehicle" => "السيارات والأسطول",
        "Customer" => "ملفات العملاء",
        "Payment" => "سندات القبض والصرف",
        "CompanyProfile" => "بيانات وشروط المكتب",
        "TrafficViolation" => "المخالفات المرورية",
        "BlacklistEntry" => "القائمة السوداء",
        _ => entityName
    };

    private static string FormatAuditAction(AuditAction action) => action switch
    {
        AuditAction.Insert => "إضافة جديدة",
        AuditAction.Update => "تعديل سجل",
        AuditAction.Delete => "حذف سجل",
        AuditAction.Login => "تسجيل دخول",
        AuditAction.ShiftClose => "إغلاق وردية",
        AuditAction.PrintContract => "طباعة عقد",
        AuditAction.PrintPromissoryNote => "طباعة كمبيالة",
        AuditAction.ContractExtend => "تمديد عقد",
        AuditAction.ContractClose => "إنهاء عقد",
        AuditAction.TrafficViolationAdd => "تسجيل مخالفة",
        AuditAction.DebtSettlement => "تسوية ذمة",
        AuditAction.BackupRestore => "استرجاع نسخة احتياطية",
        AuditAction.Unblock => "فك حظر عميل",
        _ => action.ToString()
    };

    private async Task LogoutWithSoundAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("carAudio.playEngineStop");
            await Task.Delay(450);
        }
        catch { }

        AuthState.Logout();
    }
}
