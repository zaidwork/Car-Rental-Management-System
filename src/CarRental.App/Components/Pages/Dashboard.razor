@page "/"
@using CarRental.Core.Helpers
@using CarRental.Infrastructure.Helpers
@inject IRentalSystemService RentalService
@inject INotificationService NotificationService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IDisposable

<!-- Top Action Strip (matching screenshot) -->
<div class="action-bar-strip">
    <div class="action-bar-left">
        <!-- Glowing 'حجز جديد' Button -->
        <button class="btn-primary-action" @onclick="() => { _selectedVehicleIdForContract = null; _showNewContractModal = true; }">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>حجز جديد</span>
        </button>

        <div class="action-filter-pills">
            <button class="filter-pill @(_activeFilter == "all" ? "active" : "")" @onclick='() => _activeFilter = "all"'>
                عرض الأسطول (@(_dashboardData?.TotalVehicles ?? 0))
            </button>
            <button class="filter-pill @(_activeFilter == "available" ? "active" : "")" @onclick='() => _activeFilter = "available"'>
                🚗 المتاحة للتأجير (@(_dashboardData?.AvailableVehicles ?? 0))
            </button>
            <button class="filter-pill @(_activeFilter == "active" ? "active" : "")" @onclick='() => _activeFilter = "active"'>
                📅 الحجوزات النشطة (@(_dashboardData?.ActiveContractsCount ?? 0))
            </button>
            @if (_overdueContracts != null && _overdueContracts.Any())
            {
                <button class="filter-pill pill-overdue @(_activeFilter == "overdue" ? "active" : "")" @onclick='() => _activeFilter = "overdue"'>
                    🚨 عقود متأخرة <span class="filter-badge-danger">@_overdueContracts.Count</span>
                </button>
            }
            <button class="filter-pill" style="border-color: #38bdf8; color: #0284c7; font-weight: 700; background: #f0f9ff;" @onclick='() => Navigation.NavigateTo("timeline")' title="الانتقال إلى مخطط الحجوزات والتعاقدات">
                ⏱️ مخطط الحجوزات والتعاقدات ←
            </button>
        </div>
    </div>

    <!-- Search Input with Refresh -->
    <div style="display: flex; align-items: center; gap: 8px;">
        <div class="search-input-box">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" placeholder="بحث في المركبات والعملاء..." @bind="_searchQuery" @bind:event="oninput" />
        </div>
        <button class="icon-btn-subtle" title="تحديث البيانات" @onclick="LoadDashboardData">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
            </svg>
        </button>
    </div>
</div>

<!-- Overdue Contracts Alert Banner -->
@if (_overdueContracts != null && _overdueContracts.Any())
{
    <div style="background: #fff5f5; border: 2px solid #ef4444; border-radius: 12px; padding: 16px 20px; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.15); display: flex; flex-direction: column; gap: 10px;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span style="font-size: 1.4rem;">🚨</span>
                <div>
                    <strong style="color: #b91c1c; font-size: 1.05rem;">
                        تنبيه: يوجد (@_overdueContracts.Count) عقود إيجار متأخرة عن موعد الإرجاع الرسمي!
                    </strong>
                    <div style="font-size: 0.82rem; color: #7f1d1d;">
                        يرجى التواصل الفوري مع المستأجرين لإرجاع السيارات أو تمديد العقود وتحصيل الرسوم
                    </div>
                </div>
            </div>
            <button class="filter-pill" style="background: #ef4444; color: #fff; font-weight: bold; border: none; cursor: pointer;" @onclick='() => Navigation.NavigateTo("contracts")'>
                عرض في شاشة العقود ←
            </button>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 10px; margin-top: 4px;">
            @foreach (var ov in _overdueContracts)
            {
                <div style="background: #fff; border: 1px solid #fca5a5; border-radius: 8px; padding: 10px 14px; display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <div style="font-weight: 800; color: #1e293b; font-size: 0.92rem;">
                            @ov.CustomerName
                        </div>
                        <div style="font-size: 0.8rem; color: #64748b; margin-top: 2px;">
                            <span>@ov.VehicleInfo</span> | <span style="font-family: monospace; font-weight: bold; color: var(--primary-blue);">@ov.PlateNumber</span>
                        </div>
                        <div style="font-size: 0.78rem; color: #dc2626; font-weight: bold; margin-top: 4px;">
                            ⏱️ متأخرة: @(ov.OverdueDays > 0 ? $"{ov.OverdueDays} يوم و " : "")@((ov.OverdueHours % 24)) ساعة
                        </div>
                    </div>

                    <div style="display: flex; gap: 6px;">
                        <button class="icon-btn-subtle" style="color: #16a34a; background: #dcfce7;" title="تواصل واتساب فوري مع المستأجر" @onclick="() => SendOverdueWhatsApp(ov)">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                            </svg>
                        </button>
                        <button class="filter-pill" style="font-size: 0.75rem; padding: 4px 8px; background: #fef2f2; border-color: #fca5a5; color: #dc2626;" @onclick='() => Navigation.NavigateTo("contracts")'>
                            تمديد / تسوية
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- Middle Section: Cars Shelf on Left, Widgets on Right (2 Column Grid matching screenshot) -->
<div class="dashboard-middle-grid">
    <!-- Left Column: Cars Cards Section ('لوحة التعليقات / السيارات') -->
    <div class="cars-shelf-card">
        <div class="shelf-header">
            <div style="display: flex; align-items: center; gap: 10px;">
                <div class="shelf-title">لوحة الأسطول / السيارات المتاحة والنشطة</div>
                <span style="background: #ede6d8; color: var(--wood-walnut); font-size: 0.78rem; font-weight: 800; padding: 2px 8px; border-radius: 12px; border: 1px solid var(--border-color);">
                    @(_filteredCars?.Count() ?? 0) سيارة
                </span>
            </div>
            <div style="display: flex; align-items: center; gap: 10px;">
                <div style="font-size: 0.82rem; color: #0284c7; cursor: pointer; font-weight: 800; background: #f0f9ff; padding: 5px 12px; border-radius: 20px; border: 1px solid #bae6fd; transition: all 0.2s;" @onclick='() => Navigation.NavigateTo("fleet")' title="الانتقال لجدول إدارة الأسطول الكامل">
                    عرض كافة سيارات الأسطول بالجدول (@(_dashboardData?.TotalVehicles ?? 0)) ←
                </div>
            </div>
        </div>

        <div class="cars-cards-shelf-scroll">
            <div class="cars-cards-row">
                @if (_filteredCars != null && _filteredCars.Any())
                {
                @foreach (var car in _filteredCars)
                {
                    <div class="car-card @(car.Status == VehicleStatus.Rented ? "rented" : "")" style="@(car.Status == VehicleStatus.Rented ? "border: 2px solid #ef4444; box-shadow: 0 0 16px rgba(239, 68, 68, 0.28); background: #fffafa;" : "")">
                        <div class="car-badge-plate" style="@(car.Status == VehicleStatus.Rented ? "border-color: #ef4444; color: #dc2626; background: #fee2e2;" : "")">
                            لوحة: @car.PlateNumber
                        </div>

                        <div class="car-image-container">
                            @if (!string.IsNullOrEmpty(car.ImageUrl))
                            {
                                <img src="@car.ImageUrl" alt="@car.Model" />
                            }
                            else
                            {
                                <div style="font-size: 3.2rem; display: flex; align-items: center; justify-content: center; height: 100%; opacity: 0.85;">🚗</div>
                            }
                        </div>

                        <div class="car-details">
                            <div class="car-name-title">
                                <span>@car.Brand @car.Model</span>
                                <span style="font-size: 0.86rem; color: var(--primary-blue); font-weight: 800;">@car.DailyStandardRate ₪/يوم</span>
                            </div>
                            <div class="car-specs-sub">
                                <span>عداد: @car.CurrentOdometer.ToString("N0") كم</span>
                                @if (car.Status == VehicleStatus.Rented)
                                {
                                    <span style="color: #dc2626; font-weight: 800; background: #fee2e2; padding: 2px 8px; border-radius: 4px; border: 1px solid #fca5a5; box-shadow: 0 0 6px rgba(239, 68, 68, 0.25);">
                                        🔴 مؤجرة حالياً
                                    </span>
                                }
                                else if (car.Status == VehicleStatus.InMaintenance || car.IsBlockedByCriticalMaintenance)
                                {
                                    <span style="color: #b91c1c; font-weight: 800; background: #fee2e2; padding: 2px 8px; border-radius: 4px; border: 1px solid #fca5a5;">
                                        ⛔ متوقفة بالصيانة (منع تأجير)
                                    </span>
                                }
                                else
                                {
                                    <span style="color: var(--accent-green); font-weight: 800;">
                                        🟢 متاحة للتأجير
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="car-card-actions">
                            <div class="car-quick-icons">
                                <button class="icon-btn-subtle" title="تفاصيل المركبة" @onclick='() => Navigation.NavigateTo("fleet")'>
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                                        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                                    </svg>
                                </button>
                            </div>

                            @if (car.Status == VehicleStatus.Rented)
                            {
                                <button class="car-btn-status rented" style="background: #fee2e2; color: #b91c1c; border: 1.5px solid #ef4444; box-shadow: 0 0 8px rgba(239, 68, 68, 0.35); font-weight: 800; cursor: not-allowed;" title="المركبة مؤجرة حالياً وغير متاحة لفتح عقد جديد">
                                    🔴 مؤجرة (لا تقبل التأجير)
                                </button>
                            }
                            else if (car.Status == VehicleStatus.InMaintenance || car.IsBlockedByCriticalMaintenance)
                            {
                                <button class="car-btn-status in-maintenance" style="background: #fee2e2; color: #b91c1c; border: 1.5px solid #ef4444; font-weight: 800; cursor: not-allowed;" title="المركبة متوقفة بالصيانة وممنوعة تماماً من التأجير">
                                    ⛔ متوقفة بالصيانة (ممنوعة)
                                </button>
                            }
                            else
                            {
                                <button class="car-btn-status available" @onclick="() => OpenNewContractForCar(car)">
                                    + فتح عقد وتأجير
                                </button>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state-card" style="grid-column: 1 / -1;">
                    <div class="empty-state-icon">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C1.4 11.2 1 12 1 13v3c0 .6.4 1 1 1h2"/>
                            <circle cx="7" cy="17" r="2"/>
                            <path d="M9 17h6"/>
                            <circle cx="17" cy="17" r="2"/>
                        </svg>
                    </div>
                    <div class="empty-state-title">لا توجد مركبات مسجلة في الأسطول حتى الآن</div>
                    <div class="empty-state-sub">النظام نظيف تماماً وخالٍ من البيانات التجريبية. يمكنك الآن البدء بإضافة سياراتك الحقيقية.</div>
                    <button class="btn-primary-action" @onclick='() => Navigation.NavigateTo("fleet")'>
                        + إضافة أول سيارة للأسطول
                    </button>
                </div>
            }
            </div>
        </div>
    </div>

    <!-- Right Column: 3 Widgets Stacked (Gauges, Critical Alerts, Quick Documents) -->
    <div class="widgets-column">
        <!-- Widget 1: Vehicle Gauges & Waves -->
        <VehicleGaugesWidget DashboardData="_dashboardData" />

        <!-- Widget 2: Critical Alerts -->
        <CriticalAlertsWidget Alerts="_dashboardData?.CriticalAlerts" />

        <!-- Widget 3: Customer Documents & Quick Print (عقد & كمبيالة) -->
        <QuickDocumentsWidget @ref="_quickDocsWidget" OnPrintRequested="OpenPrintDocumentModal" />
    </div>
</div>


<!-- Modal for New Contract -->
@if (_showNewContractModal)
{
    <NewContractModal 
        InitialVehicleId="_selectedVehicleIdForContract"
        OnContractCreated="OnContractCreated" 
        OnClose="() => { _showNewContractModal = false; _selectedVehicleIdForContract = null; }" />
}

<!-- Modal for Print Document (Official Contract & Note) -->
@if (_contractToPrint != null)
{
    <PrintDocumentModal Contract="@_contractToPrint" InitialTabContract="@_isContractPrintTab" OnClose="() => _contractToPrint = null" />
}

@code {
    private QuickDocumentsWidget? _quickDocsWidget;
    private DashboardSummaryDto? _dashboardData;
    private List<OverdueContractDto>? _overdueContracts;
    private string _activeFilter = "all";
    private string _searchQuery = "";
    private bool _showNewContractModal = false;
    private Guid? _selectedVehicleIdForContract;
    private Contract? _contractToPrint;
    private bool _isContractPrintTab = true;

    private void OpenNewContractForCar(Vehicle car)
    {
        _selectedVehicleIdForContract = car.Id;
        _showNewContractModal = true;
    }

    private void OpenPrintDocumentModal((Contract Contract, bool IsContractTab) request)
    {
        _contractToPrint = request.Contract;
        _isContractPrintTab = request.IsContractTab;
    }


    private IEnumerable<Vehicle>? _filteredCars => _dashboardData?.AllVehicles
        .Where(c => string.IsNullOrWhiteSpace(_searchQuery) ||
                    c.Brand.ContainsArabic(_searchQuery) ||
                    c.Model.ContainsArabic(_searchQuery) ||
                    c.PlateNumber.ContainsArabic(_searchQuery))
        .Where(c => _activeFilter switch {
            "available" => c.Status == VehicleStatus.Available,
            "active" => c.Status == VehicleStatus.Rented,
            "overdue" => _overdueContracts != null && _overdueContracts.Any(ov => ov.Contract?.VehicleId == c.Id),
            _ => true
        });

    protected override async Task OnInitializedAsync()
    {
        RentalService.OnContractsDataChanged += HandleContractsDataChanged;
        await LoadDashboardData();
    }

    private async void HandleContractsDataChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadDashboardData();
            if (_quickDocsWidget != null)
            {
                await _quickDocsWidget.RefreshAsync();
            }
            StateHasChanged();
        });
    }

    private async Task LoadDashboardData()
    {
        _dashboardData = await RentalService.GetDashboardDataAsync();
        try
        {
            _overdueContracts = await RentalService.GetOverdueContractsAsync();
            await NotificationService.RefreshNotificationsAsync();
        }
        catch { }
    }

    private void SendOverdueWhatsApp(OverdueContractDto ov)
    {
        try
        {
            var msg = $"✦ *شركة التـاج لتأجيـر السيـارات* (TAJ SYSTEM) ✦\n" +
                      $"━━━━━━━━━━━━━━━━━━━━━\n" +
                      $"مرحباً بك أخي الكريم: *{ov.CustomerName}*\n" +
                      $"نود تذكيركم بأن موعد إرجاع المركبة ({ov.VehicleInfo} - لوحة: *{ov.PlateNumber}*) بموجب العقد رقم *{ov.ContractNumber}* كان بتاريخ *{ov.ExpectedReturnDateTime:yyyy/MM/dd hh:mm tt}*.\n\n" +
                      $"يرجى التكرم بالحضور لتسليم المركبة أو التواصل معنا لتمديد العقد.\n" +
                      $"━━━━━━━━━━━━━━━━━━━━━\n" +
                      $"☎ *خدمة العملاء:* 0566655550 | 0566009003";

            WhatsAppHelper.OpenWhatsApp(ov.CustomerPhone, "970", msg);
        }
        catch { }
    }

    private async Task OnContractCreated()
    {
        _selectedVehicleIdForContract = null;
        await LoadDashboardData();
        if (_quickDocsWidget != null)
        {
            await _quickDocsWidget.RefreshAsync();
        }
    }

    public void Dispose()
    {
        RentalService.OnContractsDataChanged -= HandleContractsDataChanged;
    }
}
