@page "/accounting"
@using CarRental.Core.Entities
@using CarRental.Core.Enums
@using CarRental.Core.Interfaces
@using CarRental.App.Helpers
@inject IRentalSystemService RentalService
@inject IAuthStateService AuthState
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@implements IDisposable

<style>
    /* ==========================================================================
       Accounting & Live Treasury Luxury Theme Styles
       ========================================================================== */
    .acc-header-box {
        background: #ffffff;
        border: 1.5px solid var(--border-color);
        border-radius: 16px;
        padding: 20px 24px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
    }

    .acc-title-group {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .acc-title-icon {
        background: linear-gradient(135deg, rgba(2, 132, 199, 0.12) 0%, rgba(2, 132, 199, 0.22) 100%);
        border: 1.5px solid #38bdf8;
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .acc-tabs-bar {
        display: flex;
        gap: 6px;
        background: #f1f5f9;
        padding: 4px;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
    }

    .acc-tab-btn {
        padding: 8px 16px;
        border-radius: 8px;
        border: none;
        background: transparent;
        font-weight: 700;
        font-size: 0.88rem;
        color: #475569;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .acc-tab-btn:hover {
        color: #0f172a;
        background: rgba(255, 255, 255, 0.6);
    }

    .acc-tab-btn.active {
        background: #ffffff;
        color: #0284c7;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        font-weight: 800;
    }

    /* Executive Balance Cards ("شو إلي وشو عليّ") */
    .acc-kpi-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 14px;
    }

    .acc-kpi-card {
        background: #ffffff;
        border-radius: 14px;
        padding: 18px 20px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.04);
        position: relative;
        overflow: hidden;
        border: 1.5px solid #e2e8f0;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .acc-kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.07);
    }

    .acc-kpi-card.cash-drawer {
        border-color: #38bdf8;
        background: linear-gradient(180deg, #f0f9ff 0%, #ffffff 100%);
    }

    .acc-kpi-card.receivables {
        border-color: #86efac;
        background: linear-gradient(180deg, #f0fdf4 0%, #ffffff 100%);
    }

    .acc-kpi-card.payables {
        border-color: #fca5a5;
        background: linear-gradient(180deg, #fff1f2 0%, #ffffff 100%);
    }

    .acc-kpi-card.net-profit {
        border-color: #c084fc;
        background: linear-gradient(180deg, #faf5ff 0%, #ffffff 100%);
    }

    .acc-kpi-card.debts {
        border-color: #fdba74;
        background: linear-gradient(180deg, #fff7ed 0%, #ffffff 100%);
    }

    .acc-kpi-label {
        font-size: 0.84rem;
        font-weight: 800;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .acc-kpi-value {
        font-size: 1.7rem;
        font-weight: 900;
        margin: 10px 0 4px 0;
        line-height: 1.1;
        letter-spacing: -0.5px;
    }

    .acc-kpi-sub {
        font-size: 0.76rem;
        color: #64748b;
        line-height: 1.4;
    }

    /* Summary Bar for Business Owner Clarity */
    .acc-executive-banner {
        background: linear-gradient(90deg, #0f172a 0%, #1e293b 100%);
        color: #ffffff;
        border-radius: 12px;
        padding: 12px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        box-shadow: 0 4px 15px rgba(15, 23, 42, 0.15);
    }

    /* Shift Hero Master Card */
    .acc-shift-hero {
        background: #ffffff;
        border: 2px solid #38bdf8;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 6px 20px rgba(56, 189, 248, 0.08);
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .acc-shift-metrics-grid {
        display: grid;
        grid-template-columns: 1fr 1.3fr 1.6fr;
        gap: 14px;
    }

    .acc-shift-box {
        background: #f8fafc;
        border: 1.5px solid #e2e8f0;
        border-radius: 12px;
        padding: 16px 18px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .acc-shift-box.highlight {
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        border-color: #0284c7;
        color: #ffffff;
    }

    /* High Contrast Modern Table */
    .acc-modern-table-container {
        background: #ffffff;
        border: 1.5px solid #cbd5e1;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(0,0,0,0.03);
    }

    .acc-modern-table {
        width: 100%;
        border-collapse: collapse;
        text-align: right;
        font-size: 0.88rem;
    }

    .acc-modern-table thead tr {
        background: #1e293b !important;
        color: #ffffff !important;
        border-bottom: 2px solid #0f172a;
    }

    .acc-modern-table th {
        background: #1e293b !important;
        color: #f8fafc !important;
        padding: 13px 14px !important;
        font-weight: 800 !important;
        font-size: 0.85rem !important;
        letter-spacing: 0.2px;
        white-space: nowrap;
        text-align: center;
        border: none !important;
    }

    .acc-modern-table th.text-start {
        text-align: right;
    }

    .acc-modern-table td {
        padding: 12px 14px;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
        text-align: center;
        color: #1e293b;
    }

    .acc-modern-table td.text-start {
        text-align: right;
    }

    .acc-modern-table tr:hover td {
        background: #f8fafc;
    }

    /* Subtotals Live Ribbon */
    .acc-subtotals-ribbon {
        background: #f8fafc;
        border-bottom: 1.5px solid #e2e8f0;
        padding: 12px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 14px;
    }

    .bidi-text {
        unicode-bidi: isolate;
        direction: rtl;
        text-align: right;
        line-height: 1.45;
        word-break: break-word;
    }

    .nowrap-num {
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-variant-numeric: tabular-nums;
    }

    .acc-voucher-badge {
        font-family: monospace;
        font-weight: 800;
        font-size: 0.82rem;
        background: #e0f2fe;
        color: #0369a1;
        padding: 3px 8px;
        border-radius: 6px;
        border: 1px solid #bae6fd;
        display: inline-block;
        white-space: nowrap;
    }
</style>

<div style="display: flex; flex-direction: column; gap: 20px;">
    
    <!-- Top Action & Navigation Bar -->
    <div class="acc-header-box">
        <div class="acc-title-group">
            <div class="acc-title-icon">⚖️</div>
            <div>
                <h2 style="font-size: 1.25rem; font-weight: 800; color: #0f172a; margin: 0; display: flex; align-items: center; gap: 10px;">
                    <span>نظام الحسابات والمالية الشامل (Accounting & Live Treasury)</span>
                    @if (_currentShift != null && !_currentShift.IsClosed)
                    {
                        <span style="font-size: 0.75rem; background: #dcfce7; color: #15803d; border: 1.5px solid #86efac; padding: 2px 10px; border-radius: 20px; font-weight: 800; display: inline-flex; align-items: center; gap: 4px;">
                            <span style="display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #16a34a;"></span>
                            الدرج مفتوح
                        </span>
                    }
                </h2>
                <span style="font-size: 0.84rem; color: #64748b; font-weight: 500;">
                    متابعة نقد الصندوق اللحظي، كشف شو إلك وشو عليك، تسجيل كل شيكل مصروف وإيراد، وضبط أرباح الأسطول
                </span>
            </div>
        </div>

        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
            <!-- Main Tabs -->
            <div class="acc-tabs-bar">
                <button class="acc-tab-btn @(_currentTab == "shift" ? "active" : "")" @onclick='() => _currentTab = "shift"'>
                    <span>💵 الصندوق والورديات</span>
                </button>
                <button class="acc-tab-btn @(_currentTab == "transactions" ? "active" : "")" @onclick='() => _currentTab = "transactions"'>
                    <span>📋 سجل المقبوضات والمصروفات (@(_transactions?.Count ?? 0))</span>
                </button>
                <button class="acc-tab-btn @(_currentTab == "debts" ? "active" : "")" @onclick='() => _currentTab = "debts"'>
                    <span>💳 كشف ديون العملاء (@(CustomersWithDebts.Count))</span>
                </button>
                <button class="acc-tab-btn @(_currentTab == "profitability" ? "active" : "")" @onclick='() => _currentTab = "profitability"'>
                    <span>🚗 ربحية الأسطول (@(_profitability?.Count ?? 0))</span>
                </button>
            </div>

            <!-- Action Buttons -->
            <button class="btn-primary-action" style="background: #15803d; border-color: #166534; gap: 6px; padding: 9px 18px; font-weight: 800; box-shadow: 0 4px 12px rgba(22, 101, 52, 0.2);" @onclick="OpenAddReceiptModal">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>تسجيل سند قبض مالي 📥</span>
            </button>

            <button class="btn-primary-action" style="background: #dc2626; border-color: #b91c1c; gap: 6px; padding: 9px 18px; font-weight: 800; box-shadow: 0 4px 12px rgba(220, 38, 38, 0.2);" @onclick="OpenAddExpenseModal">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>تسجيل سند صرف / مصروف 💸</span>
            </button>

            <button class="btn-primary-action" style="background: #0284c7; border-color: #0369a1; gap: 6px; padding: 9px 15px; font-weight: 800;" @onclick="ExportAccountingToExcel" title="تصدير كشف الحركات المالية إلى Excel">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span>تصدير Excel 📊</span>
            </button>

            <button class="btn-primary-action" style="background: #1e293b; border-color: #0f172a; gap: 6px; padding: 9px 15px;" @onclick="PrintReport">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="6 9 6 2 18 2 18 9"></polyline>
                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                    <rect x="6" y="14" width="12" height="8"></rect>
                </svg>
                <span>طباعة (PDF)</span>
            </button>
        </div>
    </div>

    <!-- Executive Financial Balance Hub ("شو إلي وشو عليّ") -->
    <div class="acc-kpi-grid">
        <!-- 1. Live Cash Drawer -->
        <div class="acc-kpi-card cash-drawer">
            <div class="acc-kpi-label" style="color: #0369a1;">
                <span>💵 نقد الصندوق الحالي (كاش)</span>
                <span style="font-size: 0.72rem; background: #e0f2fe; color: #0284c7; padding: 2px 8px; border-radius: 12px; font-weight: 800;">حي مباشر</span>
            </div>
            <div class="acc-kpi-value" style="color: #0284c7;">
                @LiveCashInDrawer.ToString("N0") ₪
            </div>
            <div class="acc-kpi-sub">
                النقد الفعلي الحاضر بالدرج الآن (جاهز للاستلام أو الصرف)
            </div>
        </div>

        <!-- 2. What is Owed to Me ("شو إلي") -->
        <div class="acc-kpi-card receivables">
            <div class="acc-kpi-label" style="color: #166534;">
                <span>🟢 شو إلي (إجمالي حقوقك)</span>
                <span style="font-size: 0.72rem; background: #dcfce7; color: #15803d; padding: 2px 8px; border-radius: 12px; font-weight: 800;">كاش + ديون</span>
            </div>
            <div class="acc-kpi-value" style="color: #15803d;">
                @((LiveCashInDrawer + TotalCustomerDebts).ToString("N0")) ₪
            </div>
            <div class="acc-kpi-sub">
                الكاش بالدرج (@LiveCashInDrawer.ToString("N0") ₪) + ديون عند الزبائن (@TotalCustomerDebts.ToString("N0") ₪)
            </div>
        </div>

        <!-- 3. What I Owe / Paid Out ("شو عليّ") -->
        <div class="acc-kpi-card payables">
            <div class="acc-kpi-label" style="color: #991b1b;">
                <span>🔴 شو عليّ (المصاريف والنفقات)</span>
                <span style="font-size: 0.72rem; background: #fee2e2; color: #b91c1c; padding: 2px 8px; border-radius: 12px; font-weight: 800;">
                    @(_transactions?.Count(t => t.Type == TransactionType.Payment) ?? 0) حركة
                </span>
            </div>
            <div class="acc-kpi-value" style="color: #dc2626;">
                -@TotalPayments.ToString("N0") ₪
            </div>
            <div class="acc-kpi-sub">
                صيانة، غسيل، قطع غيار، محروقات، ترخيص، وتأمين
            </div>
        </div>

        <!-- 4. Net Operating Profit -->
        <div class="acc-kpi-card net-profit">
            <div class="acc-kpi-label" style="color: #7e22ce;">
                <span>📈 صافي الربح التشغيلي</span>
                <span style="font-size: 0.72rem; background: @(NetOperatingProfit >= 0 ? "#f3e8ff" : "#fee2e2"); color: @(NetOperatingProfit >= 0 ? "#6b21a8" : "#991b1b"); padding: 2px 8px; border-radius: 12px; font-weight: 800;">
                    @(NetOperatingProfit >= 0 ? "أرباح محققة ✓" : "عجز مصاريف ⚠️")
                </span>
            </div>
            <div class="acc-kpi-value" style="color: @(NetOperatingProfit >= 0 ? "#7e22ce" : "#e11d48");">
                @(NetOperatingProfit >= 0 ? "+" : "")@NetOperatingProfit.ToString("N0") ₪
            </div>
            <div class="acc-kpi-sub">
                ناتج أعمالك الصافي المحقق (المقبوضات - المصاريف)
            </div>
        </div>

        <!-- 5. Customer Outstanding Debts -->
        <div class="acc-kpi-card debts" style="cursor: pointer;" @onclick='() => _currentTab = "debts"' title="اضغط لفتح كشف ديون العملاء والتواصل معهم">
            <div class="acc-kpi-label" style="color: #c2410c;">
                <span>💳 ديون العملاء بالسوق</span>
                <span style="font-size: 0.72rem; background: #ffedd5; color: #ea580c; padding: 2px 8px; border-radius: 12px; font-weight: 800;">
                    @(CustomersWithDebts.Count) عملاء مدينون 👈
                </span>
            </div>
            <div class="acc-kpi-value" style="color: #ea580c;">
                @TotalCustomerDebts.ToString("N0") ₪
            </div>
            <div class="acc-kpi-sub">
                مستحقات آجلة للشركة بالخارج قيد المتابعة والتحصيل
            </div>
        </div>
    </div>

    <!-- Quick Owner Clarity Banner -->
    <div class="acc-executive-banner">
        <div style="display: flex; align-items: center; gap: 10px; font-size: 0.92rem;">
            <span style="font-size: 1.25rem;">💡</span>
            <span>
                <strong>الموقف المالي السريع:</strong>
                إجمالي حقوقك الحالية (الكاش + ديون الزبائن) = <span style="color: #86efac; font-weight: 900; font-size: 1.05rem;">@((LiveCashInDrawer + TotalCustomerDebts).ToString("N0")) ₪</span>
                | إجمالي ما صُرف = <span style="color: #fca5a5; font-weight: 900; font-size: 1.05rem;">@TotalPayments.ToString("N0") ₪</span>
                | ربحك التشغيلي الصافي = <span style="color: #fde047; font-weight: 900; font-size: 1.05rem;">@NetOperatingProfit.ToString("N0") ₪</span>
            </span>
        </div>
        <div style="font-size: 0.8rem; color: #94a3b8; display: flex; align-items: center; gap: 8px;">
            <span>آخر تحديث تلقائي: @DateTime.Now.ToString("hh:mm tt")</span>
            <button class="filter-pill" style="background: rgba(255,255,255,0.15); color: #ffffff; border: 1px solid rgba(255,255,255,0.3); padding: 2px 8px; font-size: 0.75rem;" @onclick="LoadAccountingData">
                🔄 تحديث
            </button>
        </div>
    </div>

    <!-- =========================================================================
         TAB 1: Daily Cash Shift Register & History (الصندوق والورديات)
         ========================================================================= -->
    @if (_currentTab == "shift")
    {
        <div style="display: flex; flex-direction: column; gap: 20px;">
            
            <!-- 1. Master Active Shift Command Box -->
            @if (_currentShift != null && !_currentShift.IsClosed)
            {
                <div class="acc-shift-hero">
                    <!-- Top Status Strip -->
                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #f1f5f9; padding-bottom: 16px; flex-wrap: wrap; gap: 12px;">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="background: #e0f2fe; color: #0284c7; width: 44px; height: 44px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.4rem;">
                                💼
                            </div>
                            <div>
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <h3 style="margin: 0; font-size: 1.2rem; font-weight: 900; color: #0f172a;">صندوق الوردية المفتوحة حالياً</h3>
                                    <span style="background: #dcfce7; color: #166534; border: 1.5px solid #86efac; padding: 2px 10px; border-radius: 20px; font-size: 0.78rem; font-weight: 800; display: inline-flex; align-items: center; gap: 5px;">
                                        <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #16a34a; animation: pulse 2s infinite;"></span>
                                        نشط ومفتوح
                                    </span>
                                </div>
                                <div style="font-size: 0.82rem; color: #64748b; margin-top: 2px;">
                                    الموظف المسؤول: <strong style="color: #0f172a;">@_currentShift.StaffFullName</strong>
                                    | وقت وتاريخ الافتتاح: <strong>@_currentShift.OpenedAt.ToString("yyyy/MM/dd hh:mm tt")</strong>
                                </div>
                            </div>
                        </div>

                        <!-- Shift Drawer Quick Buttons -->
                        <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                            <button class="btn-primary-action" style="background: #15803d; border-color: #166534; padding: 8px 14px; font-size: 0.85rem;" @onclick="OpenAddCashReceiptModal">
                                <span>📥 توريد كاش للدرج</span>
                            </button>
                            <button class="btn-primary-action" style="background: #dc2626; border-color: #b91c1c; padding: 8px 14px; font-size: 0.85rem;" @onclick="OpenAddCashExpenseModal">
                                <span>💸 صرف نقدية من الدرج</span>
                            </button>
                            <button class="btn-primary-action" style="background: #d97706; border-color: #b45309; padding: 8px 16px; font-weight: 900; font-size: 0.88rem; box-shadow: 0 4px 12px rgba(217, 119, 6, 0.25);" @onclick="OpenCloseShiftModal">
                                <span>🔒 إغلاق وتسليم الوردية وجرد الدرج</span>
                            </button>
                        </div>
                    </div>

                    <!-- 3 Master Numeric Cards -->
                    <div class="acc-shift-metrics-grid">
                        <!-- Box A: Opening Float -->
                        <div class="acc-shift-box">
                            <span style="font-size: 0.82rem; font-weight: 700; color: #475569;">1. العهدة الافتتاحية (رأس مال الدرج):</span>
                            <div style="font-size: 1.6rem; font-weight: 900; color: #2563eb; margin: 6px 0;">
                                @_currentShift.OpeningBalance.ToString("N0") ₪
                            </div>
                            <span style="font-size: 0.74rem; color: #64748b;">النقدية التي بدأ بها الموظف دوامه</span>
                        </div>

                        <!-- Box B: Shift Net Cash -->
                        <div class="acc-shift-box">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <span style="font-size: 0.82rem; font-weight: 700; color: #475569;">2. صافي حركات الوردية نقدياً:</span>
                                <span style="font-size: 0.75rem; font-weight: 800; color: @(_currentShift.SystemCalculatedCash >= 0 ? "#16a34a" : "#dc2626");">
                                    @(_currentShift.SystemCalculatedCash >= 0 ? "+" : "")@_currentShift.SystemCalculatedCash.ToString("N0") ₪
                                </span>
                            </div>
                            <div style="margin: 8px 0; font-size: 0.84rem; display: flex; flex-direction: column; gap: 4px;">
                                <div style="display: flex; justify-content: space-between; color: #166534; font-weight: 700;">
                                    <span>مقبوضات كاش داخلة:</span>
                                    <span>+@CurrentShiftCashIn.ToString("N0") ₪</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; color: #dc2626; font-weight: 700;">
                                    <span>مصروفات كاش خارجة:</span>
                                    <span>-@CurrentShiftCashOut.ToString("N0") ₪</span>
                                </div>
                            </div>
                            <span style="font-size: 0.74rem; color: #64748b;">الفرق بين المقبوضات والمصروفات النقدية</span>
                        </div>

                        <!-- Box C: Expected Cash in Drawer -->
                        <div class="acc-shift-box highlight">
                            <span style="font-size: 0.85rem; font-weight: 800; color: #e0f2fe;">3. النقد المتوقع وجوده في الدرج الآن:</span>
                            <div style="font-size: 2.1rem; font-weight: 900; color: #ffffff; margin: 6px 0; letter-spacing: -0.5px;">
                                @((_currentShift.OpeningBalance + _currentShift.SystemCalculatedCash).ToString("N0")) ₪
                            </div>
                            <span style="font-size: 0.76rem; color: #bae6fd; line-height: 1.4;">
                                = العهدة الافتتاحية (@_currentShift.OpeningBalance.ToString("N0") ₪) + مقبوضات كاش (@CurrentShiftCashIn.ToString("N0") ₪) - مصروفات كاش (@CurrentShiftCashOut.ToString("N0") ₪)
                            </span>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Closed Shift Prompt -->
                <div style="background: #ffffff; border: 2px dashed #cbd5e1; border-radius: 16px; padding: 40px 20px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 12px;">
                    <div style="font-size: 3rem;">🔐</div>
                    <h3 style="font-size: 1.25rem; font-weight: 900; color: #0f172a; margin: 0;">الصندوق مغلق حالياً، لا توجد وردية نشطة</h3>
                    <p style="font-size: 0.88rem; color: #64748b; max-width: 500px; margin: 0; line-height: 1.5;">
                        لبدء استلام النقد وتسجيل المقبوضات والمصروفات اليومية بدقة، يرجى افتتاح الوردية وتحديد العهدة الافتتاحية للصندوق.
                    </p>
                    <button class="btn-primary-action" style="padding: 12px 28px; font-weight: 800; font-size: 0.95rem; margin-top: 6px;" @onclick="() => _showOpenShiftModal = true">
                        💰 افتتاح الصندوق وبدء الوردية الآن
                    </button>
                </div>
            }

            <!-- 2. Interactive Shift Sub-Section Switcher -->
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                <div class="acc-tabs-bar" style="background: #e2e8f0;">
                    <button class="acc-tab-btn @(_shiftSubView == "current_feed" ? "active" : "")" @onclick='() => _shiftSubView = "current_feed"'>
                        <span>📋 حركات الوردية الحالية اللحظية (@CurrentShiftTransactions.Count)</span>
                    </button>
                    <button class="acc-tab-btn @(_shiftSubView == "archive" ? "active" : "")" @onclick='() => _shiftSubView = "archive"'>
                        <span>🗄️ أرشيف إغلاقات الصناديق والورديات السابقة (@(_allShifts?.Count(s => s.IsClosed) ?? 0))</span>
                    </button>
                </div>

                <div style="font-size: 0.82rem; color: #64748b;">
                    @if (_shiftSubView == "current_feed")
                    {
                        <span>يعرض جميع القيود التي تمت أثناء دوام الموظف الحالي في الصندوق</span>
                    }
                    else
                    {
                        <span>سجل إغلاق الصناديق، مبالغ التسليم الفعلية، ومطابقات الجرد التاريخية</span>
                    }
                </div>
            </div>

            <!-- SUB-VIEW 1: Current Shift Live Transactions Feed -->
            @if (_shiftSubView == "current_feed")
            {
                <div class="acc-modern-table-container">
                    <table class="acc-modern-table">
                        <thead>
                            <tr>
                                <th style="width: 140px;">رقم السند</th>
                                <th style="width: 130px;">الوقت</th>
                                <th style="width: 120px;">نوع الحركة</th>
                                <th class="text-start">البيان والتفاصيل</th>
                                <th style="width: 140px;">الطرف / المستفيد</th>
                                <th style="width: 150px;">السيارة</th>
                                <th style="width: 130px;">المبلغ (₪)</th>
                                <th style="width: 110px;">طريقة الدفع</th>
                                <th style="width: 80px;">سند</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (CurrentShiftTransactions.Any())
                            {
                                @foreach (var t in CurrentShiftTransactions)
                                {
                                    <tr style="background: @(t.Type == TransactionType.Receipt ? "#ffffff" : "#fffcfc");">
                                        <td>
                                            <span class="acc-voucher-badge">@t.ReceiptNumber</span>
                                        </td>
                                        <td style="font-size: 0.82rem; color: #475569;">
                                            @t.TransactionDateTime.ToString("hh:mm tt")
                                        </td>
                                        <td>
                                            @if (t.Type == TransactionType.Receipt)
                                            {
                                                <span style="background: #dcfce7; color: #166534; border: 1px solid #86efac; padding: 2px 8px; border-radius: 6px; font-weight: 800; font-size: 0.78rem;">
                                                    قبض إيراد (+)
                                                </span>
                                            }
                                            else
                                            {
                                                <span style="background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; padding: 2px 8px; border-radius: 6px; font-weight: 800; font-size: 0.78rem;">
                                                    صرف مصروف (-)
                                                </span>
                                            }
                                        </td>
                                        <td class="text-start">
                                            <bdi class="bidi-text" style="font-weight: 600; color: #0f172a; display: block;">
                                                @t.Description
                                            </bdi>
                                            <span style="font-size: 0.75rem; color: #64748b;">
                                                التصنيف: @GetCategoryLabel(t.Category)
                                            </span>
                                        </td>
                                        <td>
                                            <span style="font-weight: 700; color: #334155; font-size: 0.84rem;">
                                                @(string.IsNullOrWhiteSpace(t.PayeeOrVendor) ? (t.Customer?.FullName ?? "-") : t.PayeeOrVendor)
                                            </span>
                                        </td>
                                        <td>
                                            @if (t.Vehicle != null)
                                            {
                                                <button class="icon-btn-subtle" style="font-size: 0.78rem; font-weight: 800; color: #0284c7; background: #f0f9ff; border: 1px solid #bae6fd; padding: 2px 8px; border-radius: 6px;" title="عرض الملف المالي للسيارة" @onclick="() => OpenVehicleProfileById(t.VehicleId!.Value)">
                                                    🚗 @t.Vehicle.Brand (@t.Vehicle.PlateNumber)
                                                </button>
                                            }
                                            else
                                            {
                                                <span style="color: #94a3b8; font-size: 0.8rem;">- عام -</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="nowrap-num" style="font-weight: 900; font-size: 1.05rem; color: @(t.Type == TransactionType.Receipt ? "#16a34a" : "#dc2626");">
                                                @(t.Type == TransactionType.Receipt ? "+" : "-")@t.Amount.ToString("N0") ₪
                                            </span>
                                        </td>
                                        <td>
                                            <span style="font-size: 0.78rem; background: #f1f5f9; padding: 2px 8px; border-radius: 6px; font-weight: 700; color: #334155;">
                                                @GetPaymentModeLabel(t.PaymentMethod)
                                            </span>
                                        </td>
                                        <td>
                                            <button class="icon-btn-subtle" title="طباعة سند مالي رسمي" @onclick="() => _printVoucherTransaction = t">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <polyline points="6 9 6 2 18 2 18 9"></polyline>
                                                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                                                    <rect x="6" y="14" width="12" height="8"></rect>
                                                </svg>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" style="text-align: center; padding: 45px 20px; color: #64748b;">
                                        <div style="font-size: 2rem; margin-bottom: 8px;">✨</div>
                                        <div style="font-weight: 800; font-size: 1rem; color: #0f172a;">لا توجد حركات مالية مسجلة في هذه الوردية حتى الآن</div>
                                        <div style="font-size: 0.82rem; margin-top: 4px;">أي سند قبض أو صرف يتم تسجيله خلال الدوام الحالي سيظهر هنا فوراً.</div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <!-- SUB-VIEW 2: Shifts Closures Archive -->
            @if (_shiftSubView == "archive")
            {
                <div class="acc-modern-table-container">
                    <table class="acc-modern-table">
                        <thead>
                            <tr>
                                <th>الموظف المستلم</th>
                                <th>وقت الافتتاح</th>
                                <th>وقت الإغلاق والتسليم</th>
                                <th>العهدة الافتتاحية</th>
                                <th>صافي حركات الوردية</th>
                                <th>المبلغ الفعلي المسلم</th>
                                <th>فارق الجرد (عجز / فائض)</th>
                                <th>ملاحظات التسليم</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_allShifts != null && _allShifts.Any(sh => sh.IsClosed))
                            {
                                @foreach (var s in _allShifts.Where(sh => sh.IsClosed).OrderByDescending(sh => sh.ClosedAt ?? sh.OpenedAt))
                                {
                                    <tr>
                                        <td style="font-weight: 800; color: #0f172a;">@s.StaffFullName</td>
                                        <td style="font-size: 0.82rem; color: #475569;">@s.OpenedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                        <td style="font-size: 0.82rem; color: #475569;">@s.ClosedAt?.ToString("yyyy/MM/dd HH:mm")</td>
                                        <td style="font-weight: 800; color: #2563eb;">@s.OpeningBalance.ToString("N0") ₪</td>
                                        <td style="font-weight: 800; color: @(s.SystemCalculatedCash >= 0 ? "#16a34a" : "#dc2626");">
                                            @(s.SystemCalculatedCash >= 0 ? "+" : "")@s.SystemCalculatedCash.ToString("N0") ₪
                                        </td>
                                        <td style="font-weight: 900; color: #0f172a; font-size: 1rem;">
                                            @s.ClosingBalanceActual?.ToString("N0") ₪
                                        </td>
                                        <td>
                                            @if (s.Discrepancy == 0)
                                            {
                                                <span style="background: #dcfce7; color: #166534; border: 1px solid #86efac; padding: 3px 10px; border-radius: 6px; font-weight: 800; font-size: 0.78rem;">
                                                    مطابق تماماً ✓ (0 ₪)
                                                </span>
                                            }
                                            else if (s.Discrepancy < 0)
                                            {
                                                <span style="background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; padding: 3px 10px; border-radius: 6px; font-weight: 800; font-size: 0.78rem;">
                                                    عجز (@s.Discrepancy.ToString("N0") ₪) ⚠️
                                                </span>
                                            }
                                            else
                                            {
                                                <span style="background: #fef9c3; color: #854d0e; border: 1px solid #fde047; padding: 3px 10px; border-radius: 6px; font-weight: 800; font-size: 0.78rem;">
                                                    فائض (+@s.Discrepancy.ToString("N0") ₪) 🌟
                                                </span>
                                            }
                                        </td>
                                        <td style="font-size: 0.8rem; color: #64748b; max-width: 250px;">
                                            @(string.IsNullOrWhiteSpace(s.Notes) ? "-" : s.Notes)
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" style="text-align: center; padding: 45px 20px; color: #64748b;">
                                        لا توجد سجلات إغلاق سابقة في الأرشيف حتى الآن.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <!-- =========================================================================
         TAB 2: Financial Transactions Ledger (سجل المقبوضات والمصروفات المطور)
         ========================================================================= -->
    @if (_currentTab == "transactions")
    {
        <div class="acc-modern-table-container">
            
            <!-- Filters & Search Bar -->
            <div style="padding: 16px 20px; background: #ffffff; border-bottom: 1.5px solid #e2e8f0; display: flex; gap: 14px; align-items: center; flex-wrap: wrap;">
                
                <!-- Quick Filter Pills: All / In / Out -->
                <div class="acc-tabs-bar" style="background: #f1f5f9;">
                    <button class="acc-tab-btn @(_txFilterType == "All" ? "active" : "")" @onclick='() => _txFilterType = "All"'>
                        <span>🔘 الكل (@(_transactions?.Count ?? 0))</span>
                    </button>
                    <button class="acc-tab-btn @(_txFilterType == "Receipt" ? "active" : "")" @onclick='() => _txFilterType = "Receipt"'>
                        <span>📥 المقبوضات (إيرادات +)</span>
                    </button>
                    <button class="acc-tab-btn @(_txFilterType == "Payment" ? "active" : "")" @onclick='() => _txFilterType = "Payment"'>
                        <span>💸 المصروفات (نفقات -)</span>
                    </button>
                </div>

                <!-- Category Filter -->
                <select @bind="_txFilterCategory" style="padding: 8px 12px; border-radius: 8px; border: 1.5px solid #cbd5e1; font-size: 0.85rem; font-weight: 600; color: #0f172a; outline: none; background: #ffffff;">
                    <option value="All">📂 جميع بنود التصنيف</option>
                    <option value="@TransactionCategory.RentalPayment">🚗 إيجار مركبات</option>
                    <option value="@TransactionCategory.ContractExtension">⏱️ تمديد عقود</option>
                    <option value="@TransactionCategory.CarMaintenance">🔧 صيانة وإصلاحات</option>
                    <option value="@TransactionCategory.CarWash">🧼 غسيل وتنظيف</option>
                    <option value="@TransactionCategory.CarInsurance">🛡️ تأمين مركبات</option>
                    <option value="@TransactionCategory.CarLicensing">📋 ترخيص وديناموميتر</option>
                    <option value="@TransactionCategory.SpareParts">⚙️ قطع غيار ومستلزمات</option>
                    <option value="@TransactionCategory.Fuel">⛽ وقود ومحروقات</option>
                    <option value="@TransactionCategory.DebtPayment">💳 سداد ديون عملاء</option>
                    <option value="@TransactionCategory.GeneralOfficeExpense">🏢 مصاريف عامة وإدارية</option>
                    <option value="@TransactionCategory.OfficeExpense">☕ فواتير ومكتب</option>
                </select>

                <!-- Payment Method Filter -->
                <select @bind="_txFilterPaymentMode" style="padding: 8px 12px; border-radius: 8px; border: 1.5px solid #cbd5e1; font-size: 0.85rem; font-weight: 600; color: #0f172a; outline: none; background: #ffffff;">
                    <option value="All">💳 جميع طرق الدفع</option>
                    <option value="@PaymentMode.ImmediateCash">💵 نقدي (كاش)</option>
                    <option value="@PaymentMode.CreditCard">💳 فيزا / بطاقة</option>
                    <option value="@PaymentMode.BankTransfer">🏦 تحويل بنكي</option>
                </select>

                <!-- Search Input -->
                <div style="position: relative; flex: 1; min-width: 240px;">
                    <input type="text" @bind="_txSearch" @bind:event="oninput" placeholder="🔍 بحث برقم السند، البيان، اسم العميل، الورشة، أو اللوحة..." style="width: 100%; padding: 8px 14px; border-radius: 8px; border: 1.5px solid #cbd5e1; font-size: 0.85rem; outline: none;" />
                    @if (!string.IsNullOrWhiteSpace(_txSearch))
                    {
                        <button style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); border: none; background: transparent; color: #94a3b8; cursor: pointer;" @onclick='() => _txSearch = ""'>✕</button>
                    }
                </div>
            </div>

            <!-- Live Subtotals Ribbon for Filtered Results -->
